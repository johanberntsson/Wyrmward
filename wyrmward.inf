! --- copied from adjectives.inf: end ---

[ ChooseObjects obj code;
    if(code < 2) {
        ! considering including obj in "all"
        rfalse; ! go with std parser decision
    }

    if(verb_word == 'copy') {
        if(obj ofclass CSpell) {
            if(obj notin Spellbook) return 3;
            return 2;
        }
    }
    return 1;
];

[ SceneryReply word1 word2 routine;
    Taste:
        if(routine == ParseNameSea) {
            "You wet a finger in the surf. Salt, cold, and a faint mineral bite underneath
            it, as though the water had come a very long way to get here.";
        }
        rfalse;
    Enter:
        if(routine == ParseNameSea) {
            if(location == Beach) <<Swim>>;
            if(location == SeaFloor) "You're already swimming in the ocean.";
        }
        rfalse;
    default:
        routine = word1 = word2; ! getting rid of a compiler warning
        rfalse;
];

