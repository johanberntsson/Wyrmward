! Define your attributes, common properties and global variables here, if any

! Setup custom library messages
[LibraryMessages p_msg p_arg_1 p_arg_2;
        switch(p_msg) {
        ! it seems I have to replace all or nothing (since SKIP_MSG_CLOSE_NOT_OPEN)
        MSG_CLOSE_NOT_OPEN, MSG_TOUCHABLE_FOUND_CLOSED,
        MSG_PARSER_CONTAINER_ISNT_OPEN:
            if(player in RedField)
                "The glowing red barrier holds firm. You can't reach anything outside the force field.";
            print_ret (CObjIs) p_arg_1, "n't open.";
        }
        p_arg_2 = 0; ! To avoid warnings
];

