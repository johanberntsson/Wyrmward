#Iftrue (#version_number == 6);
Include "ext_z6graphics.h";
[ PlaySound p_effect p_show_comment;
    @sound_effect p_effect 2 255 0;
    if(p_show_comment) "Playing the sound effect again.";
];
[ ShowPicture p_num _rows _i _row;
    _rows = Z6PictureRows_Chars(p_num);
    if(_rows == 0) return;
     ! first scroll down so we're sure that the picture will fit without [MORE]
     for(_i=0: _i<_rows: _i++) new_line;  
     _row = Z6CursorRow_Chars();
     Z6MoveCursor_Chars(1, _row - _rows);
     Z6DrawPictureHere(p_num);
     Z6MoveCursor_Chars(1, _row);
];
#IfNot;
![ PlaySound snd; print "Sound ", snd, "^"; ];
![ ShowPicture pic; print "Picture ", pic, "^"; ];
[ PlaySound; ];
[ ShowPicture; ];
#Endif;

Constant F_DONT_TRUST_ISTAR      1;
Constant F_DRAGON_HEALED         2;
Constant F_DRAGON_RECOVERING     3;
Constant F_PLAYER_TORN_CLOTHES   4;
Constant F_PLAYER_IS_FISH        5;
Constant F_PRAYED_BEFORE         6;
Constant F_TUNNEL_FROZEN         7;
Constant F_SECOND_COIN_FOUND     8;
Constant F_RED_STONE_SEEN        9;
Constant F_FOLIO_READ           10;
Constant F_MUD_CALLED_WATER     11;
Constant F_SEEN_SLEEPING_BEGGAR 12;
Constant F_ENDGAME_WARNING      13;
