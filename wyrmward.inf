Include "puny.h";

! ==========================================================================
!     The magic system: Enchanter/Sorcerer-style spells and scrolls.
! ==========================================================================

[ IsSpell; return (noun ofclass CSpell); ];

Verb 'cast'
    * noun=IsSpell 'at'/'on'/'upon' noun        -> CastSpellObj
    * noun=IsSpell                              -> CastSpell
    * noun -> MagicHelp
    * -> MagicHelp;
[ CastSpellSub;        if(noun ofclass CSpell) noun.activate(); else <<Drop noun>>; ];
[ CastSpellObjSub; if(noun ofclass CSpell) noun.activate(second); else <<ThrowAt noun second>>; ];

!Verb 'memorize' 'memorise' 'learn' * noun -> Memorize;
![ MemorizeSub; "You should get yourself a notebook instead."; ];
Extend 'speak' first * noun = IsSpell -> MagicHelp;
Verb 'animate' 'freeze' 'copy' 'resurrect' 'heal' 'teleport' 'illuminate' * -> MagicHelp * noun -> MagicHelp;
Verb  'utter' 'chant' 'invoke' 'recite' 'evoke' 'conjure' * -> MagicHelp * noun -> MagicHelp;
[ MagicHelpSub;
    "To use magic, try CAST spell instead.";
];
Verb 'use'
    * noun=IsSpell -> MagicHelp
    * noun 'on' noun -> MagicHelp
    * noun -> Use;
[ UseSub; "You'll need to be more specific. Try commands like READ, EXAMINE, OPEN, or CAST instead."; ];

Object SpellBook "spellbook"
    with
        article "your",
        name 'your' 'spellbook' 'spell' 'book',
        description [;
            ShowPicture(PIC_SPELLBOOK);
            print 
                "It is your well-thumbed spellbook, bought on the day you started at the wizards'
                school. The spells written in it are the fruit of a great many years of study
                and you need to read it to see its contents.^";
            return self.instructions();
        ],
        domagic [ spell;
            if(spell == IlluminateSpell && self hasnt light) {
                give self light; scope_modified = true;
                "The spellbook flares so brightly that you nearly drop it, then settles to a
                steady white glow. It will serve very well as a lamp.";
            }
            "As you trace the words on the page, the magic flares briefly and dissolves into
            harmless sparks. The spellbook's ancient wards refuse to let its own pages be
            turned against it.";
        ],
        before [ a;
        Open, Close:
            "The book can read the thoughts of its owner, and so it will always show you
             the information you need. There is therefore no need to open, close or leaf
             through it. Many lives have been saved by this magical property.";
        Read:
            print "A COMPENDIUM OF BASIC SPELLS^^";
            for(a=child(self): a~=nothing: a=sibling(a))
                print (The) a, ": (", (string) a.comment, ").^";
            return self.instructions();
        ],
        instructions [;
            "^[Use ~read spellbook~ to see your spells. To add new spells, use ~cast copy on <spell>~,
            and then ~cast <spell> on <someone or something>~ to use it.]";
        ],
    has transparent;

Class CScroll
    ! A scroll that can hold a spell. This spell can be copied.
    with
        description [;
            if(child(self)==nothing) "The scroll is blank.";
            print "It reads ~", (name) child(self), ": ",
                        (string) (child(self)).comment, ".~^";
            rtrue;
        ],
        before [;
        !Memorize:
        !    if(child(self) ofclass CSpell) <<Memorize (child(self))>>;
        Read:
            if(child(self)==nothing) "There is nothing written on the scroll.";
            if(child(self) ofclass CSpellWithArgument) {
                <Examine self>;
            } else {
                print "Do you want to read out the text on the scroll and cast the spell? ";
                if(YesOrNo()) (child(self)).activate();
                else <Examine self>;
            }
            rtrue;
        ]
    has transparent;

Class CComplicatedScroll
    ! A scroll whose spell cannot be copied.
    class CScroll
    with
        description [;
            if(child(self)==nothing) "The scroll is blank.";
            print "It reads ~", (name) child(self), ": ",
                        (string) (child(self)).comment, ".~ The spell is long and complicated.^";
            rtrue;
        ],
    ;

Class CSpell
    ! A spell that doesn't take an object
    with
!        number 0, ! number of memorized copies of this spell
        description [;
            print "The spell reads ~", (name) self, ": ", (string) self.comment, ".~^";
            rtrue;
        ],
        before [;
        Read:
            if(self notin SpellBook) {
                meta = true;
                "Reading the spell aloud isn't enough to use it. You must CAST the copy spell ON ",
                (the) self, " to transfer the runes into your spellbook.";
            }
            MagicHelpSub();
            rtrue;
        !Memorize:
        !    if(parent(self)~=SpellBook) {
        !        print "You can only memorize spells written in ", (the) SpellBook, ".^";
        !        rtrue;
        !    }
        !    if(GrabObject(SpellBook)) {
        !        print "You must be holding ", (the) SpellBook, " first.^";
        !        rfalse;
        !    }
        !    if(self.number>no_memorized_spells) self.number=0;
        !    if(no_memorized_spells>=max_no_memorized_spells) {
        !        print "You have already studied so much that you cannot learn any more
        !                     spells. The words slip out of your memory as fast as you cram
        !                     them in.^";
        !        rtrue;
        !    }
        !    print "You concentrate and memorize ", (the) self;
        !    if(self.number==0) print ".^";
        !    else print " once more.^";
        !    ++no_memorized_spells;
        !    ++self.number;
        !    rtrue;
        ],
        activate [obj retvalue;
            if(obj == CheapScenery) {
                meta = true;
                print_ret (string) CS_DEFAULT_MSG;
            }
            if(FlagIsSet(F_PLAYER_IS_FISH))
                "Your webbed fingers are far too clumsy to turn the fragile pages of your spellbook,
                and your altered throat cannot pronounce the precise incantation. You must return
                to your human form before you can cast magic again.";
!            if(self.number>no_memorized_spells) self.number=0;
            if(parent(self) ofclass CScroll) {
                if(TestScope(parent(self))==false) "There is no ", (name) self, " here.";
                print "You read aloud the complicated words of ", (the) self, ".^^";
!            } else if(self.number>0) {
!                --self.number;
            } else {
                if(GrabObject(SpellBook)) {
                    meta = true;
                    print "You must be holding ", (the) SpellBook, " first.^";
                    rfalse;
                }
                if(location == thedark) {
                    meta = true;
                    print "Fumbling through a spellbook in complete darkness is a great way to 
                        accidentally turn yourself into a toad.^";
                    rfalse;
                }
                if(parent(self)~=SpellBook) {
                    meta = true;
                    print "You cannot find ", (the) self, " in ", (the) SpellBook, ".^";
                    rfalse;
                }
!if(location == Crypt) print (the) self, " ", (the) second, "^";
                if(parent(player) provides react_before_magic)
                    if((parent(player)).react_before_magic(self, obj, 0)) rtrue;

                if(self == CopySpell) {
                } else if(self == FreezeSpell) {
                } else if(self == TeleportSpell) {
                    print "Your spellbook snaps open to the correct page, and you speak the complex, resonant
                        incantation of the teleportation spell.^^";
                } else {
                    print (The) SpellBook, " opens itself to the right page, and you read
                            aloud the complicated words of ", (the) self, ".^^";
                }
            }
            if(parent(player) provides react_before_magic)
                if((parent(player)).react_before_magic(self, obj)) rtrue;

            retvalue = self.domagic(obj, 1);

            if(parent(player) provides react_after_magic) {
                ! domagic can change the scope, so we need to update
                ! it before  we continue
                _UpdateScope(player, REACT_AFTER_REASON);
                if((parent(player)).react_after_magic(self, obj)) rtrue;
            }

            return retvalue;
        ]
    ;

Class CSpellWithArgument
    ! A spell that needs a target.
    class CSpell
    with
        activate [obj;
            if(obj==0) {
                meta = true;
                print "You must say what you want to cast the spell on.^";
                rfalse;
            }
            return self.CSpell::activate(obj);
        ]
    ;

CSpellWithArgument IlluminateSpell "illumination spell" SpellBook
    with
        name 'illumination' 'illuminate' 'spell',
        comment "make something glow",
        domagic [obj;
            if(obj provides domagic) if(obj.domagic(self)) rtrue;
            if(obj ofclass CSpell || obj has scenery || obj has static) {
                meta = true;
                print "You cannot cast ", (the) self, " on ", (a) obj, ".^";
                rfalse;
            }
            meta = true;
            if(self has light) print_ret (The) obj, " is already shining brightly.";
            "A sudden light bursts forth, hovering over ", (the) obj, " before quickly fading
            back into the dark. It seems the magic requires a better vessel. Only some magic
            objects can sustain a permanent glow.";
        ]
    ;

CSpellWithArgument CopySpell "copying spell" SpellBook
    with
        name 'copying' 'copy' 'spell',
        comment "copy a spell into the spellbook",
        domagic [obj x;
            if(parent(obj) ofclass CScroll) obj=parent(obj);
            if(obj ofclass CScroll) {
                meta = true;
                x=child(obj);
                if(x==nothing) { print "There is no spell on ", (the) obj, ".^"; rfalse; }
            } else {
                x=obj;
            }
            if(x == player)
                "If you want a twin, you'll have to go back in time.";
            if(x ofclass CSpell) ; else {
                meta = true;
                print "You cannot copy ", (a) x, " into ", (the) SpellBook, ".^";
                rfalse;
            }
            if(x in SpellBook) {
                meta = true;
                "The spell is already in your spellbook.";
            }
            ! obj is now the scroll (if any) or the spell; x is always the spell.
            if(obj ofclass CComplicatedScroll) {
                if(x == ResurrectSpell)
                    "The spellbook begins to glow. It strains at the task, drawing on every scrap of
                    power it has, but the resurrection spell is simply too long, too intricate and
                    too strong to be lifted off the page. The glow dies away. Luckily the scroll
                    itself is unharmed, so you will have to read the spell straight from it.";
                print_ret (The) SpellBook, " begins to glow. Summoning all the power it has,
                ", (the) self, " tries to copy ", (the) x, " into your book, but the spell
                is far too long, complicated and powerful. The glow dies away, but luckily
                ", (the) x, " is unharmed.";
            }
            switch(x) {
            AnimateSpell:
                print
                    "The spellbook opens itself to the correct page, and you speak the complex, resonant incantation of
                    the copying spell.^^A warm, golden radiance bursts from the pages. Slowly and majestically, the glowing
                    runes of the Animation Spell etch themselves onto a blank leaf of parchment. As the light fades, the
                    original scroll crumbles into a fine silver ash that vanishes into thin air.";
                move x to Spellbook;
                remove obj;
                !scope_modified = true;
            TeleportSpell:
                print
                    "The spellbook opens once more, and you recite the copying spell over the silvery scroll.^^
                    The pages flare with a blinding light. The intricate symbols of the teleportation spell bind
                    themselves permanently into your grimoire, while the silvery parchment dissolves into wisps
                    of shimmering smoke.";
                move x to Spellbook;
                remove obj;
                !scope_modified = true;
            default:
                print (The) SpellBook, " begins to glow. Slowly and majestically the words of ",
                            (the) x, " appear on a blank page, shining more brightly than the book
                            itself. The light fades, but the spell remains!";
                move x to SpellBook;
                if(obj ofclass CScroll) {
                    print " The scroll it was written on goes up in smoke as the copying finishes.";
                    remove obj;
                }
            }
            scope_modified = true;
            "^^[You have learned ", (the) x, "]";
        ]
    ;

! ==========================================================================
!     Custom verbs / grammar for the game
! ==========================================================================

#Iftrue (#version_number == 6);
! If I set meta in the Verb definition before is never run
Verb 'picture' * -> Picture;
[ PictureSub; meta = true; "There is no picture for this location."; ];
Verb 'sound' * -> Sound;
[ SoundSub; meta = true; "There is no sound effect for this location."; ];
#IfNot;
Verb meta 'picture' * -> Picture;
[ PictureSub; "This version of the game doesn't have any pictures."; ];
Verb meta 'sound' * -> Sound;
[ SoundSub; "This version of the game doesn't have any sounds."; ];
#Endif;

Extend 'pray'
    * 'to' topic -> Pray;
Verb 'worship'
    * -> Pray
    * topic -> Pray;

Extend 'smell' replace
    * -> SmellRoom
    * noun -> Smell;
[ SmellRoomSub; print_ret (string) MSG_SMELL_DEFAULT; ];

Extend 'listen' replace
    * -> ListenRoom
    * 'to' noun -> Listen;
[ ListenRoomSub; print_ret (string) MSG_LISTEN_DEFAULT; ];

Extend 'examine' first
    * 'room'/'location' -> Look;

Extend 'say' first
    * -> SayDefault;
Extend 'say' last
    * topic -> SayDefault;
[ SayDefaultSub; "Actions speaks louder than words."; ];

Verb 'accuse'
    * creature -> Accuse;
[ AccuseSub; "Accusations achieve nothing without evidence."; ];

Verb 'shake'
    * noun -> Shake;
[ ShakeSub; "That would achieve nothing."; ];

Verb 'talk' 'report'
    * 'to' noun -> TalkTo;
[ TalkToSub;
    if(noun has animate) print_ret (The) noun, " doesn't seem interested.";
    "You feel silly trying to talk to ", (the) noun, ".";
];

Extend 'put'
    * 'hand' 'on' noun -> Touch;

!Extend only 'read' replace * noun -> Read;
Extend 'read' first * noun -> Read;
[ ReadSub; <<Examine noun>>; ];

! special for hawker
Extend 'give' last
    * 'coin' 'to' creature -> GiveNoCoin;
[ GiveNoCoinSub; "You can't see any coin here,"; ];

Extend 'look'
    * 'under' noun -> LookUnder
    * 'through' noun -> LookThrough;
[ LookUnderSub; "There's nothing special there."; ];
[ LookThroughSub; "You can't see through that."; ];

Verb 'untie' * noun -> Untie;
[ UntieSub; "You would achieve nothing by this."; ];
Verb 'point' * 'at'/'to' noun -> PointAt;
[ PointAtSub; "You point. Nothing happens."; ];
Verb 'follow' * noun -> Follow;
[ FollowSub; "That isn't something you can follow. Try choosing a direction to move instead."; ];

!Extend 'wake'
!    * noun 'from' 'the' 'dead'                    -> MagicResurrect
!    * 'up' noun 'from' 'the' 'dead'         -> MagicResurrect;
!Extend 'give'
!    * noun 'new' 'life'                                 -> MagicResurrect
!    * noun 'life'                                             -> MagicResurrect
!    * 'life' 'to' noun                                    -> MagicResurrect;

!Extend 'kill' first * creature -> MagicKill;
Extend 'touch'
    * noun 'with' noun -> Touch
    * noun -> Touch;
Extend only 'hit' 'break' 'smash' replace
    * noun 'with' held -> AttackWith
    * noun -> Attack;

Verb 'time' 'date' * -> Time;

Verb 'ride' 'mount' * creature -> Ride;
Extend 'enter' first * creature -> Ride;
Extend 'get'  first * 'on' creature -> Ride;
[ RideSub; "You can't ride that."; ];

Verb 'thank' 'thanks'
    * creature -> Thanks
    * 'you' creature -> Thanks
    * -> Thanks
    * 'you' -> Thanks;
[ ThanksSub; "You offer a polite word of thanks, though it vanishes quietly into the surrounding silence."; ];

![ MagicAnimateSub;     AnimateSpell.activate(noun); ];
![ MagicFreezeSub;        FreezeSpell.activate(noun); ];
![ MagicHealSub;            HealSpell.activate(noun); ];
![ MagicResurrectSub; ResurrectSpell.activate(noun); ];
![ MagicTeleportSub;    TeleportSpell.activate(); ];
![ MagicKillSub;
!    if(DeathSpell in SpellBook) DeathSpell.activate(noun);
!    else <Attack noun>; ];
[ AttackWithSub;
    if(second==Amulet) <<ThrowAt second noun>>;
    else <<Attack noun>>; ];
[ TimeSub;
    switch(the_time/60) {
        22, 23, 0, 1, 2, 3:            "It is night.";
        4, 5, 6:                                 "It is early morning.";
        7, 8, 9, 10, 11:                 "It is late morning.";
        12, 13, 14, 15, 16, 17:    "It is afternoon.";
        18, 19, 20, 21:                    "It is evening.";
    }
];

Verb 'xyzzy' * -> Xyzzy;
[ XyzzySub;
    "You pronounce the ancient word with great care. Somewhere very far away a door
    seems to swing open. Nothing whatsoever happens here.";
];

Verb 'knock' * 'on' noun -> Knock;
[ KnockSub;
    "There is no response.";
];

#IfDef DEBUG;
Verb 'cheat' * -> Cheat;
[ CheatSub;
    give player light;
    move AnimateSpell to spellbook;
    move TeleportSpell to spellbook;
    ! scope_modified = true; ! taken care of by PlayerTo
    PlayerTo(TeleportRoom);
];
#Endif;

Verb 'help' 'hint' 'hints' 'info' 'about' 'credits' * -> Help;

Object PlayerObject "yourself"
    with
        number 0,
        before NULL, after NULL, life NULL, each_turn NULL,
        time_out NULL, describe NULL,
        capacity 100,
        parse_name 0, orders 0,
        name 'me' 'myself' 'self',
        description [;
            if(FlagIsSet(F_PLAYER_IS_FISH))
                "You look down at your hands which are now pale, scaled, and webbed. A sharp, dorsal fin has
                ripped through the back of your robe. Strangely, your lungs feel eager for the sea air.";
            if(FlagIsSet(F_PLAYER_TORN_CLOTHES))
                "As good-looking as ever, though your travelling robes are now tattered
                from your shift into a sea creature, and your boots remain nearly walked through.";
            "As good-looking as ever, though weeks on the road have left your travelling
            robes mud-spattered and your boots very nearly walked through.";
        ],
        domagic [spell;
            switch(spell) {
            HealSpell:
                "You feel healthier and stronger than before.";
            FreezeSpell:
                "Suddenly you are covered by a thin layer of ice. It is very cold and
                unpleasant, but the ice melts quickly.";
            IlluminateSpell:
                give player light; scope_modified = true;
                "A dazzling light surrounds you and you begin to glow. The light slowly
                fades, but you are now a perfectly adequate light source.";
            AnimateSpell:
                "Strangely, you notice no great difference. You are just as alive as before.";
            ResurrectSpell:
                "This is a spell for raising the dead. Since you are not dead (yet), nothing
                happens.";
            DeathSpell:
                deadflag=1; "Suddenly you cease to exist.";
            }
        ],
        add_to_scope PlayerClothes,
    has concealed animate proper transparent;

Object PlayerClothes "your clothes"
    with
        name 'hems' 'travelling' 'traveling' 'robes' 'boots' 'boot',
        before [;
        "There is no need to worry about your clothing.";
        ],
    has scenery proper;

! ==========================================================================
!     Useful parser / helper routines
! ==========================================================================

![ IsCarried obj; return IsObjInContainer(obj, player); ];

[ IsHeld obj; if(obj in player) rtrue; rfalse; ];

[ GrabObject obj;
    ! Silently ready an object for use (hold it). false if ok, true if impossible.
    if(IsHeld(obj)) rfalse;
    keep_silent=1;
    <Take obj>;
    keep_silent=0;
    if(IsHeld(obj)) rfalse;
    rtrue;
];

[ RemoveObj obj notstop;
    if(notstop==0) { StopDaemon(obj); StopTimer(obj); }
    remove obj;
    scope_modified = true;
];

[ ReplaceObj cur_obj new_obj notstop;
    if(notstop==0) { StopDaemon(cur_obj); StopTimer(cur_obj); }
    move new_obj to parent(cur_obj);
    remove cur_obj;
    scope_modified = true;
];

![ IsObjInContainer obj container;
!    for(:parent(obj)~=container:obj=parent(obj))
!        if(parent(obj)==nothing) rfalse;
!    rtrue;
!];

[ NumberOfNewStones i total;
    total=0;
    for(i=0: i<WantedStones-->0: ++i) {
        if((WantedStones-->(i*2+1)==0) && TestScope(WantedStones-->(i*2+2), player)) {
            WantedStones-->(i*2+1)=1;
            ++total;
        }
    }
    return total;
];

! ==========================================================================
!     Rooms and their contents
! ==========================================================================

Class Room
    has light;

Class DarkRoom;

[ ParseNameMeadowGrass _w _n;
    _w = NextWord();
    while(_w == 'damp' or 'thick' or 'wild' or 'clinging') { _n++; _w = NextWord(); }
    if(_w == 'grass' or 'dew') return _n + 1;
    return _n;
];

Room Meadow "Meadow"
    with
        description [;
            ShowPicture(PIC_MEADOW);
            "You stand in a small, overgrown clearing dominated by a dilapidated hut hunched
            immediately to the south. Looming on all other sides is a dense, ancient forest
            whose twisted boughs form an impenetrable wall of shadow. A faint dirt path cuts
            through the weeds, winding away north into the dark tree line.";
        ],
        cheap_scenery
            'meadow' 'clearing'
            "Just a small patch of overgrown grass, squeezed between the dark forest to the north
             and the dilapidated hut to the south."
            CS_PARSE_NAME ParseNameMeadowGrass
            "The grass is thick, wild, and heavy with a cold, clinging dew that quickly soaks through the
            hems of your travelling robes."
            CS_NO_ADJ 'chimney'
            "A crooked stack of unmortared field stones, leaning with the rest of the hut.
            Whatever is burning inside sends up a smoke that is not quite the colour of
            woodsmoke."
            CS_NO_ADJ 'smoke'
            "It rises in a thin grey thread, and there is something under the woodsmoke that
            catches at the back of your throat. Your mentor is clearly still working."
            'thatched' 'roof'
            "Sagging thatch under a deep pelt of moss, patched here and there with turf. It
            has not been rethatched in your lifetime, and probably not in his."
            'weed' 'weeds'
            "Nettles, dock and rank meadow grass, grown waist-high right up to the walls of
            the hut. Nobody has taken a scythe to this clearing in years."
            'daylight' 'sky'
            "Overhead, the sky is a bruised, oppressive grey, visible only through a jagged tear in the
            dense forest canopy.",
        before [;
#Iftrue (#version_number == 6);
        Picture:
            meta = true;
            ShowPicture(PIC_MEADOW);
            rtrue;
#Endif;
        ListenRoom:
            "The wind rustles softly through the high grass and the heavy canopy overhead.
            Deeper in the trees a lone bird calls out, and then thinks better of it. The
            forest is unsettlingly still.";
        SmellRoom:
            "Wet earth, crushed weeds, and the sharp resin of pine needles drifting out of
            the dark forest. From the south, a faint whiff of woodsmoke hangs about the hut.";
        ],
        in_to RemoteHut, s_to RemoteHut,
        n_to [;
            if(FlagIsSet(F_DONT_TRUST_ISTAR))
                "You take a step toward the northern path, but hesitate. What the dragon said
                lingers heavily in your mind; something is deeply wrong here. Leaving feels like
                running away from a fire that is already spreading. You cannot abandon this now, you
                must see it through to the end.";
            if(TeleportSpell in SpellBook)
                "That winding dirt track is the way you arrived on foot. Trudging all the way back would
                take weeks you simply don't have. Istar gave you the teleportation spell for a reason!";
            "That dirt track is the way you arrived, and there is nothing back down it but weeks of
            hard walking. You did not come all this distance to turn around on the doorstep.";
        ],
        u_to
            "You jump, get a handful of cold air for your trouble, and come down again.
            Flying is well beyond your current magical abilities!",
        d_to
            "You prod at the grass and weeds beneath your boots. There is nothing under them
            but more meadow.",
        cant_go
            "You push into the tree line, but the brambles close ranks and the boughs knit
            together above them. The forest will not let you pass.";

Object -> Path "path"
    with
        name 'faint' 'dirt' 'path',
        description
            "It's little more than a strip of packed, muddy earth cutting through the overgrown grass.
            Looking north, you can see how quickly the path is swallowed up by the encroaching shadows
             of the forest canopy.",
        before [;
        Enter:
            "The path only leads north, back the way you came. Whatever your old teacher
            wants of you is waiting inside the hut to the south.";
        Follow:
            "You have already followed it for three weeks. It goes north, and north is where
            you came from. Whatever your old teacher wants of you is inside the hut.";
        ],
    has scenery;

Object -> Hut "hut"
    with
        name 'hut' 'dilapidated',
        description
            "The structure is a sorry sight. Built from rough-hewn logs that have rotted and warped over the years,
            it leans heavily to one side as if weary from the elements. Thick, dark moss carpets the sagging
            thatch roof, and a thin wisp of acrid smoke curls sleepily from a crude stone chimney.",
        before [;
        Enter: <<Go FAKE_S_OBJ>>;
        ],
    has scenery concealed;

CScroll -> DirtyScroll "weathered scroll"
    with
        name 'weathered' 'discarded' 'dirty' 'scroll' 'parchment',
        initial
            "Nestled deep in the damp grass, a flash of parchment catches your eye.
            It appears to be a discarded scroll.",
        description [;
            if(FlagIsSet(F_SCROLL_REVEALED))
                "The parchment is unrolled now, its surface stained by the acrid fumes of Istar's mixture. Inscribed
                across the centre in sharp, shimmering ink are the ancient runes of an animation spell (used to bring
                inanimate objects to life).";
            if(self has open)
                "The scroll is completely blank. Either somebody went to considerable trouble to tie up an empty page,
                or there is a deeper meaning being hidden away.";
           "It is a tightly rolled cylinder of heavy parchment, tied with a frayed piece of
            twine. The surface is weathered, as if it has been lying out in the damp meadow
            air for some time.";
        ],
        before [;
        Smell: "It smells of damp paper and wet grass.";
        Close, Tie: <<Tie Twine>>;
        Open, Untie: <<Untie Twine>>;
        Read:
            if(FlagIsSet(F_SCROLL_REVEALED)) <<Examine self>>;
            give self open; scope_modified = true;
            "You unroll the parchment far enough to look. The sheet is blank, top to bottom.
            Either somebody went to considerable trouble to tie up an empty page, or there
            is something written here that does not care to be read by just anyone.";
        ],
        add_to_scope Twine,
    has openable;

Object Twine "twine"
    with
        name 'frayed' 'piece' 'of' 'twine',
        description
            "A few turns of coarse hemp twine, frayed at the ends and stiff with damp. It has
            been tied and untied a good many times.",
        before [;
        Close, Tie:
            if(DirtyScroll hasnt open) "It's already bound tightly with the twine.";
            give DirtyScroll ~open; scope_modified = true;
            "You roll the parchment back up tightly and wrap the twine around it.";
        Open, Untie:
            if(DirtyScroll has open) "It's already unrolled.";
            give DirtyScroll open; scope_modified = true;
            "You work at the damp knot until the twine slips free, allowing you to unroll the heavy parchment.";
        ],
    has openable scenery;

Object f_f "forest"
    !class AdjObject
    with
        !adj_name 'dense' 'ancient' 'dark' 'mature' 'impenetrable',
        !noun_name 'forest' 'woods' 'darkness',
        name 'dense' 'ancient' 'dark' 'mature' 'impenetrable' 'forest' 'woods' 'darkness' 'canopy' 'shadows',
        description
            "The trees are massive, ancient oaks and pines, their roots writhing through the
            earth like frozen serpents. Their dense canopy blocks out most of the daylight,
            plunging the depths of the woods into absolute, suffocating darkness.",
        before [;
        Climb:
            "The lowest branches are twenty feet up a trunk with nothing to grip, and the
            canopy above them is thicker than the one you would be climbing out of.";
        Take, Remove: "Unless you have a remarkably large sack and the strength of a titan, the forest
                    is staying exactly where it is.";
        Enter: "Trying to force your way through would only result in torn robes and broken branches.";
        ],
        found_in Meadow Forest ForestPath Mountain,
    has scenery ;

Object f_tree "tree"
    with
        name 'tree' 'trees' 'trunk' 'trunks' 'oaks' 'oak' 'pines' 'pine',
        description
           "Oaks and pines of enormous age, so thick through the trunk that three men could
            not link hands around one. Nothing grows in their shade but moss.",
        before [;
        Climb:
            "The lowest branches are twenty feet up a trunk with nothing to grip, and the
            canopy above them is thicker than the one you would be climbing out of.";
        Take, Remove: "You'd need an axe.";
        ],
        found_in Meadow Forest ForestPath Mountain,
    has scenery;

Object f_roots "roots"
    with
        name 'roots' 'roots' 'thick' 'gnarled' 'loops' 'tangled',
        description
           "The roots break through the damp earth in thick, gnarled loops.",
        before [;
        Take, Remove: "They are firmly anchored to the earth by the massive weight of the trees above.";
        ],
        found_in Meadow Forest ForestPath Mountain,
    has scenery pluralname;

Object f_moss "moss"
    with
        name 'dark' 'green' 'damp' 'moss',
        description
           "A plush, damp carpet of dark green moss coats the base of the massive trees and the exposed roots.",
        before [;
        Eat, Taste: "A quick taste reveals it to be cold, wet, and thoroughly foul. That’s enough of that.";
        Take, Remove: "[200~You have no use for a fistful of wet moss.";
        ],
        found_in Meadow Forest ForestPath Mountain,
    has scenery;

Object f_soil "soil"
    with
        name 'packed' 'muddy' 'soil' 'earth',
        description
            "The soil is heavy with moisture and thick with moss and rotting leaves.",
        found_in Meadow Forest ForestPath Mountain,
    has scenery;

Object HutDoor "door"
    with
        name 'heavy' 'wooden' 'door' 'planks' 'iron' 'bands',
        description [;
            "The hut's door is made of thick, weather-beaten planks of dark pine, bound by rusting iron bands.";
        ],
        before [;
        Knock:
            if(location == Meadow)
                "You rap your knuckles against the planks. From inside comes a shuffle of feet
                and the scrape of a stool being pushed back, but nobody comes to answer.";
        Open, Close:
            "The door already hangs ajar in its warped frame; it has not shut properly in
            years. You need only push it aside and step through.";
        ],
        door_dir (s_to) (n_to),
        found_in Meadow RemoteHut,
    has open door scenery;

[ ParseNameHutWindow _w _n;
    _w = NextWordStopped();
    while(_w == 'solitary' or 'black') { _w = NextWordStopped(); _n++; }
    if(_w == 'window' or 'soot' or 'grease' or 'glass') return _n + 1;
    return _n;
];

[ ParseNameHutFire _w _n;
    _w = NextWordStopped();
    while(_w == 'flickering' or 'stout') { _w = NextWordStopped(); _n++; }
    if(_w == 'flames' or 'fire' or 'log' or 'logs') return _n + 1;
    return _n;
];

[ ParseNameHutFireplace _w _n;
    _w = NextWordStopped();
    while(_w == 'stone' or 'blackened') { _w = NextWordStopped(); _n++; }
    if(_w == 'hearth' or 'fireplace' or 'fieldstone') return _n + 1;
    return _n;
];

[ ParseNameHutIngredients _w _n;
    _w = NextWordStopped();
    while(_w == 'exotic' or 'alchemical') { _w = NextWordStopped(); _n++; }
    if(_w == 'ingredient' or 'ingredients') _n++;
    return _n;
];

[ ParseNameHutNiche _w _n;
    _w = NextWordStopped();
    while(_w == 'small' or 'shallow') { _w = NextWordStopped(); _n++; }
    if(_w == 'alcove' or 'niche') _n++;
    return _n;
];

[ ParseNameHutChimney _w _n;
    _w = NextWordStopped();
    while(_w == 'dark' or 'stone') { _w = NextWordStopped(); _n++; }
    if(_w == 'flue' or 'chimney' or 'vapors' or 'vapours') _n++;
    return _n;
];

[ ParseNameHutRoof _w _n;
    _w = NextWordStopped();
    while(_w == 'low' or 'thatched' or 'dried' or 'reed') { _w = NextWordStopped(); _n++; }
    if(_w == 'roof' or 'ceiling' or 'reeds') _n++;
    return _n;
];

[ ParseNameHutFloor _w _n;
    _w = NextWordStopped();
    while(_w == 'solid' or 'worn') { _w = NextWordStopped(); _n++; }
    if(_w == 'floor' or 'floorboard' or 'floorboard') _n++;
    return _n;
];

[ ParseNameHutWalls _w _n;
    _w = NextWordStopped();
    while(_w == 'stone' or 'stacked' or 'stones') { _w = NextWordStopped(); _n++; }
    if(_w == 'wall' or 'walls') _n++;
    return _n;
];

Room RemoteHut "Hut"
    with
        description [;
            ShowPicture(PIC_HUT);
            "The interior of the hut is cramped and gloomy. Thick soot cakes the solitary window,
            leaving the flickering flames of a stone hearth as the room's sole source of light. Atop
            the fire, rusted iron vessels bubble quietly, venting strange, multi-coloured vapours. A
            massive, cluttered workbench is buried under a chaotic heap of heavy grimoires, brittle
            sheets of paper, and exotic alchemical ingredients. A heavy wooden door leads north, back out
            to the forest path.";
        ],
        before [;
#Iftrue (#version_number == 6);
        Picture:
            meta = true;
            ShowPicture(PIC_HUT);
            rtrue;
#Endif;
        ListenRoom:
            "The fire in the hearth crackles softly, accompanied by the gentle, steady bubbling of the iron vessels
            and the crisp rustle of parchment as Istar turns a page.";
        SmellRoom:
            "The room is thick with the sharp tang of sulfur, burnt wood smoke, and the pungent, bitter aroma of
            strange alchemical vapours mingling with aged leather and dry parchment.";
        Shout:
            "Your shout rings loudly inside the tiny, cramped hut. Istar jumps slightly, nearly
            knocking over a bubbling vessel, before glaring at you in disbelief.
            ~What in the world has gotten into you?~";
        ],
        cheap_scenery
            CS_PARSE_NAME ParseNameHutWalls
            "Most of the hut is built from rough planks, except for a section of stacked
            stone behind the hearth."
            CS_PARSE_NAME ParseNameHutRoof
            "A dense layer of exposed, dried reeds, dark with decades of soot from the hearth below."
            CS_PARSE_NAME ParseNameHutFloor
            "The floorboards are thick planks worn smooth by years of footsteps."
            CS_PARSE_NAME ParseNameHutFire
            "A few stout logs burn steadily in the stone hearth, feeding the flames."
            CS_PARSE_NAME ParseNameHutWindow
            "Thick layers of black grease and soot coat the glass, completely choking out the daylight
            from the meadow outside."
            CS_PARSE_NAME ParseNameHutIngredients
            "Bundled herbs, stoppered jars, a tray of dried beetles and something in brine
            that you decide not to look at twice. Half the labels are in your mentor's hand
            and the other half in no alphabet you know."
            CS_PARSE_NAME ParseNameHutNiche
            "A shallow niche cut into the stone of the chimney breast, just deep enough to
            take the gilded box. The rock around it is scorched black, as though the ward on
            the box has had to defend itself more than once."
            CS_PARSE_NAME ParseNameHutChimney
            "The chimney is a dark stone flue built directly above the hearth, drawing the
            strange vapours up and out of the cramped room."
            CS_PARSE_NAME ParseNameHutFireplace
            "A low arch of blackened fieldstone, heaped with logs that burn a great deal
            hotter than logs ought to. Stained iron cauldrons stand in the
            flames, hissing and sputtering away.",
        n_to Meadow, out_to Meadow,
        u_to "The low, thatched ceiling offers no way upward, unless you fancy poking your head through the dried reed roof.",
        d_to "The floorboards are solid and worn. There are no trapdoors or cellars beneath your feet.",
        cant_go "You bump straight into the hut's sturdy timber walls, cluttered with dusty shelves of strange ingredients.
            The only way out is back through the doorway to the north.";

Object -> hut_hut "hut"
    with
        name 'hut',
        description
            "You are inside the hut. It is a cramped, gloomy space smelling of old parchment and
            boiling alchemy, lit only by the flickering stone hearth.",
        before [;
        Enter: "You are already inside the hut.";
        Exit: <<Go FAKE_N_OBJ>>;
        ],
    has scenery;

Object -> hut_vessel "vessels"
    with
        parse_name [_w _n;
            _w = NextWordStopped();
            while(_w == 'stained' or 'iron') { _n++; _w = NextWordStopped(); }
            if(_w == 'vessel' or 'vessels' or 'cauldron' or 'cauldrons') return _n + 1;
            rfalse;
        ],
        description
            "The liquids inside the vessels range from a viscous, glowing emerald to an oily indigo,
            giving off a scent that prickles the back of your throat.",
        before [;
        Eat, Drink, Taste:
            "You lean over the nearest cauldron and think better of it at once. Whatever is
            bubbling in there was never meant to go anywhere near a mouth.";
        ],
    has scenery pluralname;

Object -> hut_bench "workbench"
    with
        name 'work' 'workbench' 'bench',
        description [;
            print
                "A massive slab of scarred oak that has survived a great many experiments,
                though not without marks. ";
            if(hut_doc in self && children(self)==1) "Books and papers lie on the bench.";
            print "On the bench you see ";
            if(PrintContents(0, self)==false) print "nothing";
            print ".";
        ],
        before [;
        Search: <<Examine self>>;
        ],
    has scenery supporter open;

Object -> -> hut_doc "books"
    with
        name 'books' 'book'  'sheets' 'of' 'paper' 'papers' 'grimoire' 'grimoires',
        description
            "Warped grimoires and loose sheets of papers, most of them older than the hut
            itself. Every margin is crowded with your mentor's cramped, urgent handwriting.",
            !The most interesting ones are about dragons and
            !their magic, but they are strictly theoretical and of little use to you.",
        before [;
        Transfer, Take, Remove:
            if(TestScope(Istar))
                "Istar swats your hand away from the desk. ~Leave that alone!
                Everything is arranged precisely as I need it.~";
        ],
        after [; Take, Remove: give self ~concealed; ],
    has concealed pluralname;

Object -> GoldBox "gilded box"
    with
        name 'beautifully' 'carved' 'filigree' 'gilded' 'gold' 'golden' 'box' 'wooden' 'magic' 'magical',
        initial [;
            print 
                "Resting within a small alcove in the stone wall is a beautifully carved, gilded wooden box";
            if(children(self)>0) { print ". It contains "; PrintContents(0, self); }
            print ".^";
        ],
        description [;
            print "The box is crafted from a rare, dark wood, seamlessly overlaid with an intricate, swirling filigree
                  of pure gold. Professional wizards use enchanted repositories like this to store highly volatile
                  magical items.^";
            if(children(self)>0) { print "^In the box is "; PrintContents(0, self); print ".^"; }
        ],
        before [;
        Open, Close: 
            "The box has no lock to speak of, but it is sealed by a potent ward. Only its
            true owner, Istar, can safely open and close it.";
        Transfer, Take, Remove, LetGo:
            if(TestScope(Istar))
                "You reach for it, but a sharp, static shock bites at your fingers, forcing you to pull back.
               The box is anchored to the alcove by powerful protective spells designed to prevent theft
               and ward off damage.";
        Receive:
            if(children(self)==(WantedStones-->0 - 1)) {
                if(Amulet notin player || Spellbook notin player || DeathSpell notin Spellbook) {
                    "A cold wave of dread stops your hand inches from the box. You feel a deep, 
                    terrifying certainty that you are missing something essential. You cannot
                    bring yourself to place the final stone until you are properly equipped.";
                }
                if(FlagIsClear(F_ENDGAME_WARNING)) {
                    SetFlag(F_ENDGAME_WARNING);
                    "You hover the red stone over the gilded box, overcome by an overwhelming 
                    sense of foreboding. The air grows heavy with impending danger.^^
                    [It would be wise to SAVE your game here.]";
                }
            }
            if((noun ofclass CStone)==false)
                "The golden filigree brightens as you reach inside, and the ward pushes your hand
                gently but very firmly out again. The box stands open for the artefacts Istar is
                hunting, and for nothing else. It has no interest in your luggage.";
        ],
        after [;
        Receive:
            if(children(self)==WantedStones-->0 && TestScope(Istar)) {
                print "Your mentor sees you place the last stone in the box and cries,
                 ~The last stone! Now I can open the gate!~^^\
                 He takes the stones out of the box and says, ~Come with me. Great tasks await.~
                Everything turns yellow as he reads a teleportation spell, and you are carried
                away to another place.^^";
                StartDaemon(Demon);
                PlayerTo(Crypt);
                rtrue;
            }
        ],
    has container open static;

Object -> Istar "Istar"
    with
        name 'master' 'mentor' 'teacher' 'old' 'wizard' 'istar' 'man',
        domagic [spell;
            if(spell==DeathSpell) {
                if(location == Crypt) rfalse;
                if(FlagIsSet(F_DONT_TRUST_ISTAR))
                    "As the final syllables leave your lips, your voice falters. The dragon's words
                    planted dark seeds of doubt, but you still have no proof. Striking down your own
                    mentor on mere suspicion is a line you cannot cross.";
            }
            print (The) self, " stops the spell with a wave of his hand.
                  ~What foolishness are you up to? Pick on someone your own size.~^";
            rtrue;
        ],
        initial [;
            if(Folio in self) {
                move Folio to player;
                update_moved = true;
                scope_modified = true;
                "Your old mentor, Istar, is hunched over the workbench, intently poring over a faded tome.
                When he sees you he says, ~My boy, I am so glad to see you again. Great tasks await us, but
                to begin with, I need you to read this.~ He picks up a slim, leather-bound folio and presses
                it into your hands. ~It is the culmination of everything I have uncovered since my exile.~";
            }
            print (string) random(
                "Your mentor reads a parchment.",
                "Your mentor checks the contents of one of the beakers.",
                "Your mentor ponders something."), "^";
        ],
        react_after [;
        Go:
            switch(NumberOfNewStones()) {
            0: rfalse;
            1: print "As you enter the hut your old mentor says, ~I see you have found a
                     new stone. Well done. Put it in the gilded box.~^^";
            default: print "As you enter the hut your old mentor says, ~I see you have
                           found more stones. Very good. If you keep up this pace we shall
                           soon be done. Put the stones in the gilded box.~^^";
            }
            rfalse;
        ],
        description [;
            "Time has not been kind to your old teacher. His once-proud silver beard is
            tangled and stained with potion ingredients, and deep lines of exhaustion are
            etched into his face. Yet as he looks up at you, the familiar, brilliant spark
            of intellect still dances in his eyes.";
        ],
        before [;
        ShoutAt:
            "You raise your voice, but Istar merely winces and rubs his temples. 
            ~There is no need to shout, my boy. My hearing is intact, even if my patience
            is wearing thin.~";
        TalkTo:
            "Istar adjusts his robes, eyeing you with sharp intensity. ~There is no time
             for idle chatter. If you have questions, ask them directly.~";
        ],
        life [w1 w2 c;
        Order:
            "~There are evil forces lurking, and I dare not perform any magic or action that could give
            me away,~ Istar whispers. ~That is why I called for you. They will take no notice of you,
            leaving you free to do what must be done.";
        Ask, Tell:
            w1 = 0;
            w2 = 0;
            wn=consult_from; c=consult_words; if(c>0) w1=NextWord();
            if(w1=='the') { c=c-1; if(c>0) w1=NextWord(); }
            if(c>1) w2=NextWord();
            if(c>2) "What you cannot say in few words, probably isn't worth saying.";
            if(second == BlackStone) { w1 = 'black'; w2 = 'stone'; }
            if(second == RedStone) { w1 = 'red'; w2 = 'stone'; }
            if(second == GreenStone) { w1 = 'green'; w2 = 'stone'; }
            if(second == BlueStone) { w1 = 'blue'; w2 = 'stone'; }
            if(w1 == 'gate')
                "~A door,~ he says, ~and on the other side of it, light. Nothing more than that,
                and nothing less. Read the folio, my boy, and stop making me say aloud what I
                have already written down properly.~";
            if(w1 == 'paper' or 'papers' or 'book' or 'books')
                "Istar frowns and waves a hand protectively over the desk. ~Those are decades of
                notes, observations, and failed attempts; far too delicate for idle curiosity.
                Just concern yourself with what I handed you.~";
            if(w1=='spellbook' || (w1 == 'spell' && w2 == 'book'))
                "~A wizard's most vital tool, my boy. Keep it close, and ensure you copy any magic
                 you encounter into its pages. You never know when a spell might prove useful.~";
            if(w1 == 'himself' or 'istar')
                "He waves a hand at the crooked walls, the smoking cauldrons, the mouldering
                thatch. ~You see what I have come to. Fifty years at the Academy, and this is
                what they let me keep. Still, the roof holds. Mostly.~";
            if(w1 == 'academy')
                "His face darkens. ~The Arch-Mages felt something stirring in the dark and
                decided it must be me. I do not blame them for being frightened, my boy. I blame
                them for being lazy about it.~";
            if(w1 == 'summary' or 'paper' or 'report' or 'folio')
                "Istar doesn't look up from his work. ~I put it in writing so I wouldn't have
                to repeat myself, lad. Read the pages.~";
            if(w2 == 'stone' or 'stones') {
                if(w1 == 'black')
                    "Istar gestures toward the gilded box. ~The stone of void is resting right here before us.
                    Its power is potent, volatile, and deeply unsettling.~";
                else if(w1 == 'red')
                    "Istar's eyes glint with memory. ~The Stone of Ember, as the ancients called it. It is
                    said to burn with an inner fire that never dims.~";
                else if(w1 == 'green')
                    "Istar frowns slightly, lowering his voice. ~The Stone of Verdure. Bound to the root, 
                    coil, and life force of the wild earth.~";
                else if(w1 == 'blue')
                    "Istar nods slowly. ~The Stone of Tides. Woven with the essence of deep waters and
                    tempestuous winds.~";
                else
                    "Istar scoffs, shaking his head. ~That is no stone of power, just ordinary rubble.
                    Do not let your imagination wander.~";
            }
            if(w1 == 'stone' or 'stones')
                "He taps the folio in your hands. ~Elemental stones. Four of them, cut long
                before the first cities were built. I have one. The others lie scattered across
                half the world, and I am too old and too closely watched to go after them
                myself.~";
            if(w1 == 'magic' or 'spell' or 'spells')
                "~You ought to know what magic is by now. But remember that there are
                several kinds of magic. Lately I have tried to explore the mighty magic
                that demons and dragons use. That, of course, is why my colleagues turned
                against me. They are jealous and afraid.~";
            if(w1 == 'white' or 'gate')
                 "~The only way I know of to stop the return of the Old Gods is to open the
                 gate to another dimension, where we can draw on white magic. I know how to
                 find the gate, but I need the stones to open it. I cannot leave the hut, so
                 it is up to you to save us all.~";
            if(w1 == 'gods' || (w1 == 'black' or 'old' && w2 == 'gods'))
                 "~I have studied black magic for a long time, and I can tell you that its
                 power is dangerous and mighty. It seems to stem from beings that once lived
                 on earth, commonly called the Old Gods. I fear they will soon return, and
                 that they will crush us like insects unless we manage to stop them.~";
            if(w1 == 'potions' or 'liquids' or 'ingredients')
                 "~Touch nothing. I am in the middle of an experiment.~";
            if(w1 == 'demon' or 'demons')
                "Istar looks up, honestly puzzled. ~A demon? My boy, if there were a demon within
                a hundred leagues of this hut, I should certainly have noticed.~";
            if(w1 == 'dragons' or 'dragon')
                "~Yes, dragons truly are fascinating. They are greedy and follow their own
                moral code, but I would not call them evil. They do value their possessions
                highly, and stealing from a dragon is not to be recommended. More interesting
                to us is that they have great knowledge of magic. They know spells more
                advanced than any of our best wizards can master. But they know the worth of
                their knowledge. No dragon has ever taught its arts to a human. They would
                rather die.~";
            if(w1 == 'me' or 'myself')
                 "~You were always my favourite pupil, and I knew you would help me.~";
            if(w1 == 'hut' or 'forest')
                 "~I may live a little far out in the wilderness, but no one disturbs me here.~";
            if(w1 == 'box')
                "~A wizard's strongbox,~ he says. ~Nothing goes into it that I have not made room
                for, and nothing comes out that I have not called for. The stones will be safe
                in there until the hour I need them.~";
            if(w1 == 'teleportation')
                "~I made this spell to ease your search. It will carry you close to the stones.~";
            if(w1 == 'scroll' or 'parchment' || w2 == 'scroll' or 'parchment') {
                if(GiveOrShowDirtyScroll()) rtrue;
            }
            "Istar shakes his head dismissively. ~That matters little right now. Pay attention to what is at hand.~";
        Answer:
            "~Later, my boy, later,~ says Istar, waving the greeting away. ~Read the folio
            first. Everything I could say to you is already written in it, and written better.~";
        Show, Give:
            if(noun == Folio)
                "Istar waves a hand dismissively. ~I wrote those pages for your benefit, not mine. 
                Read what I wrote instead of fussing with it.~";
            if(noun == SpellBook)
                "He leafs through a few pages and hands it back with a fond, slightly wistful
                smile. ~The same book. You have kept it well. Whatever else the Academy did to
                you, it taught you to look after your tools.~";
            if(noun ofclass CStone) {
                <Ask self noun>;
                if(noun notin GoldBox) 
                    "^He gestures toward the gilded box. ~Put it inside with its brothers, lad.~";
                rtrue;
            }
            !if(noun==PlayerObject || noun==DirtyScroll || noun==Folio)
            if(GiveOrShowDirtyScroll()) rtrue;
        ],
        react_before [;
        Go, Exit:
            if(selected_direction && selected_direction ~= n_to && selected_direction ~= out_to) rfalse;
            if(FlagIsClear(F_FOLIO_READ))
                "Istar has only just handed you his folio. You ought to hear what he has to say before leaving.";
            if(BlackStone in self) {
                move BlackStone to GoldBox;
                move SilverScroll to player;
                update_moved = true;
                scope_modified = true;
                print "^As you turn towards the door to leave, Istar calls out,
                      ~Before you go, I should show you my stone.~ He picks up
                      a black stone and places it in ", (the) GoldBox,
                      ". ~If you find more stones, I want you to put them in the box. Take
                      this too,~ he says, handing you a silvery scroll. ~The stones are far
                      too distant for you to reach on foot. Copy this teleportation spell into
                      your spellbook and you can travel faster.~^";
                rtrue;
            }
            !if(IsCarried(Folio) && TestScope(Folio)) {
            !    move Folio to RemoteHut;
            !    print "^~It is safest that this stays here,~ says ", (the) Istar,
            !          ", taking ", (the) Folio, " from your hands before you step outside.^^";
            !}
        ],
    has animate proper;

[ GiveOrShowDirtyScroll;
    if(TestScope(DirtyScroll)) {
        if(parent(AnimateSpell)==DirtyScroll) {
            "Istar arches an eyebrow. ~Awakening the unliving is a perilous path, my boy. See that you
             exercise proper restraint when casting it.~";
        } else {
            print
                "Istar strokes his beard, squinting at the parchment. ~Hmm, I suspect this scroll holds
                secrets meant only for discerning eyes. I encountered a cipher like this many decades ago.
                Let us try a simple revealing trick.~^^
                With practised hands he pours a measure of emerald fluid into a ceramic dish and
                stirs in a viscous yellow tincture. The mixture hisses violently, filling the
                cramped room with a thick, acrid smoke. Undeterred by the fumes, Istar holds
                your scroll over the rising vapours. After a tense minute he passes it back to
                you. Invisible ink has bloomed across the surface in sharp, glowing runes. It is
                a spell!^^
                Istar strokes his beard flat and says nothing at all, which is his way of being
                insufferably pleased with himself.^";
            move AnimateSpell to DirtyScroll;
            scope_modified = true;
            SetFlag(F_SCROLL_REVEALED); ! It's been opened and its contents revealed
            give DirtyScroll open; scope_modified = true;
            Achieved(TASK_FINDING_ANIMATE_SPELL);
            rtrue;
        }
    }
    rfalse;
];

Object -> -> Folio "folio"
    with
        name 'folio' 'notes' 'report',
        description [;
            "Inscribed in your mentor's familiar, frantic handwriting is a harrowing log
            of his forbidden studies.^^
            He writes that the present age will soon give way to an era of terror and dread,
            heralded by the return of the Old Gods to the Earth. It would mean nothing less
            than the annihilation of humanity. Ever since his exile from the Academy he has
            searched, without rest, for a way to delay the waking of these malevolent
            powers.^^
            There is but one hope. By opening a gateway to a higher dimension, he can channel a
            torrent of pure, white magic powerful enough to seal the evil gods away. To tear open this
            gate, however, he requires ",
            (LanguageNumber) WantedStones-->0, " elemental stones. He already possesses the first, a
            black, abyssal stone, and he needs your help to unearth the remaining three.";
        ],
        after [;
        Read, Examine: SetFlag(F_FOLIO_READ);
        ],
    ;


[ ParseNameSteppeGrass _w _n;
    _w = NextWordStopped();
    if(_w == 'steppe') {
        _w = NextWordStopped();
        if(_w == 'grass') return 2;
    }
    while(_w == 'wild' or 'dry' or  'waist-height') { _w = NextWordStopped(); _n++; }
    if(_w == 'grass') _n++;
    return _n;
];

[ ParseNameSteppe _w _n;
    _w = NextWord();
    if(_w == 'boundless' or 'wind-swept') { _n++; _w = NextWord(); }
    if(_w == 'steppe' or 'landscape' or 'ground' or 'grass') return _n + 1;
    return _n;
];

[ ParseNameSteppeRunes _w _n;
    _w = NextWordStopped();
    while(_w == 'glowing' or 'writhing') { _w = NextWordStopped(); _n++; }
    if(_w == 'rune' or 'runes') _n++;
    return _n;
];

[ ParseNameYellowCloud _w _n;
    _w = NextWord();
    if(_w == 'yellow' or 'brisk' or 'magical') { _n++; _w = NextWord(); }
    if(_w == 'cloud' or 'mist' or 'fog' or 'air') return _n + 1;
    return _n;
];

Room TeleportRoom "On the Steppe"
    with
        description [;
            ShowPicture(PIC_TELEPORT);
            PlaySound(SND_EERIE, 0);
            "The yellow cloud dissipates, leaving you standing in a boundless, wind-swept
            steppe that rolls onward to the horizon. Strangest of all, you find yourself
            encircled by four free-standing, ornate archways, each facing one of the
            cardinal directions of the compass.";
        ],
        cheap_scenery
            CS_PARSE_NAME ParseNameSteppeGrass
                "Waist-high steppe grass, bleached the colour of old straw and bending all one
                way in the wind. There is not a fence, a track or a rooftop anywhere in it."
            CS_PARSE_NAME ParseNameSteppe
                "The steppe stretches as far as the eye can see under a pale, vast sky. The dry
                grass whispers softly in the cold wind, broken only by the eerie presence of the
                four archways."
            CS_PARSE_NAME ParseNameSteppeRunes
                "Deep-cut characters march across each keystone in a script far older than anything you were taught
                to read. They pulse slowly, in a rhythm uncomfortably like breathing."
            'compass' 'directions'
                "There is no compass here to look at. The archways themselves do the work, standing true to north,
                south, east and west and cutting the vast horizon into four quarters."
            CS_PARSE_NAME ParseNameYellowCloud
                "The magical mist has already thinned and vanished into the brisk steppe air, leaving behind only the faint,
                ozone scent of teleportation magic.",
        react_before_magic [spell;
            if(spell == TeleportSpell)
                "The spell will not take hold. The archways have a grip on this place, and until
                you walk under one of them you are staying exactly where you are.";
        ],
        before [;
#Iftrue (#version_number == 6);
        Picture:
            meta = true;
            ShowPicture(PIC_TELEPORT);
            rtrue;
        Sound: 
            meta = true;
            PlaySound(SND_EERIE, true);
            rtrue;
#Endif;
        ListenRoom:
            "A low, persistent wind moans across the open plains, whistling softly as it passes through the ancient stone
            carvings of the four archways. Beyond the wind, the silence is absolute and immense.";
        SmellRoom:
            "The air is cool, crisp, and pure, carrying the clean scent of dry wild grass and sun-baked earth,
            untainted by smoke or civilization.";
        ],
        n_to [; print "A yellow cloud surrounds you, and as it clears you find yourself in a...^^";
                PlayerTo(Forest); rtrue; ],
        s_to [; print "A yellow cloud surrounds you, and as it clears you find yourself in the...^^";
                PlayerTo(Meadow); rtrue; ],
        e_to [; print "Step by step, you pass beneath the eastern arch. A swirl of yellow mist envelops you once more,
                    and as it clears, the wide steppe vanishes...^^";
                PlayerTo(VillageRoad); rtrue; ],
        w_to [; print "A yellow cloud surrounds you, and as it clears you find yourself...^^";
                PlayerTo(TempleYard); rtrue; ],
        u_to "The sky over the steppe is enormous, cloudless and entirely out of reach.",
        d_to
            "Dry turf and hard-packed earth, bound together by the roots of a thousand years
            of grass. You would need a spade and a fortnight to get anywhere.",
        cant_go "You can only leave through the archways.";

Object -> Archway "archway"
    with
        parse_name [w n;
            w = NextWordStopped();
            if((w == 'n' or 'north' or 'northern') ||
               (w == 's' or 'south' or 'southern') 
               (w == 'e' or 'east' or 'eastern') 
               (w == 'w' or 'west' or 'western')) {
                w = NextWordStopped();
                n++;
            }
            if(w == 'archway' or 'arch' or 'portal' or 'gate' or
                    'door' or 'doorway' or 'keystone') n++;
            return n;
        ],
        description
            "Apart from their alignment with the compass points, all four arches appear identical.
            Glowing runes are cut into its keystone, and the air beneath them hums quietly to itself.",
        before [; return Archways.before(); ],
    has scenery;

Object -> Archways "archways"
    with
        name 'archways' 'archs' 'portals' 'gates' 'doors' 'doorways' 'keystones',
        description
            "Four massive stone arches stand in a wide circle around you, each squarely
            aligned with one of the cardinal compass directions. Glowing runes are cut into
            the keystone of every arch, and the air beneath them hums quietly to itself.",
        before [;
        LookThrough:
            "Through the arch you can see the same grass, the same wind, the same empty horizon.
            Whatever lies on the other side does not show itself until you walk under the stone.";
        Touch:
            "The stone is oddly warm under your palm, and the runes brighten at the contact,
            as though they can tell a wizard by feel.";
        ],
    has scenery pluralname;

    Room Forest "Forest"
    with
        description
            "You stand on a path in a mature forest, deep enough that the daylight arrives
            green and second-hand. The path leads on eastward between the trees, and every
            other direction is trunks.",
        cheap_scenery
        'wooden' 'wall'
           "The dense forest makes easy access impossible." 
        CS_NO_ADJ 'mountain'
            "Through the thick canopy to the east, you catch glimpses of a jagged,
            towering mountain peak rising against the sky."
        CS_NO_ADJ 'path'
            "A narrow dirt track, packed flat by years of passage, winding eastward through the trees.",
        before [;
        ListenRoom:
            "Ancient branches creak softly high above, and the wind whispers through a thick canopy of leaves.
            Somewhere in the dense foliage, wild birds call back and forth, accompanied by the occasional rustle of
            small forest creatures in the underbrush.";
        SmellRoom:
            "The air is cool, damp, and rich with the scents of decaying autumn leaves, wet bark, moss, and the
            earthy fragrance of wild mushrooms sprouting along the shaded path.";
        ],
        e_to ForestPath,
        s_to "The forest closes in just as solidly on that side. The path runs east and nowhere else.",
        w_to "Behind you the trunks crowd right up to the path's edge. You did not walk into
            this forest, and you will not be walking out of it either.",
        u_to "The lowest branches are far out of reach, high above in the suffocating canopy.",
        d_to "The damp forest floor is deep in moss and fallen pine needles, and there is nowhere to go down.",
        cant_go
            "The trees grow far too close together here, their thick trunks and tangled roots forming an
            impassable wooden wall. The path only runs east.";

[ ParseNameForestPath _w _n;
    _w = NextWordStopped();
    while(_w == 'narrow' or 'dirt' or 'forest') { _w = NextWordStopped(); _n++; }
    if(_w == 'path') _n++;
    return _n;
];

Room ForestPath "Forest Path"
    with
        description [;
            ShowPicture(PIC_WOOD);
            "You stand on a narrow path in a dark forest. Ahead to the east the trees thin
            out against the grey flank of a tall mountain; behind you the path runs west,
            back into the gloom.";
        ],
        cheap_scenery
        CS_NO_ADJ 'mountain'
            "Ahead to the east, the sheer grey rock face of a tall mountain looms above the
            treeline, its peak jagged against the overcast sky."
        CS_PARSE_NAME ParseNameForestPath
            "The narrow dirt path continues east towards the foot of the mountain, or west
            back into the heart of the forest.",
        before [;
#Iftrue (#version_number == 6);
        Picture:
            meta = true;
            ShowPicture(PIC_WOOD);
            rtrue;
#Endif;
        ListenRoom:
            "The dense forest canopy muffles most sound, creating a heavy, expectant silence. Only a faint, distant
            howling of mountain wind and the unsettling crackle of a dry twig somewhere in the shadow-draped
            woods interrupt the stillness.";
        SmellRoom:
            "The air turns noticeably cooler, laden with the sharp, resinous smell of pine needles, damp granite dust,
            and a faint chill blowing down off the mountain slopes.";
        ],
        n_to
            "The trees stand shoulder to shoulder that way, with bramble filling every gap
            between them. The path is the only road through this forest, and it runs east and west.",
        e_to Mountain, w_to Forest,
        u_to "The tangled canopy overhead blocks any attempt to climb upward.",
        d_to "The dirt beneath your boots is hard-packed, offering nowhere to go down.",
        cant_go
            "The dark woods are far too thick to navigate.";

Room Mountain "The Mountain"
    with
        description
            "The forest gives out here against the flank of a great mountain, far too steep
            to climb. A path leads back west into the trees, and a short way north of you a
            cave mouth opens in the rock.",
        cheap_scenery
        CS_NO_ADJ 'path'
            "A narrow track leads back west into the shadows of the dense forest.",
        before [;
        ListenRoom:
            "A brisk alpine wind rushes across the sheer stone face of the mountain, whistling through the sparse
            trees. From inside the nearby cave mouth comes a faint, echoing drip of water.";
        SmellRoom:
            "The rich, leafy smell of the western forest gives way here to the sharp scent of cold rock.";
        ],
        w_to ForestPath, n_to Cave, in_to Cave,
        u_to "The mountain slope is far too steep to scale without proper gear.",
        d_to "The rocky ground offers no way downward.",
        cant_go "The sheer mountain wall curves around you, blocking further passage.";

Object -> CaveEntrance "cave opening"
    with
        parse_name [ _w _n;
            _w = NextWordStopped();
            while(_w == 'cave') { _w = NextWordStopped(); _n++; }
            if(_w == 'mouth' or 'opening' or 'cave' or 'entrance') _n++;
            return _n;
        ],
        description
            "A dark, jagged opening yawning in the side of the mountain. A faint cool
            draught whistles out of the shadows within, and it smells of wet stone.",
        before [;
        Enter: <<Go FAKE_N_OBJ>>;
        ],
    has scenery open;

Object -> GreatMountain "great mountain"
    with
        name 'great' 'mountain' 'wall' 'stone' 'jagged' 'grey' 'colossal' 'rock',
        description
            "A colossal wall of jagged grey stone towers far above you into the sky, its
            sheer faces slick and completely vertical.",
        before [;
        Climb:
            "The rock rises smooth and sheer for hundreds of feet. Without ropes, irons and a
            great deal more youth than you have left, it is out of the question.";
        ],
    has scenery;

[ ParseNameCaveWall _w _n;
    _w = NextWordStopped();
    while(_w == 'high' or 'uneven') { _w = NextWordStopped(); _n++; }
    if(_w == 'wall' or 'walls') _n++;
    return _n;
];

Room Cave "Cave"
    with
        description
            "The cave is a single irregular chamber. Daylight reaches in through the mouth in
            the south wall, but it gives out well before the far corners do, so there is no
            telling how large the place really is. What you can see is a tunnel running on
            northward.",
        cheap_scenery
        CS_PARSE_NAME ParseNameCaveWall
        "The stone walls are cold and uneven, glistening with a thin sheen of moisture."
        'irregual' 'chamber'
        "The high, uneven walls of the cave stretch up into heavy shadows. Water drips quietly in the gloom."
        'daylight' 'light'
        "Faint daylight spills in from the south cave mouth, though it barely pierces the
        shadows deeper inside the chamber."
        'shadow' 'shadows'
        "Deep shadows obscure the far corners of the cave, making it impossible to gauge
        its full size without a light source."
        'stalactite' 'stalactites'
            "Long teeth of wet limestone hang from the dark overhead, each with a bead of
            water gathering slowly at its tip."
        CS_NO_ADJ 'tunnel'
        "A dark, rough-hewn passage leads further north into the heart of the mountain.",
        before [;
        ListenRoom:
            "Drips of water fall rhythmically from unseen stalactites in the high, shadowy ceiling, splashing
            into small pools below. Your own breathing echoes softly off the damp stone walls.";
        SmellRoom:
            "The room is cool and moist, filled with the heavy scent of thick mud, damp rock, and stagnant
            water, with just a hint of fresh air wafting in from the south entrance.";
        ],
        n_to MountainHall,
        s_to Mountain, out_to Mountain,
        u_to "The jagged ceiling of the cave offers no way upward.",
        d_to "The muddy cavern floor is solid stone beneath the silt.",
        cant_go "Rough stone walls lie that way, solid and impassable.";

Object -> CaveOpening "cave opening"
    with
        parse_name [ _w _n;
            _w = NextWordStopped();
            while(_w == 'cave') { _w = NextWordStopped(); _n++; }
            if(_w == 'mouth' or 'opening' or 'entrace') _n++;
            return _n;
        ],
        description
            "The cave opening is letting in a cool draft and the pale,
             distant light of the mountain outside.",
        before [;
        Enter, Exit: <<Go FAKE_S_OBJ>>;
        ],
    has scenery open;

Object -> CaveMud "mud"
    with
        name 'mud',
        description
            "Cold grey silt, washed down from somewhere deeper in the mountain and thick
            enough to take the print of your boot.",
        before [;
        Search:
            "You sift through the cold silt with your fingers and turn up nothing but grit
            and a few small, clean bones.";
        ],
    has scenery;

[ UpSlope normalroom;
    if(FlagIsSet(F_TUNNEL_FROZEN)) {
        print (string) random(
            "The ground is frozen and hard to climb.",
            "With some effort you manage to climb the frozen slope."), "^^";
    } else {
        print (string) random(
            "The slope is steep, and you are left breathless.",
            "With some effort you climb the steep slope."), "^^";
    }
    return normalroom;
];

[ DownSlope normalroom;
    if(location == Tunnel && LeftStatue in Tunnel) 
        "You attempt to march past the sentinels, but as you step between them, an invisible force like
        compressed air slams against your chest, throwing you back into the tunnel. The statues remain
        motionless, watching.";
    if(location == Tunnel && (LeftWarrior in Tunnel || RightWarrior in Tunnel)) 
        "The living statue is flailing madly across the narrow passage, its strikes ringing against the
        rock walls. Trying to squeeze past its violent reach would be total suicide.";
    if(location == thedark)
        "Venturing into the pitch black is suicide. Head back south to the safety of the cave.";
    if(FlagIsSet(F_TUNNEL_FROZEN)) {
        print "The slope is frozen, and you slide down.^^";
    } else {
        print (string) random(
            "The slope is so steep that you half-run down it.",
            "You walk easily down the slope."), "^^";
    }
    return normalroom;
];

[ ParseNameHallWall _w _n;
    _w = NextWordStopped();
    while(_w == 'upper' or 'lower' or 'natural' or 'jagged' or 'flat') { _w = NextWordStopped(); _n++; }
    if(_w == 'wall' or 'walls' or 'rock') _n++;
    return _n;
];

DarkRoom MountainHall "The Rock Hall"
    with
        description
            "A great cavity in the mountain, hollowed out by nature and then squared off and
            widened by human hands. It was a grand feast hall once; now somebody keeps it as
            a storeroom, and rows of crates and packages stand against the walls under a
            thick coat of dust. A large doorway is set in the north wall, and beyond it a
            slope runs down into the darkness.",
        cheap_scenery
        CS_PARSE_NAME ParseNameHallWall
            "The upper walls are natural, jagged rock, while the lower sections have
             been carved flat by ancient tools."
        'large' 'cavity'
            "The vast chamber opens up overhead, its natural stone walls roughly chiselled
            and squared off to form a cavernous room."
        'feast' 'hall'
            "Though dusty and bare now, ancient torch sconces and faded carvings hint at the
            grand banquets once held here."
        'store' 'room'
            "Rows of dusty wooden crates and heavy wrapped packages are stacked high against
            the stone walls."
        'carving' 'carvings'
            "Faded reliefs of feasting figures ring the hall at shoulder height, their faces
            worn away to smooth ovals by damp and time."
        'large' 'doorway'
            "A broad opening cut square into the north wall. Beyond it the floor falls away
            into a dark, downward slope."
        'torch' 'sconces'
            "Iron torch brackets are set into the walls at regular intervals, each one
            crusted with the cold, black remains of a fire that went out centuries ago."
        CS_NO_ADJ 'dust'
            "A grey, velvety carpet coats every surface."
        CS_NO_ADJ 'slope'
            "Through the north doorway, a steep stone incline drops away into pitch-black
            depths. It looks a good deal easier to go down than to come back up."
        CS_NO_ADJ 'storeroom'
            "Rows of dusty wooden crates and heavy wrapped packages are stacked high
            against the stone walls.",
        before [;
        ListenRoom:
            "The hall is unnaturally still. Draughts off the northern slope whisper around
            the wooden crates, carrying a hollow echo up from the depths below.";
        SmellRoom:
            "The room smells heavily of dry dust, old timber, and age. Beneath the stale air lingers a faint,
            bitter odour of mildew from the decaying packages.";
        ],
        u_to "The vaulted rock ceiling is lost in the dark, far beyond your reach.",
        n_to [; return DownSlope(Tunnel); ],
        d_to [; return DownSlope(Tunnel); ],
        s_to Cave,
        cant_go "Rough-hewn rock walls form a solid barrier.",
    ;

CComplicatedScroll BlackScroll "black scroll" MountainHall
    with
        name 'black' 'scroll' 'parchment',
        initial "You see a scroll wedged between two crates.",
        description [;
            "It reads: ~The resurrection spell -- raise the dead.~ The spell itself runs on
            for a great many lines, and every one of them is more complicated than the last.";
        ],
    ;

Object -> mh_box "crates"
    with
        name 'crates' 'crate',
        description "Rough wooden boxes of various sizes, nailed shut and coated in a thick layer of dust.",
        before [;
        Open:
            "The lids are nailed down hard and the wood has swollen tight with damp. You
            would need a crowbar and a very good reason.";
        Take, Remove:
            "The crates are far too heavy and cumbersome to carry around.";
        Search:
            "You feel along the gaps between the dusty crates and turn up nothing but cobwebs
            and a dead spider of impressive size.";
        ],
        has scenery pluralname;

Object -> mh_package "packages"
    with
        name 'packages' 'package' 'box',
        description "Heavy cloth-wrapped bundles tied tightly with frayed twine, stacked alongside the crates.",
        before [;
        Take, Remove:
            "The packages are far too heavy and cumbersome to carry around.";
        Search:
            "You rummage through the packages but find nothing of interest.";
        ],
        has scenery pluralname;

[ ParseNameTunnelSlope  _w _n;
    _w = NextWordStopped();
    while(_w == 'steep') { _w = NextWordStopped(); _n++; }
    if(_w == 'tunnel' or 'slope' or 'passage' or 'incline') _n++;
    return _n;
];

[ ParseNameTunnelHall  _w _n;
    _w = NextWordStopped();
    while(_w == 'rock') { _w = NextWordStopped(); _n++; }
    if(_w == 'hall') _n++;
    return _n;
];

DarkRoom Tunnel "Tunnel"
    with
        description [;
            print "A steep passage dropping away from the rock hall into the dark. Water trickles
                down the slope from somewhere above, and the floor beneath it is thick with ";
            if(FlagIsSet(F_TUNNEL_FROZEN))
                print "ice and frozen mud, which makes it hard to walk";
            else
                print "mud";
            ".";
        ],
        cheap_scenery
        'dark' 'darkness'
            "You can't make out anything further down the tunnel from here."
        CS_PARSE_NAME ParseNameTunnelHall
            "Back up the muddy slope, the entrance opens into the dim outline of the Rock Hall."
        CS_PARSE_NAME ParseNameTunnelSlope
            "The passage slopes steeply away, its muddy floor glistening in the dim light."
        'battleaxe' 'axe'
            "The axe is blunt and notched, but its sheer weight  makes it look no less lethal."
        'broadsword' 'sword'
            "A slab of stone sword, chipped along one edge. Carved or not, you would not care
            to be standing in front of it."
        CS_NO_ADJ 'dagger'
            "Short, curved and held low and close, in the grip of a man who has used one before.",
        time_left 0,
        time_out [;
            if(player in self) print "^The ice melts.^";
            ClearFlag(F_TUNNEL_FROZEN);
        ],
        each_turn [;
            if(FlagIsSet(F_TUNNEL_FROZEN)) {
                if(LeftWarrior in self && RightWarrior in self) {
                    move LeftWarrior to DragonHall;
                    move RightWarrior to DragonHall;
                    move Statues to DragonHall;
                    scope_modified = true;
                    if(player in self) {
                        print
                            "^The warrior and the barbarian slip on the ice at the same moment and go down the
                            slope together. The barbarian grabs at your leg on the way past, and takes you with him.^^";
                        PlayerTo(DragonHall);
                    }
                }
                if(LeftWarrior in self) {
                    if(player in self) {
                        print "^", (The) LeftWarrior, " slips on the ice but manages to keep his balance.^";
                    }
                }
                if(RightWarrior in self) {
                    if(player in self) {
                        print "^", (The) RightWarrior, " slips on the ice but manages to keep his balance.^";
                    }
                }
            }
        ],
        before [;
        ListenRoom:
            "The continuous trickling and splashing of water flowing down the slick stone floor echoes
            wetly off the narrow tunnel walls.";
        SmellRoom:
            "A cool, heavy dampness fills the air, saturated with the strong, metallic odour of wet
            subterranean rock and stagnant mud.";
        Shout:
            if(LeftWarrior in location || RightWarrior in location)
                "The animated statue snaps its head toward you, its stone joints grinding together,
                but it says nothing.";
            "Your voice rings down the slick, muddy tunnel, echoing off the damp rock before
            swallowing itself in the darkness below.";
        ],
        react_before_magic [spell obj phase;
            spell = phase; ! avoid compiler warnings
            if(obj == Statues)
                "They stand as a pair, but you'll have to deal with the left or the right one individually.";
        ],
        u_to [; return UpSlope(MountainHall); ],
        s_to [; return UpSlope(MountainHall); ],
        !s_to "The slope behind you is far too steep and far too slippery to climb back up.",
        d_to [; return DownSlope(DragonHall); ],
        n_to [; return DownSlope(DragonHall); ],
        cant_go "Rough cavern walls block that way, dripping with moisture.",
    ;

Object -> ms_floor "floor"
    with
        name 'floor',
        description
            "What was once dressed stone is buried under a sliding layer of wet mud. There is
            not a square foot of it you could stand on with any confidence.",
   has scenery;

Object -> ms_water "mud"
    with
        short_name [;
            if(FlagIsSet(F_TUNNEL_FROZEN))
                 print "frozen mud";
            else print "wet mud";
            rtrue;
        ],
        parse_name [ w n;
            ClearFlag(F_MUD_CALLED_WATER); ! if we parsed water, else mud
            w = NextWordStopped();
            if(w == 'frozen' or 'wet') { w = NextWordStopped(); n++; }
            if(w == 'water' or 'ice') { SetFlag(F_MUD_CALLED_WATER); return n + 1; }
            if(w == 'mud' or 'ground' or 'mire' or 'paste') return n + 1;
            return n;
        ],
        description [;
            if(FlagIsSet(F_TUNNEL_FROZEN))
                "The mud is frozen solid and covered with ice.";
            if(FlagIsSet(F_MUD_CALLED_WATER))
                "A thin trickle of cold spring water runs constantly down the stone incline,
                turning the cavern floor into a slippery mire.";
            "Grey, glutinous and ankle-deep in the hollows, worked to a slick paste by the
            water running through it. Your boots have no purchase in it whatsoever.";
        ],
        before [;
        Drink, Taste: "A handful yields nothing but cold, slimy mud. You think better of tasting it.";
        ],
        domagic [spell;
            if(spell==FreezeSpell) {
                if(FlagIsSet(F_TUNNEL_FROZEN)) {
                    print "Nothing happens. The ground is still frozen.^";
                    Tunnel.time_left=10;
                } else {
                    SetFlag(F_TUNNEL_FROZEN); ! frozen mud
                    print
                        "The temperature drops at once. The water and the mud freeze hard, your boots go
                        out from under you, and you slither a couple of metres down the tunnel before
                        you can stop yourself.^";
                    StartTimer(Tunnel, 10);
                }
                rtrue;
            }
            rfalse;
        ],
    has scenery concealed;

Object -> Statues "statues"
    with
        name 'statues' 'warriors',
        before [;
            "They stand as a pair, but you'll have to deal with the left or the right one individually.";
        ],
    has pluralname scenery;

Object -> LeftStatue "warrior statue"
    with
        name 'warrior' 'left' 'statue',
        number 0,
        description
            "Cut from the same grey rock as the tunnel itself, a broad-shouldered warrior
            stands with a broadsword held point-down before him. The work is crude, but the
            face is startlingly alive, caught somewhere between boredom and bad temper.",
        domagic [spell;
            if(spell==AnimateSpell) {
                print "The statue comes to life!^";
                LeftWarrior.number=10; StartDaemon(LeftWarrior);
                ReplaceObj(self, LeftWarrior);
                rtrue;
            }
            rfalse;
        ],
        life [;
        default: "The stone warrior stands motionless, its cold gaze staring blankly into the dark.";
        ],
        before [;
        ShoutAt: "You raise your voice to the figure, but stone has no ears.";
        Touch: "The stone is cold, wet and utterly inert under your fingers.";
        Push, PushDir:
            "It does not shift so much as a hair. The statue and the mountain appear to be
            the same piece of rock.";
        TalkTo: return self.life();
        ],
        initial [;
            if(TestScope(RightStatue)) { print "Two statues guard the passage."; rtrue; }
            "A statue stands at the left wall, guarding the passage.";
        ],
    has static animate;

Object -> RightStatue "barbarian statue"
    with
        name 'barbarian' 'right' 'statue',
        description
            "The barbarian is all snarl and sinew, a battleaxe in his right hand and a long
            dagger in his left. Whoever carved him appears to have been working from an
            unpleasantly clear memory.",
        life [;
        Ask:
            "You put the question to a lump of carved rock, and a lump of carved rock
            is what answers you.";
        default: "The barbarian statue remains silent and stone-still.";
        ],
        before [;
        ShoutAt: "You raise your voice to the figure, but stone has no ears.";
        Touch: "The stone is cold, wet and utterly inert under your fingers.";
        Push, PushDir:
            "It does not shift so much as a hair. The statue and the mountain appear to be
            the same piece of rock.";
        TalkTo: return self.life();
        ],
        domagic [spell;
            if(spell==AnimateSpell) {
                print "The statue comes to life!^";
                RightWarrior.number=10; StartDaemon(RightWarrior);
                ReplaceObj(self, RightWarrior);
                rtrue;
            }
            rfalse;
        ],
        initial [;
            if(TestScope(LeftStatue)) rtrue;
            "A statue stands at the right wall, guarding the passage.";
        ],
    has static animate;

[ CommentWarriorAttackingMe warrior;
    print "^", (The) warrior, " attacks you", (string) random(
            ", and only your quick reflexes save you from an early death.",
            ". His blade sweeps at you, but at the last moment you manage to leap aside.",
            " and aims at your chest. You manage to pull back just in time."
        ), "^";
];

[ CommentWarriorAttackingWarrior;
    if(FlagIsSet(F_TUNNEL_FROZEN))
        "^The warrior and the barbarian trade blows across the frozen floor, and neither
        of them has landed one yet.";
    LeftStatue.number = LeftStatue.number + 1;
    if(LeftStatue.number == 2) {
        "^The warrior swings, the barbarian turns the blade on his dagger, and neither of them gives an inch.";
    }
    print "^", (The) LeftWarrior, " and ", (the) RightWarrior,
                " fight each other", (string) random(
            ". Their weapons clash, but both are still unharmed.",
            ", and their strength and skill seem evenly matched."
        ), "^";
];

Object LeftWarrior "warrior"
    with
        number -1,
        name 'left' 'statue' 'warrior',
        description
            "The statue is alive now. A large warrior stands before you swinging his
             broadsword. He seems to be looking for a suitable victim.",
        life [;
            if(RightWarrior in location)
                "The warrior is far too busy parrying the barbarian's dagger to answer you.";
            "The warrior is far too intent on taking your head off with his broadsword to engage in small talk!";
        ],
        before [;
        Touch, Attack, Push, PushDir, Pull, Take, Remove, Kiss:
            "Trying to handle a hostile stone construct directly is far too dangerous while he's
            trying to cut you down.";
        ShoutAt: "Your words mean nothing to the animated construct.";
        TalkTo: return self.life();
        ],
        daemon [;
            if(self.number>0) --self.number;
            ! don't allow turn into stone if both are alive
            if(RightWarrior in parent(self)) self.number = 1;
            if(self.number==0) {
                if(TestScope(self)) print (The) self, " turns back into a statue.^";
                ReplaceObj(self, LeftStatue);
                return;
            }
            if(parent(self)==parent(RightWarrior)) {
                if(TestScope(self)) CommentWarriorAttackingWarrior();
            } else {
                if(TestScope(self)) {
                    CommentWarriorAttackingMe(self);
                !} else {
                !    move self to location;
                !    print "^", (The) self, " charges at you with his sword raised.^";
                }
            }
        ],
    has animate;

Object RightWarrior "barbarian"
    with
        name 'right' 'statue' 'barbarian',
        number -1,
        description
            "The statue is alive now. A fierce barbarian stands before you swinging his
             axe. He seems to be looking for a suitable victim.",
        life [;
            if(LeftWarrior in location)
                "The barbarian is far too busy dodging broadsword swings to answer you.";
            "The barbarian is far too intent on stabbing you to engage in small talk!";
        ],
        before [;
        Touch, Attack, Push, PushDir, Pull, Take, Remove, Kiss:
            "Trying to handle a hostile stone construct directly is far too dangerous while he's
            trying to cut you down.";
        ShoutAt: "Your words mean nothing to the animated construct.";
        TalkTo: return self.life();
        ],
        daemon [;
            if(self.number>0) --self.number;
            ! don't allow turn into stone if both are alive
            if(LeftWarrior in parent(self)) self.number = 1;
            if(self.number==0) {
                if(TestScope(self)) print (The) self, " turns back into a statue.^";
                ReplaceObj(self, RightStatue);
                return;
            }
            if(parent(self)~=parent(LeftWarrior)) {
                if(TestScope(self)) {
                    CommentWarriorAttackingMe(self);
                !} else {
                !    move self to location;
                !    print "^", (The) self, " charges at you with his axe raised.^";
                }
            }
        ],
    has animate;

Room DragonHall "The Dragon Hall"
    with
        description [;
            if(self hasnt visited) StartDaemon(Dragon);
            ShowPicture(PIC_DRAGON);
            if(self hasnt visited) print "You slide to a stop"; else print "You are";
            " in a vast hall cut straight out of the heart of the
            mountain. The stench of sulfur is oppressive, and the floor lies under a layer
            of ash deep enough to say that no mortal has set foot here for centuries. The
            only way out is the treacherous, muddy incline behind you.";
        ],
        cheap_scenery
        CS_NO_ADJ 'hall'
            "Every surface of it was cut by hand: fluted columns, a vaulted roof lost in the
            dark, a floor of dressed slabs now buried under ash. Whoever built this did not
            build it for a dragon, and the dragon has outlasted them by a very long time."
        'sword' 'warrior'
            "The only thing that remains of the warrior is a smear of ash and a sword hilt."
        'sulfur' 'sulphur'
            "Thick, yellowish fumes drift near the vaulted ceiling, stinging your nostrils
            with the sharp stench of brimstone."
        'slope' 'incline'
            "A steep, slick chute of frozen mud leading back up into the dark tunnel. It looks
            far too slippery to climb without help."
        'eye' 'eyes'
            "Great lidded discs of amber, with a slot of black down the centre of each. They
            follow you without haste and without any particular effort, the way you might
            watch a fly cross a room."
        CS_NO_ADJ 'scales'
            "Overlapping plates of dark bronze, each the size of a dinner plate, dulled with
            ash and scarred along her flank where something long ago tried and failed."
        CS_NO_ADJ 'ash'
            "A deep layer of fine grey ash coats the chamber floor, drifting like snow under
            your boots and smelling faintly of long-dead fires.",
        before [;
#Iftrue (#version_number == 6);
        Picture:
            meta = true;
            ShowPicture(PIC_DRAGON);
            rtrue;
#Endif;
        Wait:
            if(Dragon.number>0)
                "You wait. The great ragged breaths are coming slower each time.";
            "You keep very still and wait.";
        ListenRoom:
            "A deep, rhythmic rumble travels up through the stone floor: the slow breathing
            of the beast. Every so often there is a soft metallic slither of coins as her
            great chest rises and settles again on the hoard.";
        SmellRoom: "The air is thick and suffocating, reeking of sulfur, singed stone, and bitter ash.";
        Pray:
            "You ask, without much hope, for the life of a creature you have no business
            saving. No answer comes. Whatever was listening in the temple by the sea does
            not reach down this far.";
        Shout:
            if(LeftWarrior in location || RightWarrior in location)
                "Your shout is instantly swallowed by the thunder of dragons' breath, and the mad
                battle cries of the two warriors. Nobody pays you the slightest bit of attention.";
            if(Dragon.number>0)
                "Your voice rings out across the hall, answered only by the crackle of
                burning ash and the dragon's heavy, ragged gasps for air.";
            "The dragon barely blinks, thoroughly unimpressed by your racket. If you actually want
            her attention, you had better address her directly.";
        ],
        u_to
            "The frozen mud is a sheet of glass tilted uphill. You would be back at the
            bottom before you had climbed ten feet.",
        !u_to [; return UpSlope(MountainSlope); ],
        !s_to [; return UpSlope(MountainSlope); ],
        cant_go "Solid rock walls block your path.";

Object -> CrematedBarbarian "barbarian's ashes"
    with
        name 'barbarian',
        description
            "A long smear of ash is all that is left of him. He did what he came down here to do.",
    has scenery;

Object -> Treasure "treasure"
    with
        name 'pile' 'heap' 'hoard' 'valuables' 'treasure' 'coins' 'coin' 'gems' 'gold' 'plates'
             'coin' 'plate' 'cups' 'crowns' 'cup' 'crown',
        description
            "Coins, plates, cups and crowns lie heaped in drifts across the floor, most of it
            tarnished black with age. A fortune, and not one piece of it worth your life.",
        before [;
        Take, Remove, Transfer:
            if(Dragon.number>0)
                "Even now, with her blood soaking into the ash, you find you cannot
                quite bring yourself to put a hand into a dragon's hoard.";
            if(TestScope(Dragon)) "You dare not even glance at the treasure while the
                                                        dragon guards it.";
            "Dragon gold brings no good.";
        Examine: rfalse;
        default:
            if(TestScope(Dragon)) "You dare not even glance at the treasure while the
                                                        dragon guards it.";
            rfalse;
        ],
    has scenery;

Object -> Wound "wound"
    with
        name 'wound',
        description [;
            if(Dragon.number>0)
                "The barbarian's axe went in deep at the base of her throat. Blood wells out of
                it in a slow, steady pulse, and the pulse is getting weaker.";
            "The dragon's wound is healed.";
        ],
        before [;
        Touch:
            "You press both palms against the hot scales and the blood comes through your
            fingers as though they were not there. This is far beyond anything you can do
            with your hands.";
        ],
        domagic [spell;
            if(spell == FreezeSpell)
                "Frost creeps across the scales around the axe and the flow slackens for a
                moment, and for that moment you think you have it. Then the cold reaches
                something deeper, the great body shudders, and you break the spell off yourself
                before you do her more harm than the barbarian did. Ice is not what she needs.";
        ],
    has scenery;

Object -> Axe "axe"
    with
        name 'axe' 'battleaxe',
        description
            "The barbarian's axe, buried to half its length under her jaw and moving
            slightly with each breath she takes. It is the only thing in this hall that is
            still doing exactly what it was made for.",
        before [;
        Pull, Push, PushDir:
            "You get both hands to the grip before you stop yourself. Draw it out and the
            bleeding will not slow; it will become a flood, and she will be gone before you
            have thought of anything better. Whatever you do for her, do it with the axe
            where it is.";
        ],
    has scenery;

Object -> Dragon "dragon"
    with
        name 'dragon' 'wyrm' 'serpent' 'wounded' 'shocked' 'she',
        number -1,                                                 ! time-out for the wounded state
        initial [;
            if(self.number>0) 
                "The colossal dragon lies coiled upon her hoard, dark blood glistening against her
                golden bed. Her breath comes in heavy, ragged huffs that stir the ash on the floor.";
            print "Sprawled across a staggering hoard of gold and priceless relics is a colossal dragon";
            if(DragonHall hasnt visited)
                print ".^^The dragon tilts her massive head, watching your sudden and undignified
                entrance with frank curiosity";
            ".";
        ],
        domagic [spell;
            if(spell == AnimateSpell)
                "Nothing happens, and nothing should. The animation spell is for things that have
                never lived. She is still very much alive, and that is the whole problem.";
            if(spell == IlluminateSpell)
                "A soft light gathers along her flank, and by it you can see exactly how much
                blood has gone into the ash. It is a great deal. You let the light go out again.";
            if(self.number<=0)
                print_ret (The) self, " stops you with a short spell, but looks amused.";
            if(spell==HealSpell && FlagIsClear(F_DRAGON_HEALED)) {
                SetFlag(F_DRAGON_RECOVERING);
                SetFlag(F_DRAGON_HEALED);
                print "The blood stops flowing and the wound in her throat closes. The dragon
                            is still in shock, but you have saved her life.^";
                self.number=6;
                Achieved(TASK_HEALING_DRAGON);
                rtrue;
            } else {
                print_ret (The) self, " stops you with a short spell.";
            }
        ],
        description [;
            if(self.number>0) {
                if(FlagIsSet(F_DRAGON_RECOVERING)) {
                    "The dragon's wounds are healed, but she is still in shock.";
                }
                "The dragon's blood pours out through the wound in her throat, and you watch
                her grow weaker and weaker.";
            }
            "Whole again, she is magnificent and frankly terrifying: a long, deep-chested
            body of overlapping bronze scales, and a pair of eyes that consider you with
            perfect, unhurried intelligence.";
        ],
        before [;
        ShoutAt:
            if(LeftWarrior in location || RightWarrior in location)
                "You yell a warning, but the dragon doesn't need your help.";
            if(self.number>0)
                "You call out to her, but she only lets out a ragged, wheezing cough of smoke
                and embers. She is in too much agony to hear you.";
            "Screaming won't earn you her respect. You should try talking to her properly instead.";
        LookUnder:
            "Trying to look under a resting dragon seems like a fast way to get roasted.";
        TalkTo: 
            if(FlagIsSet(F_DRAGON_HEALED) && DeathSpell notin SpellBook) <<Ask Dragon self>>;
            "The dragon demands concise questions, not pleasantries.
            Try asking it about a particular subject.";
        Ride:
            "You get as far as thinking about it. She opens one eye, and you find that you
            have finished thinking about it.";
        Thanks:
            "The dragon inclines her enormous head. ~We are square, wizard. Do not make a
            habit of saving dragons. It gives us expectations.~";
        Attack:
            if(self.number>0)
                "She is dying where she lies, and you did not come all this way down to finish her off.";
            "This is a dragon we are talking about. Magic might work, but force... forget it!";
        ],
        life [w1 w2 c;
            Show:
                if(noun == SpellBook)
                    "She glances at the open page and away again, unimpressed. ~Books,~ she says
                    thickly. ~You people always did put a great deal of faith in books.~";
            Answer:
                "The great eye tracks you across the ash, but she has no breath to spare for an answer.";
            Order:
                "~I have not left this hall in four hundred years, and I shall not leave it to
                run an errand.~ She closes her eyes. ~Whatever is coming for you, wizard, you
                must go and meet it yourself.~";
            Ask, Tell:
                w1 = 0;
                w2 = 0;
                wn=consult_from; c=consult_words; if(c>0) w1=NextWord();
                if(w1=='the') { c=c-1; if(c>0) w1=NextWord(); }
                if(c>1) w2=NextWord();
                if(c>2) "What you cannot say in few words, probably isn't worth saying.";

                if(FlagIsSet(F_DRAGON_HEALED) && DeathSpell notin SpellBook) {
                    print
                        "The dragon focuses on you, and something like surprise crosses her face. ~A
                        wizard,~ she says. ~Yes, of course. It was your spell that closed my throat.~
                        She raises her head and looks you in the eye. ~You saved my life, wizard. In
                        return I shall give you the most precious thing I know.~^^
                        Your spellbook suddenly floats before you and opens itself.
                        A new spell is written on a blank page: the Death Spell.^";
                    move DeathSpell to SpellBook;
                    scope_modified = true;
                    Achieved(TASK_GETTING_DEATH_SPELL);
                    rtrue;
                }
                if(self.number>0) {
                    ! dragon is wounded
                    if(FlagIsClear(F_DRAGON_HEALED)) {
                        "The great eye tracks you across the ash, but she has no breath to spare for an answer.";
                    } else {
                        "The dragon mutters to herself: ~A human who saves my life. Helps a dragon.
                        Never heard of such a thing.~ She is still very far from herself.";
                    }
                } else {
                    ! dragon is healed
                    if(w1 == 'herself' or 'dragon')
                        "~I have been here since before the hall was cut, and I shall be here after it
                        falls in.~ She settles a little deeper into the coins. ~That is the whole of my
                        history, and I am fond of it.~";
                    if(w1 == 'name')
                        "~You may have the name the miners gave me, which was Trouble, or the one my
                        mother gave me, which you could not pronounce and would not survive hearing.~
                        Something moves behind her eyes that might be amusement.";
                    if(w1 == 'barbarian' or 'warrior')
                        "~He was quick, and he was brave, and he was in my hall with an axe.~ The huge
                        head turns towards the ash. ~I do not hold it against him. I would have done the
                        same in his place, and I did.~";
                    if(w1 == 'wound' or 'throat')
                        "She tips her head back and lets you see the unmarked scales under her jaw. ~Gone
                        as though it never happened. I have carried worse for a century because there
                        was no one to ask.~";
                    if(w1 == 'demon' or 'daemon') {
                        SetFlag(F_DONT_TRUST_ISTAR);
                        "~I know the smell of that kind,~ she says, and her lip draws back off a great
                        many teeth. ~Nothing of that sort has come down my tunnel, and nothing of that
                        sort would go back up it. Why do you ask, wizard? What have you been carrying?~";
                    }
                    if(w1 == 'way' or 'exit')
                        "~Up the mud, on your own legs? No.~ She does not trouble to look at the incline.
                        ~You came here by magic, wizard, one way or another. You will leave the same
                        way, or you will stay and keep me company, and I think you are in a hurry.~";
                    if((w1 == 'stone' or 'stones') || (w2 == 'stone' or 'stones')) {
                        SetFlag(F_DONT_TRUST_ISTAR);
                        "~Stones.~ She turns the word over. ~Cut stones, of four colours, that call to
                        one another across a great distance. Yes. They were made to open something, and
                        whatever they open was shut for a reason. I would think very hard about who is
                        asking you to collect them.~";
                    }
                    if(w1 == 'death' or 'spell')
                        "~It is a cruel gift, and I have given it to you anyway,~ she says. ~You will
                        know the moment it is needed. If you are fortunate, you never will.~";
                    if(w1 == 'istar' or 'mentor' or 'teacher') {
                        SetFlag(F_DONT_TRUST_ISTAR);
                        "~I do not know your teacher. But I have lived a long time, wizard, and I will
                        tell you this for nothing: when an old man asks a young one to fetch what he
                        will not fetch himself, it is worth asking why.~";
                    }
                    if(w1 == 'treasure' or 'gold')
                        "~Metal and stone,~ she rumbles softly, not shifting an inch. ~I lie upon it
                        because it stays dry and cold. Do not mistake my patience for generosity,
                        tiny creature.~";
                    if((w1 == 'god' or 'gods') || (w1 == 'old' && w2 == 'god' or 'gods'))
                        "The dragon is quiet for a long moment. ~We are old,~ she says at last. ~They are
                        older. My grandmothers went down into the deep rock to be out of their way, and
                        my grandmothers did not frighten easily.~";
                    "The dragon looks at you but says nothing. Perhaps you should change the subject.";
                }
        ],
        daemon [l r p;
            ! Dragon wounded timer
            if(self.number>0) {
                --self.number;
                if(self.number == 1 && FlagIsClear(F_DRAGON_HEALED)) {
                    print "^The dragon falls silent. Only the faintest movement of her flank shows that she is still alive.^";
                }
                if(self.number==0) {
                    if(FlagIsSet(F_DRAGON_RECOVERING)) {
                        if(TestScope(self)) {
                            print "^", (The) self, " pulls herself together and looks as strong and calm
                                        as before the attack.^";
                            ClearFlag(F_DRAGON_RECOVERING); !
                            self.number=-1;
                        }
                    } else {
                        ++self.number; ! don't let the dragon die/
! No, no time puzzles here
!                        if(TestScope(self))
!                            print "^", (The) self, " lifts her head and looks furious. She tries to
!                                        burn you, but aims badly and misses. Exhausted, she falls back down
!                                        and dies.^";
!                        ReplaceObj(self, DeadDragon);
                        rtrue;
                    }
                } else if(TestScope(self)) {
                    if(FlagIsSet(F_DRAGON_RECOVERING)) {
                        switch(self.number) {
                        5:
                            "^The dragon lies where she fell, flanks heaving, and does not seem to have noticed you at all yet.";
                        4:
                            "^The dragon shifts among the coins and tests her throat with one slow, careful swallow.";
                        3:
                            "^The dragon's breathing is steadier now, but her eyes are still glassy.";
                        2:
                            "^Some colour is returning to the great scaled throat.";
                        1:
                            "^The dragon draws one long, deep breath and holds it, as though testing whether it hurts.";
                        }
                    } else if(self.number > 1) {
                        print "^", (string) random(
                            "The dragon's breathing grows more ragged.",
                            "The dragon looks weaker.",
                            "The dragon is almost dead."), "^";
                    }
                }
            }
            ! Kill the animated statues
            l=LeftWarrior in parent(self); r=RightWarrior in parent(self);
            p=player in parent(self);
            if(l) RemoveObj(LeftWarrior);
            if(r) RemoveObj(RightWarrior);
            if(l==true && r==true) {
                remove Statues;
                ! scope_modified = true; ! taken care of by RemoveObj
                self.number=5; ! the dragon is wounded
            }
            if(l==true && r==true && p==true) {
                PlaySound(SND_DRAGON, 0);
                print "^", (The) LeftWarrior, " and ", (the) RightWarrior,
                    " see the dragon and rush forward with weapons
                    drawn. She takes the warrior first and he goes up like dry kindling, but the
                    barbarian is inside her guard before she can turn, and drives his axe deep
                    into her throat. Beside herself with rage and pain, she burns what is left of
                    the pair of them to ash.^";
            } else if((l==true || r==true) && p==true) {
                    if(l) print "^", (The) LeftWarrior;
                    else print "^", (The) RightWarrior;
                    PlaySound(SND_DRAGON, 0);
                    print " sees the dragon and rushes at her with weapon raised high. The dragon
                                quickly burns him to death and cremates the body.^";
            }
            !if((l==true || r==true) && p==false) {
            if((l==true || r==true) && location == Tunnel) {
                PlaySound(SND_DRAGON, 0);
                print "^You hear screams and the clash of weapons nearby. Then a warm gust of
                            air comes, and the screams suddenly fall silent.^";
            }
        ],
    has animate female;

