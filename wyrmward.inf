!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1
!% $LONG_DICT_FLAG_BUG=0
!% $ZCODE_COMPACT_GLOBALS=1

! The very first lines of the main source code file for a game can
! contain compiler options, like the lines above. -~S disables
! strict error checking. This is otherwise used in z5 and z8 games by
! default. While useful for debugging, it adds ~10 KB to the story file
! size and it makes the game slower.
! $OMIT_UNUSED_ROUTINES=1 makes the compiler remove all routines which
! aren't used. This can save some space.
! $ZCODE_LESS_DICT_DATA=1 removes an empty data byte for every dictionary word.
! $LONG_DICT_FLAG_BUG=0 enables a bug fix in Inform v6.42+, so plural flags
! on long words are heeded, e.g. 'transmogrifiers//p'.
! $ZCODE_COMPACT_GLOBALS=1 avoids reserving dynmem space for unused globals.

Constant Story            "Wyrmward";
Constant Headline     "^(c) 1996-2005, 2026 Johan Berntsson. Type ~help~ or ~h~ for instructions.^";

! Uncomment ONE of the two following lines, to show either time or score/turns
! Leaving both commented out makes the library bigger.
!Constant STATUSLINE_TIME; Statusline time;
Constant STATUSLINE_SCORE; Statusline score;

! Comment out to keep track of score
! The value is what will be shown as the score on statusline in z3
!Constant NO_SCORE = 0;

! Customize the statusline in z5+ (has no effect in z3)
!Constant OPTIONAL_SL_NO_SCORE;
!Constant OPTIONAL_SL_NO_MOVES;

! Uncomment to add optional features to PunyInform
!Constant DEBUG;
!Constant DIALECT_US; ! Affects OPTIONAL_LANGUAGE_NUMBER
!Constant CUSTOM_ABBREVIATIONS;
!Constant OPTIONAL_NO_ADD_TO_SCOPE;
!Constant CUSTOM_PLAYER_OBJECT = myPlayerObj;
!Constant OPTIONAL_NO_DARKNESS;
!Constant OPTIONAL_NON_FLASHING_STATUSLINE;
!Constant OPTIONAL_FULL_DIRECTIONS;
!Constant OPTIONAL_SHIP_DIRECTIONS;
!Constant OPTIONAL_ALLOW_WRITTEN_NUMBERS;
!Constant OPTIONAL_GUESS_MISSING_NOUN;
!Constant OPTIONAL_GUESS_KEY; ! Requires OPTIONAL_GUESS_MISSING_NOUN
Constant OPTIONAL_EXTENDED_METAVERBS;
Constant OPTIONAL_EXTENDED_VERBSET;
!Constant OPTIONAL_FLEXIBLE_INVENTORY;
Constant OPTIONAL_LANGUAGE_NUMBER;
!Constant OPTIONAL_LIST_TOGETHER;
!Constant OPTIONAL_PRINT_SCENERY_CONTENTS;
!Constant OPTIONAL_SCORED;
!Constant OPTIONAL_FULL_SCORE; ! Comment out NO_SCORE when uncommenting this
!Constant OPTIONAL_SIMPLE_DOORS;
!Constant OPTIONAL_MANUAL_SCOPE;
!Constant OPTIONAL_MANUAL_SCOPE_BOOST;
!Constant OPTIONAL_MANUAL_REACTIVE;
!Constant OPTIONAL_ORDERED_TIMERS;
!Constant OPTIONAL_PROVIDE_UNDO;
!Constant OPTIONAL_REACTIVE_PARSE_NAME;
!Constant RUNTIME_ERRORS = 0; ! 0, 1 or 2. 0 = smallest file, 2 = most info

! Define any library constants you need here, like MAX_SCORE, AMUSING_PROVIDED,
! MAX_CARRIED, SACK_OBJECT,    etc.

Constant MAX_SCORE = 50;
Constant INITIAL_LOCATION_VALUE = Meadow;
Constant SACK_OBJECT            = BackPack;
Constant CUSTOM_PLAYER_OBJECT   = PlayerObject;

Include "globals.h";

! Define your attributes, common properties and global variables here, if any

Constant max_no_memorized_spells 5;
Global     no_memorized_spells = 0;

! Define the entry point routines you need here, like Amusing, DarkToDark etc.

[ SceneryReply word1 word2 routine;
    default:
        routine = word1 = word2; ! getting rid of a compiler warning
        rfalse;
];

[ ParseNameYellowCloud _w _n;
    _w = NextWord();
    if(_w == 'yellow') { _n++; _w = NextWord(); }
    if(_w == 'cloud' or 'mist' or 'fog') return _n + 1;
    rfalse;
];

[ ParseNameSteppe _w _n;
    _w = NextWord();
    if(_w == 'boundless' or 'wind-swept') { _n++; _w = NextWord(); }
    if(_w == 'steppe' or 'landscape' or 'ground' or 'grass') return _n + 1;
    rfalse;
];

[ ParseNameCornFields _w _n;
    _w = NextWord();
    if(_w == 'corn') { _n++; _w = NextWord(); }
    if(_w == 'fields' or 'field' or 'cornfields' or 'cornfield') return _n + 1;
    rfalse;
];

! Uncomment to add PunyInform extensions
Include "ext_menu.h";
!Include "ext_flags.h";
!Include "ext_talk_menu.h"; ! Note: Also include ext_flags.h to allow use of flags
!Include "ext_quote_box.h";
Include "ext_cheap_scenery.h";

! Setup custom library messages
!Constant MSG_LOOK_BEFORE_ROOMNAME 1003;
![LibraryMessages p_msg p_arg_1 p_arg_2;
!        switch(p_msg) {
!        MSG_LOOK_BEFORE_ROOMNAME:
!        }
!        p_arg_1 = 0; p_arg_2 = 0; ! To avoid warnings
!];

Include "puny.h";

! Uncomment to add PunyInform extensions
!Include "ext_waittime.h";

#Iftrue (#version_number == 6);
Include ">ext_z6graphics.h";
Constant PIC_INTRO      = 1;
Constant PIC_DEMON      = 2;
Constant PIC_DRAGON     = 3;
Constant PIC_HUT        = 4;
Constant PIC_TELEPORT   = 5;
Constant PIC_CHURCH     = 6;
Constant PIC_WAVE       = 7;
Constant PIC_WOOD       = 8;
Constant PIC_VILLAGE    = 9;

[ ShowPicture p_num _rows _i _row;
    _rows = Z6PictureRows(p_num);
    if(_rows == 0) return;          ! no such picture: draw nothing, print nothing
     ! first scroll down so we're sure that the picture will fit without [MORE]
     for(_i=0: _i<_rows: _i++) new_line;  
     ! get the cursor row as a text row (NB: the raw Z6CursorRow is in units --
     ! pixels on sfrotz and Ozmoo - so use the Cell version here)
     _row = Z6CursorRowCell();
     Z6MoveCursorCell(_row - _rows, 1);
     Z6DrawPictureHere(p_num);
     Z6MoveCursorCell(_row, 1);
];

#Endif;

! ==========================================================================
!     The magic system: Enchanter/Sorcerer-style spells and scrolls.
! ==========================================================================

[ IsSpell; return (noun ofclass CSpell); ];

Verb 'cast'
    * noun=IsSpell                                                    -> CastSpell
    * noun=IsSpell 'at'/'on'/'upon' noun        -> CastSpellObj;
[ CastSpellSub;        if(noun ofclass CSpell) noun.activate(); else <<Drop noun>>; ];
[ CastSpellObjSub; if(noun ofclass CSpell) noun.activate(second); else <<ThrowAt noun second>>; ];

Verb 'memorize' 'memorise' 'learn' * noun -> Memorize;
[ MemorizeSub; "You should get yourself a notebook instead."; ];

Verb 'copy' * noun -> Copy;
Verb 'illuminate' * noun -> Illuminate;
[ CopySub; <<CastSpellObj CopySpell noun>>; ];
[ IlluminateSub; <<CastSpellObj IlluminateSpell noun>>; ];

!Verb 'animate'                                * noun -> MagicAnimate;
!Verb 'freeze'                                 * noun -> MagicFreeze;
!Verb 'heal'                                     * noun -> MagicHeal;
!Verb 'resurrect' 'revive'
!    * noun                                                         -> MagicResurrect
!    * noun 'from' 'the' 'dead'                 -> MagicResurrect;
!Verb 'teleport'                             *             -> MagicTeleport;

Object SpellBook "spellbook"
    with
        article "your",
        name 'your' 'spellbook' 'spell' 'book',
        description
            "It is your well-thumbed spellbook, bought on the day you started at the wizards'
            school. The spells written in it are the fruit of a great many years of study.",
        before [ a;
            Open, Close:
                "The book can read the thoughts of its owner, and so it will always show you
                 the information you need. There is therefore no need to open, close or leaf
                 through it. Many lives have been saved by this magical property.";
            Read:
                print "ARCANE MAGIC FOR COMPLETE NOVICES:^^";
                for(a=child(self): a~=nothing: a=sibling(a))
                    print (The) a, ": (", (string) a.comment, ").^";
                rtrue;
        ],
    has transparent;

Class CScroll
    ! A scroll that can hold a spell. This spell can be copied.
    with
        description [;
            if(child(self)==nothing) "The scroll is blank.";
            print "It reads ~", (name) child(self), ": ",
                        (string) (child(self)).comment, ".~^";
            rtrue;
        ],
        before [;
            Memorize:
                if(child(self) ofclass CSpell) <<Memorize (child(self))>>;
            Read:
                if(child(self)==nothing) "There is nothing written on the scroll.";
                if(child(self) ofclass CSpellWithArgument) {
                    <Examine self>;
                } else {
                    print "Do you want to read out the text on the scroll and cast the spell? ";
                    if(YesOrNo()) (child(self)).activate();
                    else <Examine self>;
                }
                rtrue;
        ]
    has transparent;

Class CComplicatedScroll
    ! A scroll whose spell cannot be copied.
    class CScroll
    with
        description [;
            if(child(self)==nothing) "The scroll is blank.";
            print "It reads ~", (name) child(self), ": ",
                        (string) (child(self)).comment, ".~ The spell is long and complicated.^";
            rtrue;
        ],
    ;

Class CSpell
    ! A general spell (no argument).
    with
        number 0, ! number of memorized copies of this spell
        description [;
            print "The spell reads ~", (name) self, ": ", (string) self.comment, ".~^";
            rtrue;
        ],
        before [;
            Memorize:
                if(parent(self)~=SpellBook) {
                    print "You can only memorize spells written in ", (the) SpellBook, ".^";
                    rtrue;
                }
                if(GrabObject(SpellBook)) {
                    print "You must be holding ", (the) SpellBook, " first.^";
                    rfalse;
                }
                if(self.number>no_memorized_spells) self.number=0;
                if(no_memorized_spells>=max_no_memorized_spells) {
                    print "You have already studied so much that you cannot learn any more
                                 spells. The words slip out of your memory as fast as you cram
                                 them in.^";
                    rtrue;
                }
                print "You concentrate and memorize ", (the) self;
                if(self.number==0) print ".^";
                else print " once more.^";
                ++no_memorized_spells;
                ++self.number;
                rtrue;
        ],
        activate [obj;
            if(player has general)
                "Your webbed fingers are far too clumsy to turn the fragile pages of your spellbook,
                and your altered throat cannot pronounce the precise incantation. You must return
                to your human form before you can cast magic again.";
            if(self.number>no_memorized_spells) self.number=0;
            if(parent(self) ofclass CScroll) {
                if(TestScope(parent(self))==false) "There is no ", (name) self, " here.";
                print "You read aloud the complicated words of ", (the) self, ".^^";
            } else if(self.number>0) {
                --self.number;
            } else {
                if(GrabObject(SpellBook)) {
                    print "You must be holding ", (the) SpellBook, " first.^";
                    rfalse;
                }
                if(parent(self)~=SpellBook) {
                    print "You cannot find ", (the) self, " in ", (the) SpellBook, ".^";
                    rfalse;
                }
!print (the) self, " ", (the) second, "^";
                if(parent(player) provides react_before_magic)
                    if((parent(player)).react_before_magic(self, obj, 0)) rtrue;

                if(self == CopySpell) {
                } else if(self == FreezeSpell) {
                } else if(self == TeleportSpell) {
                    print "Your spellbook snaps open to the correct page, and you speak the complex, resonant
                        incantation of the teleportation spell.^^";
                } else {
                    print (The) SpellBook, " opens itself to the right page, and you read
                            aloud the complicated words of ", (the) self, ".^^";
                }
            }
            if(parent(player) provides react_before_magic)
                if((parent(player)).react_before_magic(self, obj, 1)) rtrue;
            return self.domagic(obj, 1);
        ]
    ;

Class CSpellWithArgument
    ! A spell that needs a target.
    class CSpell
    with
        activate [obj;
            if(obj==0) {
                print "You must say what you want to cast the spell on.^";
                rfalse;
            }
            return self.CSpell::activate(obj);
        ]
    ;

CSpellWithArgument IlluminateSpell "illumination spell" SpellBook
    with
        name 'illumination' 'illuminate' 'spell',
        comment "make something glow",
        domagic [obj;
            if(obj provides domagic) if(obj.domagic(self)) rtrue;
            if(obj ofclass CSpell || obj has scenery || obj has static) {
                print "You cannot cast ", (the) self, " on ", (a) obj, ".^";
                rfalse;
            }
            if(self has light) print_ret (The) obj, " is already shining brightly.";
            give obj light;
            "A dazzling light suddenly bursts from ", (the) obj,
            " and it begins to glow! The light soon dims to a more bearable level,
            and ", (the) obj, " is now a perfectly good light source.";
        ]
    ;

CSpellWithArgument CopySpell "copying spell" SpellBook
    with
        name 'copying' 'copy' 'spell',
        comment "copy a spell into the spellbook",
        domagic [obj x;
            if(parent(obj) ofclass CScroll) obj=parent(obj);
            if(obj ofclass CScroll) {
                x=child(obj);
                if(x==nothing) { print "There is no spell on ", (the) obj, ".^"; rfalse; }
            } else {
                x=obj;
            }
            if(x ofclass CSpell) ; else {
                print "You cannot copy ", (a) x, " into ", (the) SpellBook, ".^";
                rfalse;
            }
            ! obj is now the scroll (if any) or the spell; x is always the spell.
            if(obj ofclass CComplicatedScroll) {
                if(x == ResurrectSpell)
                    "The spellbook begins to glow. It strains at the task, drawing on every scrap of
                    power it has, but the resurrection spell is simply too long, too intricate and
                    too strong to be lifted off the page. The glow dies away. Luckily the scroll
                    itself is unharmed, so you will have to read the spell straight from it.";
                print_ret (The) SpellBook, " begins to glow. Summoning all the power it has,
                ", (the) self, " tries to copy ", (the) x, " into your book, but the spell
                is far too long, complicated and powerful. The glow dies away, but luckily
                ", (the) x, " is unharmed.";
            }
            switch(x) {
            AnimateSpell:
                print
                    "The spellbook opens itself to the correct page, and you speak the complex, resonant incantation of
                    the copying spell.^^A warm, golden radiance bursts from the pages. Slowly and majestically, the glowing
                    runes of the Animation Spell etch themselves onto a blank leaf of parchment. As the light fades, the
                    original scroll crumbles into a fine silver ash that vanishes into thin air.";
                move x to Spellbook;
                remove obj;
            TeleportSpell:
                print
                    "The spellbook opens once more, and you recite the copying spell over the silvery scroll.^^
                    The pages flare with a blinding light. The intricate symbols of the Teleportation Spell bind
                    themselves permanently into your grimoire, while the silvery parchment dissolves into wisps
                    of shimmering smoke.";
                move x to Spellbook;
                remove obj;
            default:
                print (The) SpellBook, " begins to glow. Slowly and majestically the words of ",
                            (the) x, " appear on a blank page, shining more brightly than the book
                            itself. The light fades, but the spell remains!";
                move x to SpellBook;
                if(obj ofclass CScroll) {
                    print " The scroll it was written on goes up in smoke as the copying finishes.";
                    remove obj;
                }
            }
            "^[You have learned ", (the) x, "]";
        ]
    ;

! ==========================================================================
!     Custom verbs / grammar for the game
! ==========================================================================

Verb 'accuse'
    * creature -> Accuse;
[ AccuseSub; "Accusations achieve nothing without evidence."; ];

Verb 'shake'
    * noun -> Shake;
[ ShakeSub; "That would achieve nothing."; ];

Verb 'talk' 'report'
    * 'to' noun -> TalkTo;
[ TalkToSub;
    print_ret (The) noun, " doesn't seem interested.";
];

!Extend only 'read' replace * noun -> Read;
Extend 'read' first * noun -> Read;
[ ReadSub; <<Examine noun>>; ];

! special for hawker
Extend 'give' last
    * 'coin' 'to' creature -> GiveNoCoin;
[ GiveNoCoinSub; "You can't see any coin here,"; ];

Extend 'look'
    * 'under' noun -> LookUnder
    * 'through' noun -> LookThrough;
[ LookUnderSub; "There's nothing special there."; ];
[ LookThroughSub; "You can't see through that."; ];

Verb 'point'                                    * 'at' noun -> PointAt;
[ PointAtSub; "You point. Nothing happens."; ];
Verb 'follow' * noun -> Follow;
[ FollowSub; "That isn't something you can follow. Try choosing a direction to move instead."; ];

Extend 'wake'
    * noun 'from' 'the' 'dead'                    -> MagicResurrect
    * 'up' noun 'from' 'the' 'dead'         -> MagicResurrect;
Extend 'give'
    * noun 'new' 'life'                                 -> MagicResurrect
    * noun 'life'                                             -> MagicResurrect
    * 'life' 'to' noun                                    -> MagicResurrect;

!Extend 'kill' first * creature -> MagicKill;
Extend 'touch'
    * noun 'with' noun -> Touch
    * noun -> Touch;
Extend only 'hit' 'break' 'smash' replace
    * noun 'with' held -> AttackWith
    * noun -> Attack;

Verb 'time' 'date' * -> Time;

Verb 'thank' 'thanks'
    * creature -> Thanks
    * 'you' creature -> Thanks
    * -> Thanks
    * 'you' -> Thanks;
[ ThanksSub; "You offer a polite word of thanks, though it vanishes quietly into the surrounding silence."; ];

![ MagicAnimateSub;     AnimateSpell.activate(noun); ];
![ MagicFreezeSub;        FreezeSpell.activate(noun); ];
![ MagicHealSub;            HealSpell.activate(noun); ];
[ MagicResurrectSub; ResurrectSpell.activate(noun); ];
![ MagicTeleportSub;    TeleportSpell.activate(); ];
![ MagicKillSub;
!    if(KillSpell in SpellBook) KillSpell.activate(noun);
!    else <Attack noun>; ];
[ AttackWithSub;
    if(second==Amulet) <<ThrowAt second noun>>;
    else <<Attack noun>>; ];
[ TimeSub;
    switch(the_time/60) {
        22, 23, 0, 1, 2, 3:            "It is night.";
        4, 5, 6:                                 "It is early morning.";
        7, 8, 9, 10, 11:                 "It is late morning.";
        12, 13, 14, 15, 16, 17:    "It is afternoon.";
        18, 19, 20, 21:                    "It is evening.";
    }
];

Verb 'xyzzy' * -> Xyzzy;
[ XyzzySub;
    "You pronounce the ancient word with great care. Somewhere very far away a door
    seems to swing open. Nothing whatsoever happens here.";
];

Verb 'knock' * 'on' noun -> Knock;
[ KnockSub;
    "There is no response.";
];

#IfDef DEBUG;
Verb 'cheat' * -> Cheat;
[ CheatSub;
    move AnimateSpell to spellbook;
    move TeleportSpell to spellbook;
    PlayerTo(TeleportRoom);
];
#Endif;

Verb 'help' 'hint' 'hints' 'info' 'about' 'credits' 'h//' * -> Help;

Object PlayerObject "yourself"
    with
        number 0,
        before NULL, after NULL, life NULL, each_turn NULL,
        time_out NULL, describe NULL,
        capacity 100,
        parse_name 0, orders 0,
        name 'me' 'myself' 'self',
        description [;
            if(self has general)
                "You look down at your hands which are now pale, scaled, and webbed. A sharp, dorsal fin has
                ripped through the back of your robe. Strangely, your lungs feel eager for the sea air.";
            "As good-looking as ever, though weeks on the road have left your travelling
            robes mud-spattered and your boots very nearly walked through.";
        ],
        domagic [spell;
            switch(spell) {
            HealSpell:
                "You feel healthier and stronger than before.";
            FreezeSpell:
                "Suddenly you are covered by a thin layer of ice. It is very cold and
                unpleasant, but the ice melts quickly.";
            IlluminateSpell:
                give player light;
                "A dazzling light surrounds you and you begin to glow. The light slowly
                fades, but you are now a perfectly adequate light source.";
            AnimateSpell:
                "Strangely, you notice no great difference. You are just as alive as before.";
            ResurrectSpell:
                "This is a spell for raising the dead. Since you are not dead (yet), nothing
                happens.";
            KillSpell:
                deadflag=1; "Suddenly you cease to exist.";
            }
        ],
    has concealed animate proper transparent;     ! 'general' when fish-like

! ==========================================================================
!     Useful parser / helper routines
! ==========================================================================

[ IsCarried obj; return IsObjInContainer(obj, player); ];

[ IsHeld obj; if(obj in player) rtrue; rfalse; ];

[ GrabObject obj;
    ! Silently ready an object for use (hold it). false if ok, true if impossible.
    if(IsHeld(obj)) rfalse;
    keep_silent=1;
    <Take obj>;
    keep_silent=0;
    if(IsHeld(obj)) rfalse;
    rtrue;
];

[ RemoveObj obj notstop;
    if(notstop==0) { StopDaemon(obj); StopTimer(obj); }
    remove obj;
];

[ ReplaceObj cur_obj new_obj notstop;
    if(notstop==0) { StopDaemon(cur_obj); StopTimer(cur_obj); }
    move new_obj to parent(cur_obj);
    remove cur_obj;
];

[ IsObjInContainer obj container;
    for(:parent(obj)~=container:obj=parent(obj))
        if(parent(obj)==nothing) rfalse;
    rtrue;
];

[ NumberOfNewStones i total;
    total=0;
    for(i=0: i<WantedStones-->0: ++i) {
        if((WantedStones-->(i*2+1)==0) && TestScope(WantedStones-->(i*2+2), player)) {
            WantedStones-->(i*2+1)=1;
            ++total;
        }
    }
    return total;
];

! ==========================================================================
!     Rooms and their contents
! ==========================================================================

Class Room
    has light;

Room Meadow "Meadow"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_HUT);
#Endif;
            "You stand in a small, overgrown clearing dominated by a dilapidated hut hunched
            immediately to the south. Looming on all other sides is a dense, ancient forest
            whose twisted boughs form an impenetrable wall of shadow. A faint dirt path cuts
            through the weeds, winding away north into the dark tree line.";
        ],
        cheap_scenery
            'damp' 'grass'
            "The grass is thick, wild, and heavy with a cold, clinging dew that quickly soaks through the
            hems of your travelling robes."
            CS_NO_ADJ 'chimney'
            "A crooked stack of unmortared field stones, leaning with the rest of the hut.
            Whatever is burning inside sends up a smoke that is not quite the colour of
            woodsmoke."
            CS_NO_ADJ 'smoke'
            "It rises in a thin grey thread, and there is something under the woodsmoke that
            catches at the back of your throat. Your mentor is clearly still working."
            'thatched' 'roof'
            "Sagging thatch under a deep pelt of moss, patched here and there with turf. It
            has not been rethatched in your lifetime, and probably not in his."
            'weed' 'weeds'
            "Nettles, dock and rank meadow grass, grown waist-high right up to the walls of
            the hut. Nobody has taken a scythe to this clearing in years."
            CS_NO_ADJ 'sky'
            "Overhead, the sky is a bruised, oppressive grey, visible only through a jagged tear in the
            dense forest canopy.",
        before [;
        Listen:
            "The wind rustles softly through the high grass and the heavy canopy overhead.
            Deeper in the trees a lone bird calls out, and then thinks better of it. The
            forest is unsettlingly still.";
        Smell:
            "Wet earth, crushed weeds, and the sharp resin of pine needles drifting out of
            the dark forest. From the south, a faint whiff of woodsmoke hangs about the hut.";
        ],
        in_to RemoteHut, s_to RemoteHut,
        n_to [;
            if(TeleportSpell in SpellBook)
                "That winding dirt track is the way you arrived on foot. Trudging all the way back would take weeks
                you simply don't have. Istar gave you the teleportation spell for a reason!";
            "That dirt track is the way you arrived, and there is nothing back down it but weeks of hard walking.
            You did not come all this distance to turn around on the doorstep.";
        ],
        u_to
            "You jump, get a handful of cold air for your trouble, and come down again.
            Flying is well beyond your current magical abilities!",
        d_to
            "You prod at the grass and weeds beneath your boots. There is nothing under them
            but more meadow.",
        cant_go
            "You push into the tree line, but the brambles close ranks and the boughs knit
            together above them. The forest will not let you pass.";

Object -> HutDoor "door"
    with
        name 'door' 'planks',
        description [;
            "The hut's door is made of thick, weather-beaten planks of dark pine, bound by rusting iron bands.";
        ],
        before [;
        Knock:
            "You rap your knuckles against the planks. From inside comes a shuffle of feet
            and the scrape of a stool being pushed back, but nobody comes to answer.";
        Open, Close:
            "The door already hangs ajar in its warped frame; it has not shut properly in
            years. You need only push it aside and step through.";
        ],
    has scenery;

Object -> Path "path"
    with
        name 'dirt' 'path',
        description
            "It's little more than a strip of packed, muddy earth cutting through the overgrown grass.
            Looking north, you can see how quickly the path is swallowed up by the encroaching shadows
             of the forest canopy.",
        before [;
        Enter:
            "The path only leads north, back the way you came. Whatever your old teacher
            wants of you is waiting inside the hut to the south.";
        Follow:
            "You have already followed it for three weeks. It goes north, and north is where
            you came from. Whatever your old teacher wants of you is inside the hut.";
        ],
    has scenery;

Object -> Hut "hut"
    with
        name 'hut' 'dilapidated',
        description
            "The structure is a sorry sight. Built from rough-hewn logs that have rotted and warped over the years,
            it leans heavily to one side as if weary from the elements. Thick, dark moss carpets the sagging
            thatch roof, and a thin wisp of acrid smoke curls sleepily from a crude stone chimney.",
        before [;
            Enter: <<Go FAKE_S_OBJ>>;
        ],
    has scenery concealed;

CScroll -> DirtyScroll "weathered scroll"
    with
        name 'weathered' 'discarded' 'dirty' 'scroll' 'parchment',
        initial
            "Nestled deep in the damp grass, a flash of parchment catches your eye.
            It appears to be a discarded scroll.",
        description [;
            if(self has general)
                "The parchment is unrolled now, its surface stained by the acrid fumes of Istar's mixture. Inscribed
                across the centre in sharp, shimmering ink are the ancient runes of an animation spell (used to bring
                inanimate objects to life).";
            if(self has open)
                "The scroll is completely blank. Either somebody went to considerable trouble to tie up an empty page,
                or there is a deeper meaning being hidden away.";
           "It is a tightly rolled cylinder of heavy parchment, tied with a frayed piece of
            twine. The surface is weathered, as if it has been lying out in the damp meadow
            air for some time.";
        ],
        before [;
        Read:
            if(self has general) <<Examine self>>;
            give self open;
            "You unroll the parchment far enough to look. The sheet is blank, top to bottom.
            Either somebody went to considerable trouble to tie up an empty page, or there
            is something written here that does not care to be read by just anyone.";
        ],
        add_to_scope Twine,
    has openable;

Object Twine "twine"
    with
        name 'frayed' 'piece' 'of' 'twine',
        description
            "A few turns of coarse hemp twine, frayed at the ends and stiff with damp. It has
            been tied and untied a good many times.",
        before [;
        Open, Unlock:
            give DirtyScroll open;
            "You pull at the twine and open the scroll.";
        ],
    has openable scenery;

Room RemoteHut "Hut"
    with
        description [;
            "The interior of the hut is cramped and gloomy. Thick soot cakes the solitary window,
            leaving the flickering flames of a stone hearth as the room's sole source of light. Atop
            the fire, rusted iron vessels bubble quietly, venting strange, multi-coloured vapours. A
            massive, cluttered workbench is buried under a chaotic heap of heavy grimoires, brittle
            parchments, and exotic alchemical ingredients. A heavy wooden door leads north, back out
            to the forest path.";
        ],
        before [;
        Listen:
            "The fire in the hearth crackles softly, accompanied by the gentle, steady bubbling of the iron vessels
            and the crisp rustle of parchment as Istar turns a page.";
        Smell:
            "The room is thick with the sharp tang of sulfur, burnt wood smoke, and the pungent, bitter aroma of
            strange alchemical vapours mingling with aged leather and dry parchment.";
        ],
        cheap_scenery
            'solidary' 'window'
            "Thick layers of black grease and soot coat the glass, completely choking out the daylight
            from the meadow outside."
            CS_NO_ADJ 'ingredients'
            "Bundled herbs, stoppered jars, a tray of dried beetles and something in brine
            that you decide not to look at twice. Half the labels are in your mentor's hand
            and the other half in no alphabet you know."
            CS_NO_ADJ 'alcove'
            "A shallow niche cut into the stone of the chimney breast, just deep enough to
            take the gilded box. The rock around it is scorched black, as though the ward on
            the box has had to defend itself more than once."
            'hearth' 'fireplace'
            "A low arch of blackened fieldstone, heaped with logs that burn a great deal
            hotter than logs ought to. Stained iron cauldrons and glass retorts stand in the
            flames, hissing and sputtering away.",
        n_to Meadow, out_to Meadow,
        u_to "The low, thatched ceiling offers no way upward, unless you fancy poking your head through the dried reed roof.",
        d_to "The floorboards are solid, worn oak. There are no trapdoors or cellars beneath your feet.",
        cant_go "You bump straight into the hut's sturdy timber walls, cluttered with dusty shelves of strange ingredients.
            The only way out is back through the doorway to the north.";

Object -> hut_vessel "vessels"
    with
        name 'iron' 'vessels' 'vessel',
        description
            "The liquids inside the vessels range from a viscous, glowing emerald to an oily indigo,
            giving off a scent that prickles the back of your throat.",
        before [;
        Eat, Drink, Taste:
            "You lean over the nearest cauldron and think better of it at once. Whatever is
            bubbling in there was never meant to go anywhere near a mouth.";
        ],
    has scenery pluralname;

Object -> hut_bench "work bench"
    with
        name 'workbench' 'bench',
        description [;
            print
                "A massive slab of scarred oak that has survived a great many experiments,
                though not without marks. ";
            if(hut_doc in self && children(self)==1) "Books and parchments lie on the bench.";
            print "On the bench you see ";
            if(PrintContents(0, self)==false) print "nothing";
            print ".";
        ],
    has scenery supporter;

Object -> -> hut_doc "books"
    with
        name 'books' 'book' 'parchment' 'parchments',
        description
            "Warped grimoires and loose sheaves of parchment, most of them older than the hut
            itself. Every margin is crowded with your mentor's cramped, urgent handwriting.",
            !The most interesting ones are about dragons and
            !their magic, but they are strictly theoretical and of little use to you.",
        before [;
            Transfer, Take, Remove:
                if(TestScope(Istar)) "~Don't touch the books. I need them,~ says Istar.";
        ],
        after [; Take, Remove: give self ~concealed; ],
    has concealed pluralname;

Object -> GoldBox "gilded box"
    with
        name 'gilded' 'gold' 'golden' 'box' 'wooden' 'magic' 'magical',
        initial [;
            print 
                "Resting within a small alcove in the stone wall is a beautifully carved, gilded wooden box";
            if(children(self)>0) { print ". It contains "; PrintContents(0, self); }
            print ".^";
        ],
        description [;
            print "The box is crafted from a rare, dark wood, seamlessly overlaid with an intricate, swirling filigree
                  of pure gold. Professional wizards use enchanted repositories like this to store highly volatile
                  magical items.^";
            if(children(self)>0) { print "^In the box is "; PrintContents(0, self); print ".^"; }
        ],
        before [;
            Open, Close: 
                "The box has no lock to speak of, but it is sealed by a potent ward. Only its
                true owner, Istar, can safely open and close it.";
            Transfer, Take, Remove, LetGo:
                if(TestScope(Istar))
                    "You reach for it, but a sharp, static shock bites at your fingers, forcing you to pull back.
                   The box is anchored to the alcove by powerful protective spells designed to prevent theft
                   and ward off damage.";
            Receive:
                if((noun ofclass CStone)==false)
                    "The golden filigree brightens as you reach inside, and the ward pushes your hand
                    gently but very firmly out again. The box stands open for the artefacts Istar is
                    hunting, and for nothing else. It has no interest in your luggage.";
        ],
        after [;
            Receive:
                if(children(self)==WantedStones-->0 && TestScope(Istar)) {
                    print "Your mentor sees you place the last stone in the box and cries,
                     ~The last stone! Now I can open the gate!~^^\
                    He takes the stones from the box and says, ~Come with me, great tasks
                    await.~ Everything suddenly turns yellow as he reads a teleportation spell,
                    and you are carried away to another place.^^";
                    StartDaemon(EvilMaster);
                    PlayerTo(GateRoom);
                    rtrue;
                }
        ],
    has container open;

Object -> Istar "Istar"
    with
        name 'master' 'mentor' 'teacher' 'old' 'wizard' 'istar',
        domagic [spell;
            if(spell==KillSpell) rfalse;
            print (The) self, " stops the spell with a wave of his hand.
                  ~What foolishness are you up to? Pick on someone your own size.~^";
            rtrue;
        ],
        initial [;
            if(Introduction in self) {
                move Introduction to player;
                "Your old mentor, Istar, is hunched over the workbench, intently poring over a faded tome.
                When he sees you he says, ~My boy, I am so glad to see you again. Great tasks await us, but
                to begin with, I need you to read this.~ He picks up a slim, leather-bound folio and presses
                it into your hands. ~It is the culmination of everything I have uncovered since my exile.~";
            }
            print (string) random(
                "Your mentor reads a parchment.",
                "Your mentor checks the contents of one of the beakers.",
                "Your mentor ponders something."), "^";
        ],
        react_after [;
            Go:
                switch(NumberOfNewStones()) {
                0: rfalse;
                1: print "As you enter the hut your old mentor says, ~I see you have found a
                         new stone. Well done. Put it in the gilded box.~^^";
                default: print "As you enter the hut your old mentor says, ~I see you have
                               found more stones. Very good. If you keep up this pace we shall
                               soon be done. Put the stones in the gilded box.~^^";
                }
                rfalse;
        ],
        description [;
            "Time has not been kind to your old teacher. His once-proud silver beard is
            tangled and stained with potion ingredients, and deep lines of exhaustion are
            etched into his face. Yet as he looks up at you, the familiar, brilliant spark
            of intellect still dances in his eyes.";
        ],
        life [;
            Order:
                "~I would only slow you down, my boy, and there are eyes on this hut that I would
                rather not lead across half the world. You go. I shall keep the box ready.~";
            Ask:
                if(second ofclass CStone) second='stone';
                switch(second) {
                    'gate':
                        "~A door,~ he says, ~and on the other side of it, light. Nothing more than that,
                        and nothing less. Read the folio, my boy, and stop making me say aloud what I
                        have already written down properly.~";
                    'himself', 'istar', Istar:
                        "He waves a hand at the crooked walls, the smoking cauldrons, the mouldering
                        thatch. ~You see what I have come to. Fifty years at the Academy, and this is
                        what they let me keep. Still, the roof holds. Mostly.~";
                'academy':
                    "His face darkens. ~The Arch-Mages felt something stirring in the dark and
                    decided it must be me. I do not blame them for being frightened, my boy. I blame
                    them for being lazy about it.~";
                'summary', 'paper', 'report', Introduction:
                    "~It is a long story and I have no time to tell it again. Read what I
                    wrote instead.~";
                'stone', 'stones':
                    "He taps the folio in your hands. ~Elemental stones. Four of them, cut long
                    before the first cities were built. I have one. The others lie scattered across
                    half the world, and I am too old and too closely watched to go after them
                    myself.~";
                'magic', 'spell', 'spells':
                    "~You ought to know what magic is by now. But remember that there are
                    several kinds of magic. Lately I have tried to explore the mighty magic
                    that demons and dragons use. That, of course, is why my colleagues turned
                    against me. They are jealous and afraid.~";
                'white', 'gate':
                     "~The only way I know of to stop the return of the Old Gods is to open the
                     gate to another dimension, where we can draw on white magic. I know how to
                     find the gate, but I need the stones to open it. I cannot leave the hut, so
                     it is up to you to save us all.~";
                'black', 'old', 'gods':
                     "~I have studied black magic for a long time, and I can tell you that its
                     power is dangerous and mighty. It seems to stem from beings that once lived
                     on earth, commonly called the Old Gods. I fear they will soon return, and
                     that they will crush us like insects unless we manage to stop them.~";
                'potions', 'liquids', 'ingredients':
                     "~Touch nothing. I am in the middle of an experiment.~";
                'demon', 'demons':
                    "Istar looks up, honestly puzzled. ~A demon? My boy, if there were a demon within
                    a hundred leagues of this hut, I should certainly have noticed.~";
                'dragons', 'dragon', Dragon:
                    "~Yes, dragons truly are fascinating. They are greedy and follow their own
                    moral code, but I would not call them evil. They do value their possessions
                    highly, and stealing from a dragon is not to be recommended. More interesting
                    to us is that they have great knowledge of magic. They know spells more
                    advanced than any of our best wizards can master. But they know the worth of
                    their knowledge. No dragon has ever taught its arts to a human. They would
                    rather die.~";
                'me', PlayerObject:
                     "~You were always my favourite pupil, and I knew you would help me.~";
                'hut', 'forest':
                     "~I may live a little far out in the wilderness, but no one disturbs me here.~";
                'box':
                    "~A wizard's strongbox,~ he says. ~Nothing goes into it that I have not made room
                    for, and nothing comes out that I have not called for. The stones will be safe
                    in there until the hour I need them.~";
                'silver', 'teleportation', SilverScroll, TeleportSpell:
                    "~I made this spell to ease your search. It will carry you close to the
                    stones.~";
                'scroll', 'dirty', DirtyScroll, AnimateSpell:
                    if(TestScope(DirtyScroll)) {
                        if(parent(AnimateSpell)==DirtyScroll) {
                            "~It is an interesting spell. Bringing things to life is dangerous, but
                            can be very useful at times.~";
                        } else {
                            print
                                "Istar strokes his beard, squinting at the parchment. ~Hmm, I suspect this scroll holds
                                secrets meant only for discerning eyes. I encountered a cipher like this many decades ago.
                                Let us try a simple revealing trick.~^^
                                With practised hands he pours a measure of emerald fluid into a ceramic dish and
                                stirs in a viscous yellow tincture. The mixture hisses violently, filling the
                                cramped room with a thick, acrid smoke. Undeterred by the fumes, Istar holds
                                your scroll over the rising vapours. After a tense minute he passes it back to
                                you. Invisible ink has bloomed across the surface in sharp, glowing runes. It is
                                a spell!^^
                                Istar strokes his beard flat and says nothing at all, which is his way of being
                                insufferably pleased with himself.^";
                            move AnimateSpell to DirtyScroll;
                            give DirtyScroll general; ! It's been opened and its contents revealed
                            give DirtyScroll open;
                            score=score+10;
                            rtrue;
                        }
                    } else {
                        "~Scroll, what scroll?~";
                    }
                default: "~I'm afraid I know nothing about that.~";
                }
            Answer:
                "~Later, my boy, later,~ says Istar, waving the greeting away. ~Read the folio
                first. Everything I could say to you is already written in it, and written better.~";
            Show, Give:
                if(noun == SpellBook)
                    "He leafs through a few pages and hands it back with a fond, slightly wistful
                    smile. ~The same book. You have kept it well. Whatever else the Academy did to
                    you, it taught you to look after your tools.~";
                if(noun ofclass CStone) <<Ask self noun>>;
                if(noun==PlayerObject || noun==DirtyScroll || noun==Introduction)
                    <<Ask self noun>>;
        ],
        react_before [;
            Go, Exit:
                if(selected_direction && selected_direction ~= n_to && selected_direction ~= out_to) rfalse;
                if(BlackStone in self) {
                    move BlackStone to GoldBox;
                    move SilverScroll to player;
                    print "^As you turn towards the door to leave, Istar calls out,
                          ~Before you go, I should show you my stone.~ He picks up
                          a black stone and places it in ", (the) GoldBox,
                          ". ~If you find more stones, I want you to put them in the box. Take
                          this too,~ he says, handing you a silvery scroll. ~The stones are far
                          too distant for you to reach on foot. Copy this teleportation spell into
                          your spellbook and you can travel faster.~^";
                    rtrue;
                }
                if(IsCarried(Introduction) && TestScope(Introduction)) {
                    move Introduction to RemoteHut;
                    print "^~It is safest that this stays here,~ says ", (the) Istar,
                          ", taking ", (the) Introduction, " from your hands before you step outside.^^";
                }
        ],
    has animate proper;

Object f_f "forest"
    with
        name 'dark' 'mature' 'darkness' 'impenetrable' 'forest' 'woods',
        description
            "The trees are massive, ancient oaks and pines, their roots writhing through the
            earth like frozen serpents. Their dense canopy blocks out most of the daylight,
            plunging the depths of the woods into absolute, suffocating darkness.",
        before [;
            Climb:
                "The lowest branches are twenty feet up a trunk with nothing to grip, and the
                canopy above them is thicker than the one you would be climbing out of.";
            Take, Remove: "Unless you have a remarkably large sack and the strength of a titan, the forest
                        is staying exactly where it is.";
            Enter: "Trying to force your way through would only result in torn robes and broken branches.";
            ],
            found_in Meadow Forest ForestPath Mountain,
    has scenery ;

Object f_tree "tree"
    with
        name 'tree' 'trees',
        description
           "Oaks and pines of enormous age, so thick through the trunk that three men could
            not link hands around one. Nothing grows in their shade but moss.",
        before [;
            Climb:
                "The lowest branches are twenty feet up a trunk with nothing to grip, and the
                canopy above them is thicker than the one you would be climbing out of.";
            Take, Remove: "You'd need an axe.";
            ],
            found_in Meadow Forest ForestPath Mountain,
    has scenery;

    Room Forest "Forest"
    with
        description
            "You stand on a path in a mature forest, deep enough that the daylight arrives
            green and second-hand. The path leads on eastward between the trees, and every
            other direction is trunks.",
        cheap_scenery
        'canopy' 'sky'
            "Branch upon branch, layered so densely that the sky is only a rumour of grey
            somewhere far above."
        'root' 'roots'
            "Great knotted roots break the surface everywhere, humped across the path like
            the backs of half-buried animals."

        CS_NO_ADJ 'mountain'
            "Through the thick canopy to the east, you catch glimpses of a jagged,
            towering mountain peak rising against the sky."
        CS_NO_ADJ 'path'
            "A narrow dirt track, packed flat by years of passage, winding eastward through the trees.",
        before [;
        Listen:
            "Ancient branches creak softly high above, and the wind whispers through a thick canopy of leaves.
            Somewhere in the dense foliage, wild birds call back and forth, accompanied by the occasional rustle of
            small forest creatures in the underbrush.";
        Smell:
            "The air is cool, damp, and rich with the scents of decaying autumn leaves, wet bark, moss, and the
            earthy fragrance of wild mushrooms sprouting along the shaded path.";
        ],
        e_to ForestPath,
        s_to "The forest closes in just as solidly on that side. The path runs east and nowhere else.",
        w_to "Behind you the trunks crowd right up to the path's edge. You did not walk into
            this forest, and you will not be walking out of it either.",
        u_to "The lowest branches are far out of reach, high above in the suffocating canopy.",
        d_to "The damp forest floor is deep in moss and fallen pine needles, and there is nowhere to go down.",
        cant_go
            "The trees grow far too close together here, their thick brambles and tangled roots forming an
            impassable wooden wall. The path only runs east.";

Room ForestPath "Forest Path"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_WOOD);
#Endif;
            "You stand on a narrow path in a dark forest. Ahead to the east the trees thin
            out against the grey flank of a tall mountain; behind you the path runs west,
            back into the gloom.";
        ],
        cheap_scenery
        CS_NO_ADJ 'mountain'
            "Ahead to the east, the sheer grey rock face of a tall mountain looms above the
            treeline, its peak jagged against the overcast sky."
        CS_NO_ADJ 'path'
            "The narrow dirt path continues east towards the foot of the mountain, or west
            back into the heart of the forest.",
        before [;
        Listen:
            "The dense forest canopy muffles most sound, creating a heavy, expectant silence. Only a faint, distant
            howling of mountain wind and the unsettling crackle of a dry twig somewhere in the shadow-draped
            woods interrupt the stillness.";
        Smell:
            "The air turns noticeably cooler, laden with the sharp, resinous smell of pine needles, damp granite dust,
            and a faint chill blowing down off the mountain slopes.";
        ],
        n_to
            "The trees stand shoulder to shoulder that way, with bramble filling every gap
            between them. The path is the only road through this forest, and it runs east and west.",
        e_to Mountain, w_to Forest,
        u_to "The tangled canopy overhead blocks any attempt to climb upward.",
        d_to "The dirt beneath your boots is hard-packed, offering nowhere to go down.",
        cant_go
            "The dark woods are far too thick to navigate.";

Room Mountain "The Mountain"
    with
        description
            "The forest gives out here against the flank of a great mountain, far too steep
            to climb. A path leads back west into the trees, and a short way north of you a
            cave mouth opens in the rock.",
        cheap_scenery
        'cave' 'mouth'
            "A dark, jagged opening yawning in the side of the cliff face. A faint cool
            draught whistles out of the shadows within, and it smells of wet stone."
        CS_NO_ADJ 'path'
            "A narrow track leads back west into the shadows of the dense forest.",
        before [;
        Listen:
            "A brisk alpine wind rushes across the sheer stone face of the mountain, whistling through the sparse
            trees. From inside the nearby cave mouth comes a faint, echoing drip of water.";
        Smell:
            "The air here is thin, crisp, and cold, dominated by the sharp, metallic scent of exposed rock, dry gravel,
            and pine needles blowing from the treeline to the west.";
        ],
        w_to ForestPath, n_to Cave, in_to Cave,
        u_to "The mountain slope is far too steep to scale without proper gear.",
        d_to "The rocky ground offers no way downward.",
        cant_go "The sheer mountain wall curves around you, blocking further passage.";

Object -> GreatMountain "great mountain"
    with
        name 'great' 'mountain',
        description
            "A colossal wall of jagged grey stone towers far above you into the sky, its
            sheer faces slick and completely vertical.",
        before [;
        Climb:
            "The rock rises smooth and sheer for hundreds of feet. Without ropes, irons and a
            great deal more youth than you have left, it is out of the question.";
        ],
    has scenery;

Room Cave "Cave"
    with
        description
            "The cave is a single irregular chamber. Daylight reaches in through the mouth in
            the south wall, but it gives out well before the far corners do, so there is no
            telling how large the place really is. What you can see is a tunnel running on
            northward.",
        cheap_scenery
        'irregual' 'chamber'
        "The high, uneven walls of the cave stretch up into heavy shadows. Damp stone drips quietly in the gloom."
        CS_NO_ADJ 'light'
        "Faint daylight spills in from the south cave mouth, though it barely pierces the
        shadows deeper inside the chamber."
        'shadow' 'shadows'
        "Deep shadows obscure the far corners of the cave, making it impossible to gauge
        its full size without a light source."
        'stalactite' 'stalactites'
            "Long teeth of wet limestone hang from the dark overhead, each with a bead of
            water gathering slowly at its tip."
        CS_NO_ADJ 'tunnel'
        "A dark, rough-hewn passage leads further north into the heart of the mountain.",
        before [;
        Listen:
            "Drips of water fall rhythmically from unseen stalactites in the high, shadowy ceiling, splashing
            into small pools below. Your own breathing echoes softly off the damp stone walls.";
        Smell:
            "The room is cool and moist, filled with the heavy scent of thick mud, damp rock, and stagnant
            water, with just a hint of fresh air wafting in from the south entrance.";
        ],
        n_to MountainHall,
        s_to Mountain, out_to Mountain,
        u_to "The jagged ceiling of the cave offers no way upward.",
        d_to "The muddy cavern floor is solid stone beneath the silt.",
        cant_go "Rough stone walls lie that way, solid and impassable.";

Object -> CaveMud "mud"
    with
        name 'mud',
        description
            "Cold grey silt, washed down from somewhere deeper in the mountain and thick
            enough to take the print of your boot.",
        before [;
        Search:
            "You sift through the cold silt with your fingers and turn up nothing but grit
            and a few small, clean bones.";
        ],
    has scenery;

![ UpSlope normalroom;
!    if(MountainSlope has general) {
!        print (string) random(
!            "The ground is frozen and hard to climb.",
!            "With some effort you manage to climb the frozen slope."), "^^";
!    } else {
!        print (string) random(
!            "The slope is steep, and you are left breathless.",
!            "With some effort you climb the steep slope."), "^^";
!    }
!    return normalroom;
!];

[ DownSlope normalroom otherroom;
    if(MountainSlope has general) {
        if(otherroom) {
            print "The ground is frozen, and you slip down the slope.^^";
            return otherroom;
        } else {
            print "The slope is frozen, and you slide down.^^";
        }
    } else {
        print (string) random(
            "The slope is so steep that you half-run down it.",
            "You walk easily down the slope."), "^^";
    }
    return normalroom;
];

Object MountainHall "The Rock Hall"
    with
        description
            "A great cavity in the mountain, hollowed out by nature and then squared off and
            widened by human hands. It was a grand feast hall once; now somebody keeps it as
            a storeroom, and rows of crates and packages stand against the walls under a
            thick coat of dust. A large doorway is set in the north wall, and beyond it a
            slope runs down into the darkness.",
        cheap_scenery
        'large' 'cavity'
            "The vast chamber opens up overhead, its natural stone walls roughly chiselled
            and squared off to form a cavernous room."
        'feast' 'hall'
            "Though dusty and bare now, ancient torch sconces and faded carvings hint at the
            grand banquets once held here."
        'store' 'room'
            "Rows of dusty wooden crates and heavy wrapped packages are stacked high against
            the stone walls."
        'carving' 'carvings'
            "Faded reliefs of feasting figures ring the hall at shoulder height, their faces
            worn away to smooth ovals by damp and time."
        'large' 'doorway'
            "A broad opening cut square into the north wall. Beyond it the floor falls away
            into a dark, downward slope."
        'torch' 'sconces'
            "Iron torch brackets are set into the walls at regular intervals, each one
            crusted with the cold, black remains of a fire that went out centuries ago."
        CS_NO_ADJ 'slope'
            "Through the north doorway, a steep stone incline drops away into pitch-black
            depths. It looks a good deal easier to go down than to come back up."
        CS_NO_ADJ 'storeroom'
            "Rows of dusty wooden crates and heavy wrapped packages are stacked high
            against the stone walls.",
        before [;
        Listen:
            "The hall is unnaturally still. Draughts off the northern slope whisper around
            the wooden crates, carrying a hollow echo up from the depths below.";
        Smell:
            "The room smells heavily of dry dust, old timber, and age. Beneath the stale air lingers a faint,
            bitter odour of mildew from the decaying packages.";
        ],
        u_to "The vaulted rock ceiling is lost in the dark, far beyond your reach.",
        n_to [; return DownSlope(MountainSlope, DragonHall); ],
        d_to [; return DownSlope(MountainSlope, DragonHall); ],
        s_to Cave,
        cant_go "Rough-hewn rock walls form a solid barrier."
    ;

CComplicatedScroll BlackScroll "black scroll" MountainHall
    with
        name 'black' 'scroll' 'parchment',
        initial "You see a scroll wedged between two crates.",
        description [;
            "It reads: ~The resurrection spell -- raise the dead.~ The spell itself runs on
            for a great many lines, and every one of them is more complicated than the last.";
        ],
    ;

Object -> mh_box "crates"
    with
        name 'crates' 'crate',
        description "Rough wooden boxes of various sizes, nailed shut and coated in a thick layer of dust.",
        before [;
        Open:
            "The lids are nailed down hard and the wood has swollen tight with damp. You
            would need a crowbar and a very good reason.";
        Take, Remove:
            "The crates are far too heavy and cumbersome to carry around.";
        Search:
            "You feel along the gaps between the dusty crates and turn up nothing but cobwebs
            and a dead spider of impressive size.";
        ],
        has scenery pluralname;

Object -> mh_package "packages"
    with
        name 'packages' 'package' 'box',
        description "Heavy cloth-wrapped bundles tied tightly with frayed twine, stacked alongside the crates.",
        before [;
        Take, Remove:
            "The packages are far too heavy and cumbersome to carry around.";
        Search:
            "You rummage through the packages but find nothing of interest.";
        ],
        has scenery pluralname;

Object MountainSlope "Tunnel"
    with
        description [;
            print "A steep passage dropping away from the rock hall into the dark. Water trickles
                down the slope from somewhere above, and the floor beneath it is thick with ";
            if(self has general)
                print "ice and frozen mud, which makes it hard to walk.^";
            else
                print "mud.^";
        ],
        time_left 0,
        time_out [;
            if(player in self) print "^The ice melts.^";
            give self ~general;
        ],
        each_turn [;
            if(self has general) {
                if(LeftWarrior in self && RightWarrior in self) {
                    move LeftWarrior to DragonHall;
                    move RightWarrior to DragonHall;
                    if(player in self) {
                        print
                            "^The warrior and the barbarian slip on the ice at the same moment and go down the
                            slope together. The barbarian grabs at your leg on the way past, and takes you with him.^^";
                        PlayerTo(DragonHall);
                    }
                }
                if(LeftWarrior in self) {
                    move LeftWarrior to DragonHall;
                    if(player in self) {
                        print "^", (The) LeftWarrior, " slips on the ice. He grabs your leg and you
                                    both slide down the slope.^^";
                        PlayerTo(DragonHall);
                    }
                }
                if(RightWarrior in self) {
                    move RightWarrior to DragonHall;
                    if(player in self) {
                        print "^", (The) RightWarrior, " slips on the ice. He grabs your leg and you
                                    both slide down the slope.^^";
                        PlayerTo(DragonHall);
                    }
                }
            }
        ],
        cheap_scenery
        'broadsword' 'sword'
            "A slab of stone sword, chipped along one edge. Carved or not, you would not care
            to be standing in front of it."
        CS_NO_ADJ 'dagger'
            "Short, curved and held low and close, in the grip of a man who has used one before.",
        before [;
        Listen:
            "The continuous trickling and splashing of water flowing down the slick stone floor echoes
            wetly off the narrow tunnel walls.";
        Smell:
            "A cool, heavy dampness fills the air, saturated with the strong, metallic odour of wet
            subterranean rock and stagnant mud.";
        ],
        !u_to [; return UpSlope(MountainHall); ],
        !s_to [; return UpSlope(MountainHall); ],
        s_to "The slope behind you is far too steep and far too slippery to climb back up.",
        d_to [; return DownSlope(DragonHall); ],
        n_to [; return DownSlope(DragonHall); ],
        cant_go "Rough cavern walls block that way, dripping with moisture.",
    ;

Object -> ms_floor "floor"
    with
        name 'floor',
        description
            "What was once dressed stone is buried under a sliding layer of wet mud. There is
            not a square foot of it you could stand on with any confidence.",
   has scenery;

Object -> ms_water "mud"
    with
        name 'water' 'mud' 'frozen' 'ice' 'ground' 'wet' 'slope',
        short_name [;
            if(MountainSlope has general) print "frozen mud";
            else print "wet mud";
            rtrue;
        ],
        parse_name [ w n;
            n = 1;
            w = NextWordStopped();
            give self ~general; ! general if we parsed water, else mud
            if(w == 'frozen' or 'wet') { w = NextWordStopped(); n = 2; }
            if(w == 'water' or 'ice') { give self general; return n; }
            if(w == 'mud' or 'ground') { return n; }
        ],
        description [;
            if(MountainSlope has general)
                "The mud is frozen solid and covered with ice.";
            if(self has general)
                "A thin trickle of cold spring water runs constantly down the stone incline,
                turning the cavern floor into a slippery mire.";
            "Grey, glutinous and ankle-deep in the hollows, worked to a slick paste by the
            water running through it. Your boots have no purchase in it whatsoever.";
        ],
        domagic [spell;
            if(spell==FreezeSpell) {
                if(MountainSlope has general) {
                    print "Nothing happens. The ground is still frozen.^";
                    MountainSlope.time_left=10;
                } else {
                    give MountainSlope general;
                    print
                        "The temperature drops at once. The water and the mud freeze hard, your boots go
                        out from under you, and you slither a couple of metres down the tunnel before
                        you can stop yourself.^";
                    StartTimer(MountainSlope, 10);
                }
                rtrue;
            }
            rfalse;
        ],
    has scenery concealed; ! general if referred to as water

Object -> LeftStatue "warrior statue"
    with
        name 'warrior' 'left' 'statue' 'statues',
        number 0,
        description
            "Cut from the same grey rock as the tunnel itself, a broad-shouldered warrior
            stands with a broadsword held point-down before him. The work is crude, but the
            face is startlingly alive, caught somewhere between boredom and bad temper.",
        domagic [spell;
            if(spell==AnimateSpell) {
                print "The statue comes to life!^";
                LeftWarrior.number=10; StartDaemon(LeftWarrior);
                ReplaceObj(self, LeftWarrior);
                rtrue;
            }
            rfalse;
        ],
        life [;
        default: "The stone warrior stands motionless, its cold gaze staring blankly into the dark.";
        ],
        before [;
        Touch: "The stone is cold, wet and utterly inert under your fingers.";
        Push, PushDir:
            "It does not shift so much as a hair. The statue and the mountain appear to be
            the same piece of rock.";
        TalkTo: return self.life();
        ],
        initial [;
            if(TestScope(RightStatue)) "Two statues guard the passage.";
            "A statue stands at the left wall, guarding the passage.";
        ],
    has static animate;

Object -> RightStatue "barbarian statue"
    with
        name 'barbarian' 'right' 'statue' 'statues',
        description
            "The barbarian is all snarl and sinew, a sword in his right hand and a long
            dagger in his left. Whoever carved him appears to have been working from an
            unpleasantly clear memory.",
        life [;
        Ask:
            "You put the question to a lump of carved rock, and a lump of carved rock
            is what answers you.";
        default: "The barbarian statue remains silent and stone-still.";
        ],
        before [;
        Touch: "The stone is cold, wet and utterly inert under your fingers.";
        Push, PushDir:
            "It does not shift so much as a hair. The statue and the mountain appear to be
            the same piece of rock.";
        TalkTo: return self.life();
        ],
        domagic [spell;
            if(spell==AnimateSpell) {
                print "The statue comes to life!^";
                RightWarrior.number=10; StartDaemon(RightWarrior);
                ReplaceObj(self, RightWarrior);
                rtrue;
            }
            rfalse;
        ],
        initial [;
            if(TestScope(LeftStatue)) rtrue;
            "A statue stands at the right wall, guarding the passage.";
        ],
    has static animate;

[ CommentWarriorAttackingMe warrior;
    print "^", (The) warrior, " attacks you", (string) random(
            ", and only your quick reflexes save you from an early death.",
            ". The sword sweeps at you, but at the last moment you manage to leap aside.",
            " and aims at your chest. You manage to squirm past him."
        ), "^";
];

[ CommentWarriorAttackingWarrior;
    if(MountainSlope has general)
        "^The warrior and the barbarian trade blows across the frozen floor, and neither
        of them has landed one yet.";
    LeftStatue.number = LeftStatue.number + 1;
    if(LeftStatue.number == 2) {
        "^The warrior swings, the barbarian turns the blade on his dagger, and neither of them gives an inch.";
    }
    print "^", (The) LeftWarrior, " and ", (the) RightWarrior,
                " fight each other", (string) random(
            ". The swords clash, but both are still unharmed.",
            ", and their strength and skill seem evenly matched."
        ), "^";
];

Object LeftWarrior "warrior"
    with
        number -1,
        name 'left' 'statue' 'warrior',
        description
            "The statue is alive now. A large warrior stands before you swinging his
             broadsword. He seems to be looking for a suitable victim.",
        life [;
            if(RightWarrior in location)
                "The warrior is far too busy parrying the barbarian's dagger to answer you.";
            "The warrior is far too intent on taking your head off with his broadsword to engage in small talk!";
        ],
        before [;
        TalkTo: return self.life();
        ],
        daemon [;
            if(self.number>0) --self.number;
            if(self.number==0) {
                if(TestScope(self)) print (The) self, " turns back into a statue.^";
                ReplaceObj(self, LeftStatue);
                return;
            }
            if(parent(self)==parent(RightWarrior)) {
                if(TestScope(self)) CommentWarriorAttackingWarrior();
            } else {
                if(TestScope(self)) {
                    CommentWarriorAttackingMe(self);
                } else {
                    move self to location;
                    print "^", (The) self, " charges at you with his sword raised.^";
                }
            }
        ],
    has animate;

Object RightWarrior "barbarian"
    with
        name 'right' 'statue' 'barbarian',
        number -1,
        description
            "The statue is alive now. A fierce barbarian stands before you swinging his
             sword. He seems to be looking for a suitable victim.",
        life [;
            if(LeftWarrior in location)
                "The barbarian is far too busy dodging broadsword swings to answer you.";
            "The barbarian is far too intent on stabbing you to engage in small talk!";
        ],
        before [;
        TalkTo: return self.life();
        ],
        daemon [;
            if(self.number>0) --self.number;
            if(self.number==0) {
                if(TestScope(self)) print (The) self, " turns back into a statue.^";
                ReplaceObj(self, RightStatue);
                return;
            }
            if(parent(self)~=parent(LeftWarrior)) {
                if(TestScope(self)) {
                    CommentWarriorAttackingMe(self);
                } else {
                    move self to location;
                    print "^", (The) self, " charges at you with his sword raised.^";
                }
            }
        ],
    has animate;

Room DragonHall "The Dragon Hall"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_DRAGON);
#Endif;
            if(self hasnt visited) print "You slide to a stop"; else print "You are";
            " in a vast hall cut straight out of the heart of the
            mountain. The stench of sulfur is oppressive, and the floor lies under a layer
            of ash deep enough to say that no mortal has set foot here for centuries. The
            only way out is the treacherous, muddy incline behind you.";
        ],
        cheap_scenery
        CS_NO_ADJ 'hall'
            "Every surface of it was cut by hand: fluted columns, a vaulted roof lost in the
            dark, a floor of dressed slabs now buried under ash. Whoever built this did not
            build it for a dragon, and the dragon has outlasted them by a very long way."
        'sulfur' 'sulphur'
            "Thick, yellowish fumes drift near the vaulted ceiling, stinging your nostrils
            with the sharp stench of brimstone."
        'slope' 'incline'
            "A steep, slick chute of frozen mud leading back up into the dark tunnel. It looks
            far too slippery to climb without help."
        CS_NO_ADJ 'ash'
            "A deep layer of fine grey ash coats the chamber floor, drifting like snow under
            your boots and smelling faintly of ancient fires.",
        before [;
        Wait:
            if(Dragon.number>0)
                "You wait. The great ragged breaths are coming slower each time.";
            "You keep very still and wait.";
        Smell: "The air is thick and suffocating, reeking of sulfur, singed stone, and bitter ash.";
        Listen:
            "A deep, rhythmic rumble travels up through the stone floor: the slow breathing
            of the beast. Every so often there is a soft metallic slither of coins as her
            great chest rises and settles again on the hoard.";
        Pray:
            "You ask, without much hope, for the life of a creature you have no business
            saving. No answer comes. Whatever was listening in the temple by the sea does
            not reach down this far.";
        ],
        u_to
            "The frozen mud is a sheet of glass tilted uphill. You would be back at the
            bottom before you had climbed ten feet.",
        !u_to [; return UpSlope(MountainSlope); ],
        !s_to [; return UpSlope(MountainSlope); ],
        cant_go "Solid rock walls block your path.";

Object -> Treasure "treasure"
    with
        name 'pile' 'heap' 'hoard' 'valuables' 'treasure' 'coins' 'coin' 'gems' 'gold',
        initial "Sprawled across a staggering hoard of gold and priceless relics is a colossal dragon.",
        description
            "Coins, plate, cups and crowns lie heaped in drifts across the floor, most of it
            tarnished black with age. A fortune, and not one piece of it worth your life.",
        before [;
            Take, Remove, Transfer:
                if(Dragon.number>0)
                    "Even now, with her blood soaking into the ash, you find you cannot
                    quite bring yourself to put a hand into a dragon's hoard.";
                if(TestScope(Dragon)) "You dare not even glance at the treasure while the
                                                            dragon guards it.";
                "Dragon gold brings no good.";
            Examine: rfalse;
            default:
                if(TestScope(Dragon)) "You dare not even glance at the treasure while the
                                                            dragon guards it.";
                rfalse;
        ],
    has static;

Object -> Wound "wound"
    with
        name 'wound',
        description [;
            if(Dragon.number>0)
                "The barbarian's sword went in deep at the base of her throat. Blood wells out of
                it in a slow, steady pulse, and the pulse is getting weaker.";
            "The dragon's wound is healed.";
        ],
    has scenery;

Object -> Dragon "dragon"
    with
        name 'dragon' 'wyrm' 'serpent' 'wounded' 'shocked' 'she',
        number -1,                                                 ! time-out for the wounded state
        initial [;
            if(self.number>0) "There is a wounded dragon here.";
            "The dragon tilts her massive head, watching your sudden and undignified entrance with frank curiosity.";
        ],
        domagic [spell;
            if(self.number<=0)
                print_ret (The) self, " stops you with a short spell, but looks amused.";
            if(spell==HealSpell && self hasnt general) {
                give self general;
                print "The blood stops flowing and the wound in her throat closes. The dragon
                            is still in shock, but you have saved her life.^";
                self.number=6;
                score=score+10;
                rtrue;
            } else {
                print_ret (The) self, " stops you with a short spell.";
            }
        ],
        description [;
            if(self.number>0) {
                if(self has general)
                    "The dragon's wounds are healed, but she is still in shock.";
                "The dragon's blood pours out through the wound in her throat, and you watch
                her grow weaker and weaker.";
            }
            "Whole again, she is magnificent and frankly terrifying: a long, deep-chested
            body of overlapping bronze scales, and a pair of eyes that consider you with
            perfect, unhurried intelligence.";
        ],
        before [;
            Thanks:
                "The dragon inclines her enormous head. ~We are square, wizard. Do not make a
                habit of saving dragons. It gives us expectations.~";
            Attack:
                if(self.number>0)
                    "She is dying where she lies, and you did not come all this way down to finish her off.";
                "This is a dragon we are talking about. Magic might work, but force... forget it!";
        ],
        life [;
            Show:
                if(noun == SpellBook)
                    "She glances at the open page and away again, unimpressed. ~Books,~ she says
                    thickly. ~You people always did put a great deal of faith in books.~";
            Ask, Answer, Order:
                if(self has general && KillSpell notin SpellBook) {
                    print
                        "The dragon focuses on you, and something like surprise crosses her face. ~A
                        wizard,~ she says. ~Yes, of course. It was your spell that closed my throat.~
                        She raises her head and looks you in the eye. ~You saved my life, wizard. In
                        return I shall give you the most precious thing I know.~^^
                        Your spellbook suddenly floats before you and opens itself.
                        A new spell is written on a blank page: the Death Spell.^";
                    move KillSpell to SpellBook;
                    score=score+10;
                    rtrue;
                }
                if(self.number>0) {
                    ! dragon is wounded
                    if(self hasnt general) {
                        "The great eye tracks you across the ash, but she has no breath to spare for an answer.";
                    } else {
                        "The dragon mutters to herself: ~A human who saves my life. Helps a dragon.
                        Never heard of such a thing.~ She is still very far from herself.";
                    }
                } else {
                    ! dragon is healed
                    if(second == 'stone' or 'stones')
                        "~Stones.~ She turns the word over. ~Cut stones, of four colours, that call to
                        one another across a great distance. Yes. They were made to open something, and
                        whatever they open was shut for a reason. I would think very hard about who is
                        asking you to collect them.~";
                    if(second == 'death' or 'spell')
                        "~It is a cruel gift, and I have given it to you anyway,~ she says. ~You will
                        know the moment it is needed. If you are fortunate, you never will.~";
                    if(second == 'istar')
                        "~I do not know your teacher. But I have lived a long time, wizard, and I will
                        tell you this for nothing: when an old man asks a young one to fetch what he
                        will not fetch himself, it is worth asking why.~";
                    if(second == 'treasure' or 'gold')
                        "~Take some, if it pleases you.~ She does not move. ~It is only metal. I lie on
                        it because it is the one thing down here that does not rot.~";
                    if(second == 'old' or 'gods')
                        "The dragon is quiet for a long moment. ~We are old,~ she says at last. ~They are
                        older. My grandmothers went down into the deep rock to be out of their way, and
                        my grandmothers did not frighten easily.~";
                    "The dragon looks at you but says nothing.";
                }
            default: rfalse;
        ],
        daemon [l r p;
            ! Dragon wounded timer
            if(self.number>0) {
                --self.number;
                if(self.number == 1 && self hasnt general) {
                    print "^The dragon falls silent. Only the faintest movement of her flank shows that she is still alive.^";
                }
                if(self.number==0) {
                    if(self has general) {
                        if(TestScope(self)) {
                            print "^", (The) self, " pulls herself together and looks as strong and calm
                                        as before the attack.^";
                            give self ~general;
                            self.number=-1;
                        }
                    } else {
                        ++self.number; ! don't let the dragon die/
! No, no time puzzles here
!                        if(TestScope(self))
!                            print "^", (The) self, " lifts her head and looks furious. She tries to
!                                        burn you, but aims badly and misses. Exhausted, she falls back down
!                                        and dies.^";
!                        ReplaceObj(self, DeadDragon);
                        rtrue;
                    }
                } else if(TestScope(self)) {
                    if(self has general) {
                        switch(self.number) {
                        5:
                            "^The dragon lies where she fell, flanks heaving, and does not seem to have noticed you at all yet.";
                        4:
                            "^The dragon shifts among the coins and tests her throat with one slow, careful swallow.";
                        3:
                            "^The dragon's breathing is steadier now, but her eyes are still glassy.";
                        2:
                            "^Some colour is returning to the great scaled throat.";
                        1:
                            "^The dragon draws one long, deep breath and holds it, as though testing whether it hurts.";
                        }
                    } else if(self.number > 1) {
                        print "^", (string) random(
                            "The dragon's breathing grows more ragged.",
                            "The dragon looks weaker.",
                            "The dragon is almost dead."), "^";
                    }
                }
            }
            ! Kill the animated statues
            l=LeftWarrior in parent(self); r=RightWarrior in parent(self);
            p=player in parent(self);
            if(l) RemoveObj(LeftWarrior);
            if(r) RemoveObj(RightWarrior);
            if(l==true && r==true) self.number=5; ! the dragon is wounded
            if(l==true && r==true && p==true) {
                print "^", (The) LeftWarrior, " and ", (the) RightWarrior,
                    " see the dragon and rush forward with weapons
                    drawn. She takes the warrior first and he goes up like dry kindling, but the
                    barbarian is inside her guard before she can turn, and drives his sword deep
                    into her throat. Beside herself with rage and pain, she burns what is left of
                    the pair of them to ash.^";
            } else if((l==true || r==true) && p==true) {
                    if(l) print "^", (The) LeftWarrior;
                    else print "^", (The) RightWarrior;
                    print " sees the dragon and rushes at her with weapon raised high. The dragon
                                quickly burns him to death and cremates the body.";
            }
            if((l==true || r==true) && p==false)
                print "^You hear screams and the clash of weapons nearby. Then a warm gust of
                            air comes, and the screams suddenly fall silent.^";
        ],
    has animate female;

Object DeadDragon "dragon"
    with
        name 'dragon' 'wyrm' 'serpent' 'body' 'corpse' 'dead' 'she',
        initial "On the floor lies the dragon's dead body.",
        description "The dragon's enormous body lies still and cold on the hall floor.",
        domagic [spell;
            switch(spell) {
            ResurrectSpell:
                ReplaceObj(self, Dragon);
                give Dragon general;
                Dragon.number=6;
                StartDaemon(Dragon);
                "The dragon's body shudders. The gaping wound in her throat draws together, and
                she begins to breathe again. She suddenly sits up but falls heavily back. She
                still seems to be in shock.";
            HealSpell:
                "She is dead. The healing spell has no effect.";
            default: rfalse;
            };
        ],
    has static female;

Room TeleportRoom "On the Steppe"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_TELEPORT);
#Endif;
            "The yellow cloud dissipates, leaving you standing in a boundless, wind-swept
            steppe that rolls onward to the horizon. Strangest of all, you find yourself
            encircled by four free-standing, ornate archways, each facing one of the
            cardinal directions of the compass.";
        ],
        cheap_scenery
            CS_NO_ADJ 'grass'
                "Waist-high steppe grass, bleached the colour of old straw and bending all one
                way in the wind. There is not a fence, a track or a rooftop anywhere in it."
            CS_PARSE_NAME ParseNameSteppe
                "The steppe stretches as far as the eye can see under a pale, vast sky. The dry
                grass whispers softly in the cold wind, broken only by the eerie presence of the
                four archways."
            'rune' 'runes'
                "Deep-cut characters march across each keystone in a script far older than anything you were taught
                to read. They pulse slowly, in a rhythm uncomfortably like breathing."
            'compass' 'directions'
                "There is no compass here to look at. The archways themselves do the work, standing true to north,
                south, east and west and cutting the vast horizon into four quarters."
            CS_PARSE_NAME ParseNameYellowCloud
                "The magical mist has already thinned and vanished into the brisk steppe air, leaving behind only the faint,
                ozone scent of teleportation magic.",
        react_before_magic [spell;
            if(spell == TeleportSpell)
                "The spell will not take hold. The archways have a grip on this place, and until
                you walk under one of them you are staying exactly where you are.";
        ],
        before [;
        Listen:
            "A low, persistent wind moans across the open plains, whistling softly as it passes through the ancient stone
            carvings of the four archways. Beyond the wind, the silence is absolute and immense.";
        Smell:
            "The air is cool, crisp, and pure, carrying the clean scent of dry wild grass and sun-baked earth,
            untainted by smoke or civilization.";
        ],
        n_to [; print "A yellow cloud surrounds you, and as it clears you find yourself in a...^^";
                PlayerTo(Forest); rtrue; ],
        s_to [; print "A yellow cloud surrounds you, and as it clears you find yourself in the...^^";
                PlayerTo(Meadow); rtrue; ],
        e_to [; print "Step by step, you pass beneath the eastern arch. A swirl of yellow mist envelops you once more,
                    and as it clears, the wide steppe vanishes...^^";
                PlayerTo(VillageRoad); rtrue; ],
        w_to [; print "A yellow cloud surrounds you, and as it clears you find yourself...^^";
                PlayerTo(ChurchYard); rtrue; ],
        u_to "The sky over the steppe is enormous, cloudless and entirely out of reach.",
        d_to
            "Dry turf and hard-packed earth, bound together by the roots of a thousand years
            of grass. You would need a spade and a fortnight to get anywhere.",
        cant_go "You can only leave through the archways.";

Object -> Archway "archways"
    with
        name 'archway' 'archways' 'arch' 'arches' 'portal' 'portals' 'gate' 'gates' 'door' 'doors' 'doorway' 'doorways',
        description
            "Four massive stone arches stand in a wide circle around you, each squarely
            aligned with one of the cardinal compass directions. Glowing runes are cut into
            the keystone of every arch, and the air beneath them hums quietly to itself.",
        before [;
        LookThrough:
            "Through the arch you can see the same grass, the same wind, the same empty horizon.
            Whatever lies on the other side does not show itself until you walk under the stone.";
        Touch:
            "The stone is oddly warm under your palm, and the runes brighten at the contact,
            as though they can tell a wizard by feel.";
        ],
    has scenery pluralname;

Room ChurchYard "Before a Temple"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_CHURCH);
#Endif;
            "You stand on a narrow path that runs down to the sea in the south and into the
            forest in the north. The air is salt and fresh. To the east of you stands a
            great temple, weathered by long centuries of sea wind.";
        ],
        cheap_scenery
        CS_NO_ADJ 'forest'
            "A dense cluster of tall green trees visible along the path to the north."
        CS_NO_ADJ 'sea'
            "To the south, waves lap against the shore under a bright sky. The ocean
            breeze carries a fresh, salty scent."
        'narrow' 'path'
            "A narrow ribbon of trodden earth running from the treeline in the north down
            towards the shore in the south, with the temple standing off to the east.",
        before [;
        Listen:
            "The distant, rhythmic crashing of waves against the rocks below mingles with the gentle rustle of
            sea grass in the coastal breeze.";
        Smell:
            "The crisp air is rich with the sharp, clean scent of brine and damp seaweed carried up from the
            shoreline, subtly laced with the earthy fragrance of pine from the nearby woods.";
        ],
        n_to "The road winds on into the forest, where you have no business.",
        s_to Beach,
        e_to Church,
        u_to "There is nothing above you but open sky.",
        d_to "The hard dirt path offers nowhere to descend.",
        cant_go "A thick wall of brambles and scrub vegetation blocks any progress.";

Object -> DummyChurch "temple"
    with
        name 'church' 'temple',
        description
            "The temple is run-down but still imposing, raised from great blocks of weathered, ancient stone.",
    has scenery;

Room Church "The Temple"
    with
        description
            "The vaults rise high above your head, and the whole great space stands silent
            and abandoned. The leaded windows have been broken out, and almost all the
            furnishings are gone.",
        cheap_scenery
        'leaded' 'windows'
            "Multi-paned leaded windows line the high walls, though nearly every pane of
            glass has been smashed, letting in the cool ocean breeze."
        CS_NO_ADJ 'temple'
            "You are standing inside the main sanctuary of the ancient, ruined stone temple."
        'flowers' 'plants'
            "Withered stems and dried petals lie scattered in the dust at the statue's base."
        CS_NO_ADJ 'food'
            "Desiccated crumbs and ancient bones, left long ago as offerings to the strange deity."
        CS_NO_ADJ 'furnishings'
            "Only broken scraps of wood and overturned stone bases remain where altars and pews once stood."
        CS_NO_ADJ 'remains'
            "Brittle stalks that were once flowers, and a few blackened scraps that were once
            food, laid out in a careful row at the statue's feet. Nobody has renewed them in
            a very long time."
        'vault' 'vaults'
            "Ribbed stone vaults span the ceiling far overhead, dark with age and hung with
            cobwebs the size of bedsheets.",
        before [;
            Pray:
                if(self has general && player hasnt general) "You have already been answered.";
                give self general;
                if(player has general) {
                    give player ~general;
                    "You say another prayer, and once more you are answered. The change back is quite
                    as painful as the change out was: the scales sink away, the webbing parts, and
                    the fin withdraws along your spine. Your robe is the worse for all of it, but
                    otherwise you are yourself again.";
                }
                give player general;
                "You say a quick prayer for success in your quest, as you have so many times
                before, but this time the answer comes back with alarming speed. Scales push up
                through the skin of your arms. Your sight goes strange and swimming. Webbing
                stretches between your fingers, your back begins to ache, and something sharp
                breaks out along your spine and tears a long hole in your robe.^^
                The whole business takes only a few minutes. At the end of it you are very
                nearly a copy of the statue standing before you.";
            Listen:
                "The wind whistles hollowly through the broken leaded windows, echoing up into the high,
                vaulted ceiling like a faint, haunting sigh.";
            Smell:
                "The vast space smells of cold stone, of damp moss creeping up between the
                flagstones, and of the salt breeze blowing in through the broken windows.";
        ],
        w_to ChurchYard,
        out_to ChurchYard,
        u_to "The high vaulted ceiling offers no way upward.",
        d_to "The flagstone floor is solid and cold underfoot.",
        cant_go "Solid stone walls block your path.";

Object -> Statue "statue"
    with
        name 'statue' 'fish' 'scales',
        initial "A statue still stands in the middle of the temple.",
        description
            "The statue is like nothing you have seen before. The shape is broadly human, but
            the scales and the tall fin running down its back are not. At its feet lie the
            withered remains of flowers and food, so somebody worshipped here once, and did
            so for a long while.",
        life [; "The scaled stone deity stares blankly past you into the empty sanctuary."; ],
        before [;
        Touch: "The stone is cool and faintly damp, and far smoother than any chisel could have
                left it, as though a great many hands had gone over it before yours.";
        Attack: "You raise a hand and then feel extremely foolish. It is a block of carved stone,
                and the only thing you would break is your knuckles.";
        Search: "You find nothing hidden about the statue, only the old offerings mouldering at its feet.";
        Take, Remove: "The heavy stone statue is firmly anchored to the sanctuary floor.";
        TalkTo: return self.life();
        ],
    has static;

Room Beach "The Beach"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_WAVE);
#Endif;
            "Here the land gives out, and great waves come in and break along a strand of
            dark sand. A path leads back north towards the temple.";
        ],
        before [;
        Swim:
            if(player hasnt general)
                "You are no great swimmer, and the waves are too high today.";
            print
                "You throw yourself into the surf, and your new body knows exactly what to do
                with it. Fins and webbed hands drive you down through the green water towards the bottom...^^";
            PlayerTo(OceanFloor);
            rtrue;
        Listen:
            "The thunderous roar of crashing waves dominates the shore, followed by the wet, rushing hiss
            of foamy surf receding over pebbles and the sharp cries of gulls high above.";
        Smell:
            "The air is heavy with the pungent, bracing scent of ocean spray, wet kelp, and damp, sun-baked sand.";
        ],
        cheap_scenery
        'wave' 'waves'
            "Towering, foamy waves surge onto the dark sand with a rhythmic roar, spraying cold saltwater into the air."
        'ocean' 'sea'
            "The vast, open sea stretches endlessly to the horizon, dark blue and churning under the open sky."
        'shore' 'beach'
            "A narrow strip of wet, pebbled sand where the surging ocean meets the rocky coast."
        'rock' 'rocks'
            "Black, weed-slicked rocks break the line of the beach to either side, with deep
            tide pools standing between them."
        'bird' 'birds'
            "Gulls hang almost motionless on the onshore wind, sliding sideways now and then
            to keep their station above the surf.",
        n_to ChurchYard,
        d_to "The wet sand gives way to surging surf.",
        s_to "If you want to swim, you can just say so.",
        u_to "There is nothing above you but the open sky and soaring sea birds.",
        cant_go "Jagged sea rocks and deep tide pools prevent travel along the beach.";

Object SeaWater "sea water"
    with
        name 'water',
        found_in Beach OceanFloor,
        description "It's just salty sea water.",
        before [;
        Taste, Drink:
            "You wet a finger in the surf. Salt, cold, and a faint mineral bite underneath
            it, as though the water had come a very long way to get here.";
        ],
    has scenery;

Room OceanFloor "The Sea Floor"
    with
        description
            "The sea floor is a field of ripple-marked sand, scattered with bright shells and
            combed by slow, swaying sea plants. Far above, the light comes down in shifting
            bars. You can swim back up towards the shore.",
        cheap_scenery
        'plant' 'plants'
            "Long ribbons of weed sway in slow unison with the swell, rooted among the
            stones, their fronds catching what little light reaches this far down."
        CS_NO_ADJ 'sand'
            "Fine pale sand, drawn into long even ripples by the tide and marked here and
            there by the trail of something that buried itself as you came down.",
        before [;
            Swim: <<Go FAKE_U_OBJ>>;
            Listen:
                "Submerged beneath the surface, the noisy surf is reduced to a dull, soothing rumble far above.";
            Smell:
                "Whatever the sea has to tell you, it does not tell it through your nose. You try
                anyway, and get a mouthful of cold salt water for your trouble.";
        ],
        u_to Beach,
        n_to Beach,
        d_to "The sand is packed hard beneath you, and whatever lies under it means to stay there.",
        cant_go "Forests of dense kelp and sharp coral reefs block any progress west..";

Object -> Shells "sea shells"
    with
        name 'shells' 'shell',
        description
            "A scattering of sea snail shells, spiral nautiluses, and polished clam shells coat the seabed,
            their iridescent mother-of-pearl catching the filtered sunlight from above.",
        before [;
        Take:
            "You gather a handful, admire them, and let them fall again. You did not come
            down here for souvenirs.";
        ],
    has scenery;

Room VillageRoad "The Country Road"
    with
        description [;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_VILLAGE);
#Endif;
            "You stand on a narrow dirt road winding between vast, rustling cornfields. To the east, past the golden stalks,
            you can see the thatched rooftops of a small village. A solitary oak tree casts its shadow over the wayside.";
        ],
        cheap_scenery
            CS_PARSE_NAME ParseNameCornFields
                "Tall stalks of corn sway gently in the breeze, forming a rustling wall on either side of the road."
            'village' 'rooftops'
                "A little way east, past the corn, the village looks peaceful enough, its smoke curling lazily into the sky.",
        e_to [;
            if(Beggar in self && Village hasnt visited) {
                print
                    "The beggar watches you with a mournful sigh as you step past him and go
                    on down the dusty road towards the village.^^";
            }
            if(SleepingBeggar in self) {
                print
                    "You leave the beggar to his nap and walk back up the dusty road towards the market.^^";
            }
            return Village;
        ],
        before [;
        Listen:
            "Dry corn leaves rustle pleasantly in the warm breeze, occasionally accompanied by the faint chattering
            of birds in the oak tree and distant murmurs carried from the village.";
        Smell:
            "The warm air carries the rich scent of sun-baked dirt, ripe corn, and dry oak bark, undercut by the faint,
            stale odour of unwashed rags from the beggar.";
        ],
        n_to
            "The corn grows right up to the edge of the road, a dense wall of stalks taller
            than a man. Trampling a farmer's crop is a poor way to repay the hospitality of the country.",
        s_to "The cornfields close the road in on that side as well. The track itself runs only east and west.",
        w_to "The road winds on westward into open country, where you have no business and no time to spare.",
        u_to [;
            if(OakTree has general)
                "The oak's lower branches are the only way up from here, and you have already tried those.";
            "You don't possess a levitation spell.";
        ],
        d_to "Nothing beneath your boots but the dry, rutted earth of the road.",
        cant_go "Trampling through a farmer's crop is no way to repay his country's hospitality.";

Object -> OakTree "oak tree"
    with
        name 'oak' 'tree',
        description "An ancient, sprawling oak tree providing a welcome patch of deep shade beside the dusty road.",
        before [;
        Climb:
            give self general;
            "You get no higher than the lower branches before realizing the view is completely blocked by dense
            summer leaves. You hop back down to the dusty road.";
        ],
    has scenery;

Object -> Beggar "beggar"
    with
        name 'ragged' 'beggar',
        initial
            "A ragged beggar leans against the trunk of the tree, holding out a weathered hand.",
        description
            "He is a gaunt, frail man clad in threadbare rags. His eyes are sunken with exhaustion, and he holds
            out a palm in mute appeal for charity.",
        life [;
            Ask, Tell, Show:
                if(second == 'stone' or 'stones')
                    "~Stones I have plenty of, master. They're free, and they don't fill a belly.~ He gestures
                    vaguely at the roadside gravel and lets his hand fall back into its begging posture.";
                if(second == 'amulet')
                    "His hand moves to his chest, just for an instant, before he catches himself.
                    ~Nothing there worth your trouble, master. Only rags and ribs.~";
                if(second == 'village' or 'market' or 'markets')
                    "~Market day,~ he says without enthusiasm. ~Good day for a man with coins. I go
                    in sometimes, but the traders move me along quick enough.~";
                if(second == 'hawker' or 'busker')
                    "The beggar's mouth twists. ~Him with the cups? He's been taking silver off honest
                    folk since the spring. Nobody has ever seen him lose, master. Nobody.~";
                <<TalkTo self>>;
            Answer, Order:
                "~Good day to you, master wizard,~ he rasps, and the effort of it seems to cost
                him something. ~You'll forgive me if I don't get up.~";
            Give:
                if(noun==SilverCoin) {
                    remove noun;
                    move Amulet to player;
                    remove self;
                    "The beggar is overwhelmed by your generosity. It has clearly been a long time
                    since he last held a silver coin. From under his rags he pulls out an amulet on
                    a cord and presses it on you, and will not hear of your refusing it.^^
                    Content with the day's work, the beggar wanders off to the west.";
                }
                "The beggar squints at ", (the) noun, ", then shakes his head dolefully. ~Keep that to yourself, master.
                Plain bread or coin is all I ask.~";
        ],
        before [;
            TalkTo:
                "The beggar looks up at you with weary, cloudy eyes. ~Spare a copper for a poor soul, sir?~ he rasps, shuffling
                his palm forward. ~A bite of bread or a coin to warm my bones, and I'd be eternally grateful.~
                He seems too weak and distracted by hunger to offer much conversation.";
            Search:
                "The poor man has nothing on him save the threadbare rags on his back. Pulling at his clothes would be needlessly cruel.";
            Attack:
                "You could easily overpower the frail old man, but what kind of hero attacks a helpless beggar on the roadside?";
            Smell:
                "Dust, old sweat and unwashed wool, warmed by the sun.";
            Push, PushDir, Transfer:
                "There is no reason to move him. He is not in your way, and he is exactly where he wants to be.";
        ],
        add_to_scope BeggarHands BeggarRags Amulet,
    has animate;

Object Amulet "amulet"
    with
        article "an",
        name 'magic' 'magical' 'amulet',
        description
            "A surprisingly ornate amulet, slightly tarnished around the rim, hanging from a
            simple cord. It radiates a faint, comforting warmth. An inscription on the back
            promises that it will serve as both shield and weapon against black magic.",
        before [;
        Take, Remove:
            if(self notin nothing) rfalse;
            print "It is on a cord around ";
            if(SleepingBeggar in VillageRoad) print "a sleeping man"; else print "the beggar";
            "'s neck, and you are not a thief.";
        ]
    has clothing;

Object BeggarHands "hands"
    with
        name 'weathered' 'hand' 'hands',
        description [;
            if(SleepingBeggar in VillageRoad)
                "Even asleep, his begging hand lies open in the dust beside him. Force of habit.";
            "His palm is upturned and quite empty, the fingers trembling slightly with the effort of holding it out.";
        ],
        before [;
        Receive:
            if(SleepingBeggar in VillageRoad) {
                if(noun == SilverCoin)
                    "The coin sits in his upturned palm, bright and entirely unnoticed. You retrieve
                    it before somebody less scrupulous comes down the road.";
                "Perhaps try later when he's awake?";
            }
            "The beggar closes his hand. ~Bread or coin is all I need.~";
        ],
    has scenery pluralname;

Object BeggarRags "rags"
    with
        name 'rag' 'rags' 'clothes',
        description [;
            if(SleepingBeggar in VillageRoad)
                "The same threadbare layers, rucked up where he slid down the trunk. Something
                small and hard still hangs beneath them, rising and falling with his breathing.";
            "Layer upon layer of colourless cloth, worn so thin in places that the road wind goes straight through it.
            Something small and hard hangs beneath, out of sight.";
        ],
    has scenery pluralname;

Object SleepingBeggar "sleeping beggar"
    with
        name 'sleeping' 'ragged' 'beggar',
        initial
            "The beggar has slid down into the shade of the oak and gone to sleep. It is the
            hottest part of the afternoon, and he has clearly decided that the road can do
            without him for an hour. You will have to come back later.",
        description
            "He is stretched out comfortably in the shade with his hat over his eyes,
            snoring. Whatever else the day has denied him, he has the best spot on this road
            and he knows it.",
        life [;
            Ask: "He is asleep, and in no condition to answer questions about anything.";
            Order: "~Wake up,~ you say, in the voice you once used on apprentices. He snores.";
            Answer: "You say good day to a sleeping man, with the result you would expect.";
            Give:
                if(noun == SilverCoin)
                    "You press the coin into his open palm. He sleeps on, entirely unaware of it, and
                    after a moment you take it back. Silver left in a sleeping man's hand on an open
                    road will not be there when he wakes.";
                "The man is asleep.";
            Show:
                if(noun == SilverCoin)
                    "You hold the silver where he would see it if his eyes were open. They are not.";
        ],
        before [;
            Attack:
                "Striking a starving man was unworthy of you when he was awake. Asleep, it does
                not bear thinking about.";
            Search:
                "He is asleep and helpless, and you are not going through a sleeping man's
                clothes on a public road.";
            Push, PushDir, Transfer:
                "There is no reason to move him. He is not in your way, and he is exactly where he wants to be.";
            Shake:
                "Rousing a sleeping man out of the shade at midday, so that you can give him
                money, would be a strange sort of kindness. Let him sleep and come back later.";
            WakeOther:
                "You shake his shoulder. He grunts, rolls further into the shade and settles down
                again. He will get up when the heat goes out of the day and not a moment sooner.";
        ],
        react_before [;
            Wait:
                "Time passes.^^The beggar sleeps on, and the shadow of the oak creeps a little further across the road.";
            Smell:
                "Dust, old sweat and unwashed wool, warmed by the sun.";
            Listen:
                "He snores with the steady, unhurried conviction of a man who has had a good deal
                of practice at sleeping outdoors.";
        ],
        domagic [spell;
            if(spell == HealSpell)
                "There is nothing wrong with the man that a spell can mend. He is asleep, not ill.";
        ],
        add_to_scope BeggarHands BeggarRags Amulet,
    has animate;

Object Corn "corn"
    with
        name 'corn',
        description
            "Tall stalks of corn sway gently in the breeze, forming a rustling wall on either side of the road.",
        found_in VillageRoad EndOfVillage,
        before [;
        Take:
            "It is not your corn to take, and there are hungrier people than you on this road.";
        ]
    has scenery;

Room Village "The Village"
    with
        description
            "The village consists of a dozen timber-framed houses lining either side of the road. Despite its modest size,
            the area is full of life and bustle. It is market day.",
        cheap_scenery
            'stall' 'stalls'
                "Trestles heaped with cabbages, salt fish, rough cloth and cheap tin charms.
                Business is brisk, and nobody is paying you the slightest attention."
            CS_NO_ADJ 'village'
                "A charming, bustling settlement filled with timber-framed cottages, colourful banners, and the lively chatter
                of market day."
            CS_NO_ADJ 'road'
                "The dusty road runs right through the centre of the village, lined with bustling market stalls and curious locals."
            'banner' 'banners'
                "Strips of dyed cloth strung between the eaves, faded by a good many summers of
                market days and snapping cheerfully in the breeze."
            'house' 'houses'
                "Simple cottages with thatched roofs and whitewashed walls. Banners and market stalls line the space between them.",
        before [;
        Wait:
            if(Busker in self) "You wait, observing the hawker.";
            rfalse;
        Listen:
            "The road is alive with a cheerful din: traders bawling their wares, villagers
            haggling boisterously over prices, livestock lowing somewhere behind the houses,
            and the dry scrape of wooden cups sliding across the hawker's bench.";
        Smell:
            "A rich tapestry of market smells fills the air: fresh-baked bread, roasted meats, and sweet berries from
            the stalls, mingled with the earthy scents of livestock, timber, and chimney smoke.";
        ],
        u_to "Nothing above you but thatch, chimney smoke and a hard blue sky.",
        n_to "The village road runs east and west, and the houses stand shoulder to shoulder in between.",
        w_to VillageRoad,
        e_to EndOfVillage,
        cant_go "The road leads east and west.";

Object -> Bench "bench"
    with
        name 'bench',
        description
            "A sturdy trestle of planed pine, scarred by long use and set at just the height
            to keep the cups level with a bystander's eye.",
        before [;
        LookUnder:
            "Trodden dust, a few cabbage leaves and the hawker's own boots. Whatever he does
            with his hands, he does it well above the level of the bench.";
        Receive: "The hawker needs the bench for his game.";
        ],
        domagic [spell;
            if(spell==AnimateSpell) {
                if(busker.number==7 or 8 or 9 or 10 or 11) {
                    move SilverCoin to player;
                    give RedStone ~general; ! no more hawker puzzles
                    move RedStone to player;
                    give RedStone ~scenery;
                    remove SleepingBeggar;
                    move Beggar to VillageRoad;
                    remove Busker;
                    remove self;
                    "The bench comes to life, bucks violently for a moment and then stiffens again.
                    The cups roll off onto the ground, and there is no sign of the stone under any
                    of them. The hawker bends quickly to gather them up, and as he does so the stone
                    drops out of his sleeve and into the dust. The man goes scarlet. ~Please, sir,
                    do not be angry. I have seven children at home to feed, and I never cheat
                    against the poor. You can have your stake back, and this fine gem with it, if
                    you will promise not to mention this to the watch.~ He presses the silver coin
                    and the stone into your hand, gathers up his things and is gone down the road
                    before you can think of a reply.";
                } else {
                    if(Busker.number<6) {
                        Busker.number=1;
                    } else if(Busker.number==6) {
                        Busker.number=6;
                    } else {
                        Busker.number=7;
                    }
                    "The bench comes to life, jerks about violently for a while and then stiffens
                    again. The cups fall to the ground. The hawker bends down and picks up the cups
                    again. ~Do not do that again,~ he says.";
                }
            }
        ],
    has concealed static supporter;

Class BuskerCup
    with
        name 'cup',
        description
            "A plain beechwood cup, upturned and giving nothing away. Staring at it will not
            make it transparent.",
        before [x;
            Search, LookUnder:
                "The hawker's palm settles flat on top of it. ~Now, now, master. You point and I
                lift. That is the whole of the game.~";
            Take, Remove, Transfer, PointAt:
                if(Busker.number==4 or 5) {
                    Busker.number=6;
                    if(self==Cup1) {
                        print
                            "The hawker lifts the cup, and sure enough, the stone is there. ~Beginner's
                            luck,~ he mutters. ~Since that one was free, you win nothing. But win the next
                            one and you take twenty silver coins off me.~ He picks up the stone and sets the
                            cups back in a neat row.";
                    } else {
                        print
                            "The hawker lifts the cup, but there is no stone under it. ~Bad luck,
                            but it will surely go better next time,~ he says encouragingly. He lifts the
                            left cup and produces the stone, then sets the cups back in a neat row.";
                    }
                    "^^You recognize the stone! Apart from its red colour, it is identical to your
                    mentor's black stone.";
                }
                if(Busker.number==10 or 11) {
                    Busker.number=6;
                    if(self == Cup1) x = Cup2;
                    if(self == Cup2) x = Cup3;
                    if(self == Cup3) x = Cup1;
                    "The hawker lifts the cup, but there is no stone under it. ~Bad luck,
                    but it will surely go better next time!~ he says encouragingly. He lifts ",
                    (the) x, " and produces the stone, then sets the cups back in a neat row.";
                }
                "The hawker's hand arrives on the bench a moment before yours does. ~The cups
                stay with me, master. You are welcome to point at them all day.~";
        ],
        domagic [spell;
            if(spell==AnimateSpell) {
                if(busker.number==7 or 8 or 9 or 10 or 11) {
                    move SilverCoin to player;
                    move RedStone to player;
                    give RedStone ~scenery;
                    remove Busker;
                    remove Bench;
                    "The cup comes to life, jerks about violently for a while and knocks the other
                    cups to the ground before it too stiffens and falls. There is no sign of the
                    stone. The hawker quickly bends to pick up the cups, and from his sleeve the
                    stone falls out. The man blushes and says, ~Please, sir, do not be angry. I
                    have seven children at home to feed, and I do not cheat when I play against the
                    poor. You can have your stake back, and this fine gem, if you promise not to
                    mention this to the watch.~ He presses the silver coin and the stone into your
                    hand, then gathers his things and runs off before you can react.";
                } else {
                    Busker.number=1;
                    "The cup comes to life, jerks about violently for a while and knocks the other
                    cups to the ground before it too stiffens and falls. The hawker bends down and
                    picks up the cups again. ~Do not do that again,~ he says.";
                }
            } else return AllTheCups.domagic(spell);
        ],
    ;

BuskerCup -> -> Cup1 "left cup"
    with name 'left', ;
BuskerCup -> -> Cup2 "middle cup"
    with name 'middle' 'centre' 'center', ;
BuskerCup -> -> Cup3 "right cup"
    with name 'right', ;

Object -> -> AllTheCups "cups"
    with
        name 'cups',
        before [;
        Examine:
            "Three identical cups of turned beechwood, upturned in a neat row, their rims
            worn smooth by years of exactly this. Not one of them gives anything away.";
        default: "You have to say if you mean the left, middle or right cup.";
        ],
        domagic [spell;
            if(spell == FreezeSpell)
                "Frost blooms across all three cups and they seize fast to the bench. The hawker
                prises them up one at a time, blowing on his fingers and grinning at the crowd.
                ~A cold trick, master. But there is still nothing under them.~";
            if(spell == AnimateSpell)
                "The three cups come to life and scatter across the bench like startled hens. The
                crowd roars. The hawker traps them one by one under his broad hands and sets
                them back in a row, delighted with the free entertainment, and the stone stays
                exactly where it has been all along.";
        ],
    has scenery pluralname;
Object -> Crowd "crowd"
    with
        name 'crowd' 'people' 'farmhands' 'traders' 'children',
        description
            "Farmhands, traders and small children press in on every side, cheerfully waiting
            to watch a wizard lose his money like everybody else.",
        life [;
            Tell:
                "They listen with great enjoyment and believe not one word of it. As far as this
                crowd is concerned you are a bad loser in an expensive robe.";
            default:
            "The crowd ignores you.";
        ],
        before [;
        TalkTo: return self.life();
        ]
    has pluralname scenery animate;

Object -> Busker "hawker"
    with
        name 'hawker' 'man' 'busker',
        number 0,
        initial [;
            if(Village has visited) "The hawker stands by the roadside with his cups.";
            "A hawker stands behind a sturdy wooden bench by the roadside. On the surface lie three upturned cups.
            The man gestures grandly over them and shouts to the crowd,
            ~Test your skill and win ten silver coins!~";
        ],
        description
            "A sly fellow with quick eyes and even quicker hands, dressed in a colourful tunic.
            He grins at you like a cat that just found the cream.",
        react_before [;
            Go:
                if(selected_direction == w_to or e_to) {
                    if((self.number<6 && self.number>1)) {
                        print "^~But we were in the middle of a game!~ says the hawker despondently as
                                    you leave.^^";
                        self.number=1;
                    } else if(self.number<11 && self.number>7) {
                        print "^~But we were in the middle of a game!~ says the hawker despondently,
                                    and gives back the silver coin.^^";
                        self.number=6;
                        move SilverCoin to player;
                    }
                }
        ],
        before [;
        Accuse:
            "~Cheating?~ He appeals to the crowd with both arms wide, wounded to the soul.
            ~Did you hear that? A wizard cannot win at cups, so the cups must be crooked.~
            The farmhands laugh. You will need to show them something, not tell them.";
        Search:
            "~Hands off the merchandise, master.~ He steps back out of reach, smiling all the
            while, and the crowd laughs at you rather than at him.";
        GiveNoCoin:
            "You turn out your pockets and find them as empty as the beggar's palm. Whatever
            else you win from this man today, it will not be with silver.";
        ],
        each_turn [;
            switch(self.number) {
            0: self.number=1;
                "^Catching your eye, he grins wide. ~Ah, my good wizard! How about trying your luck? Stake a single
                silver coin and win ten times your wager!~";
            1: self.number=2;
                 "^~To show my goodwill, I will let you play once for free. Now watch carefully,~
                 says the hawker, taking out a little stone which he places under one of the cups
                 on the bench. He then starts to move the cups this way and that.";
            2: self.number=3;
                 "^The man speeds up, but you still keep track.";
            3: self.number=4;
                 "^The man moves the cups so fast that you almost lose track, but you think you
                 still know which cup the stone is under.";
            4: self.number=5;
                 "^~Well, where is the stone?~ asks the man when he has stopped moving the cups.
                 You are unsure, but you think it is the left cup.";
            5: "^~Point to the cup you think the stone is under,~ says the man.";
            6: print "^~Won't you try again? Just one silver coin,~ says the hawker";
                 if(SilverCoin in Busker && SilverCoin hasnt general) {
                     give SilverCoin general;
                     move SilverCoin to player;
                     print
                        ".^^Disappointed, and with very little hope, you turn out your pockets one last
                        time. Something hard shifts in the lining of your robe. You unpick the seam and
                        a second silver coin drops into your palm, forgotten there for who knows how
                        long. You will not be lucky a third time, so spend this one well";
                 }
                 ".";
            7: self.number=8;
                 "^The man starts moving the cups this way and that.";
            8: self.number=9;
                 "^The man speeds up, but you still keep track.";
            9: self.number=10;
                 "^The man moves the cups so fast that you almost lose track, but you think you
                 still know which cup the stone is under.";
            10: self.number=11;
                    "^~Well, where is the stone?~ asks the man when he has stopped moving the cups.
                    You are unsure, but you think it is the right cup.";
            11: "^~Point to the cup you think the stone is under,~ says the man.";
            };
        ],
        life [;
            Order:
                "~Give?~ The hawker laughs, thoroughly delighted. ~Master wizard, if I gave
                things away I should be the one sitting under that oak tree with my hand out.~";
            Answer:
                "~Well met, master wizard!~ He says it to the whole street rather than to you,
                and two more people drift over to watch. ~Step up, step up. The learned
                gentleman is going to show us how it is done.~";
            Ask, Tell, Show, TalkTo:
                if(second == 'game')
                    "~Simplest game in the world,~ he says happily. ~I put the stone under a cup, I
                    move the cups about, you tell me where the stone has got to. A child could do
                    it.~ He does not mention that no child ever has.";
                if(second == 'coin' or 'coins')
                    "~Twenty of them, master, counted out into your hand the moment you win.~ He pats
                    a pouch at his belt, which does not make anything like the noise twenty silver
                    coins would make.";
                if(second == 'hawker' or 'himself')
                    "~An honest tradesman,~ he says, spreading his hands, ~in an honest trade. I go
                    where the market days are, and the market days have been good to me.~";
                if(second == 'beggar')
                    "~That old fellow under the oak?~ He shrugs, not unkindly. ~He has never staked a
                    coin with me and he never will. I have nothing against him.~";
                "The impatient hawker motions to the cups in front of him.";
            Give:
                if(self.number~=6) "~Wait until we have finished this round,~ says the hawker.";
                if(noun==SilverCoin) {
                    self.number=7;
                    move SilverCoin to Busker;
                    "The hawker pockets the silver coin. He places the stone under one of the cups
                    and says, ~Let us begin again. Concentrate, and the twenty silver coins are
                    yours.~";
                }
        ],
        domagic [spell;
            if(spell == FreezeSpell)
                "The spell finds nothing in him to take hold of. He shivers violently, pulls his
                tunic straight and carries on shuffling. ~Draughty spot, this,~ he says.";
        ],
        add_to_scope HawkerTunic HawkerSleeve,
    has animate;

Object HawkerTunic "tunic"
    with
        name 'tunic',
        description
            "Loud stripes in three colours, cut generously, with sleeves wide enough to be
            fashionable. It is the only garment on this road that was chosen to be looked at.",
    has scenery;

Object HawkerSleeve "sleeve"
    with
        name 'sleeve' 'sleeves',
        description [;
            if(RedStone has general)
                "The glow moves with his arm, a dull ember travelling up and down inside the
                cloth. The stone has not been on this bench since he picked it up.";
            "Wide, deep, and gathered at the cuff. There is a great deal of room in a sleeve
            like that, and the hawker keeps turning that side of himself away from you.";
        ],
    has scenery;

Room EndOfVillage "The Edge of the Village"
    with
        description [;
            if(self hasnt visited) {
                remove Beggar;
                move SleepingBeggar to VillageRoad;
            }
            "Just a few steps east of the village centre, the houses give way to cornfields
            again. The road runs on east into open country, and back west into the market.";
        ],
        cheap_scenery
            CS_PARSE_NAME ParseNameCornFields
                "Tall stalks of corn sway gently in the breeze, forming a rustling wall on either side of the road."
            'village' 'houses'
                "Rooftops and market banners show above the corn a little way west, and the noise
                of the crowd carries faintly on the wind.",
        before [;
        Listen:
            "The lively chatter and haggling of the market grow fainter here, giving way to the soft rustle
            of cornstalks in the wind and the dry scuttle of insects in the roadside dust.";
        Smell:
            "The sweet, savoury scents of the market stalls fade into the clean smells of
            open fields, sun-baked earth, and fresh straw.";
        ],
        w_to Village,
        s_to "The corn stands too thick to push through, and there is nothing beyond it but more corn.",
        u_to "Nothing above but a wide, empty sky and a hawk turning slow circles over the fields.",
        d_to "Only the dusty dirt road beneath your boots, rutted hard by cartwheels.",
        e_to
            "The road runs on east through the corn and out into open country,
            and everything you have come here for lies behind you.",
        cant_go "The dense cornfields form an unbroken wall of rustling stalks on either side of the road.";

Object -> RoadDust "dust"
    with
        name 'road' 'dust',
        description  [;
            print "Thick, bone-dry earth ground to a fine powder by years of passing boots and wagon wheels";
            if(SilverCoin hasnt moved)
                print ". Glinting among the grit is the unmistakable sheen of a silver coin";
            ".";
        ],
        before [;
        Search:
            "You scuff through the roadside dust with your boot and turn up a bent nail, a
            button, and a great deal more dust. Your luck has evidently been spent for one day.";
        ],
    has scenery;

Object -> SilverCoin "silver coin"
    with
        name 'small' 'silver' 'coin' ,
        initial "It seems to be your lucky day. A silver coin lies in the dust at your feet.",
        description
            "It is not worth very much, but it would buy you a few beers at the village
            tavern, or one turn at a certain gentleman's cups.",
    ;

Room GateRoom "The Crypt"
    with
        number 0,
        description [;
            if(self hasnt visited) @sound_effect 4 2 255 0;
#Iftrue (#version_number == 6);
            ShowPicture(PIC_DEMON);
#Endif;
            "This room is like a heathen temple. Obsidian pillars rise into the darkness,
            carved with blasphemous runes that seem to shift when you aren't looking directly
            at them. A great stone altar stands in the centre of the chamber, stained dark from
            unholy rituals, and four glowing pedestals surround it. There are no exits.";
	],
        cheap_scenery
        CS_NO_ADJ 'altar'
            "A massive block of dark, unpolished granite, carved with jagged channels that drain toward a central vortex."
        'pedestal' 'pedestals'
            "Four squat plinths of the same black stone stand at the compass points around the altar.
            Each is cut with a shallow depression, and each depression is exactly the size of a man's fist."
        'pillar' 'pillars'
            "Monolithic shafts of black stone that support the vaulted ceiling far above. They are etched with writhing, glowing runes.",
        each_turn [;
            if(EvilMaster in self) rtrue;
            ++self.number;
            switch(self.number) {
            1:
                move DeadMaster to self;
                "^Where the demon stood, your mentor stands in its place, blinking, himself again for
                the space of a single breath. Then his knees give way and he falls dead to the floor.^^\
                The room changes. All your senses are distorted and strange visions come and go.
                It is as if the place is vanishing before your eyes.";
            4:
                print
                    "^The last of the visions gives way to a scene that stays where it is put. You are
                    standing in a meadow in a green deciduous wood, with your mentor asleep in the
                    grass beside you. The sun is warm, and it is a perfect day for going fishing.^";
                if(TestScope(ResurrectedMaster)) Epilogue(3); else Epilogue(2);
            default:
                "^The room is changing and vanishing.";
            };
        ],
        react_before [;
        Go: if(RedField in location) "First, you'd have to leave the red force field.";
        ],
        before [;
        Wait:
            if(self.number == 2)
                "You wait, and the crypt goes on coming apart around you.";
            if(self.number == 3)
                "You kneel beside your mentor and wait, and the walls thin away to nothing.";
            rfalse;
        Listen:
            "An unsettling, low frequency hum vibrates in your bones rather than your ears, accompanied by the
            faintest sound of whispers echoing from the darkness above, though you can never quite make out the words.";
        Smell:
            "The air is stagnant and ice-cold, suffocatingly heavy with the iron stench of dried blood, ancient ozone,
            and the faint, coppery tang of unholy power humming from the pedestals.";
        ],
        cant_go "THere are no exits.";

Object -> EvilMaster "demon"
    with
        name 'mentor' 'teacher' 'evil' 'istar' 'demon',
        number 0, ! turns of the endgame
        initial [; "Your mentor stands before you."; ],
        description [;
            if(self.number>0) {
                "The demon is vaguely human, but its eyes are cold and unfathomable like a
                reptile's. Its skin is covered with brown, matted stubble that gives off a
                loathsome smell of sulfur.";
            }
            "Your mentor seems confused.";
        ],
        domagic [spell;
            if(spell==KillSpell) { score=score+10; rfalse; }
            print_ret (The) self, " stops you with a short spell, but is too busy opening the
                        gate to kill you.";
        ],
        daemon [;
            ++self.number;
            switch(self.number) {
            1:
                self.initial=0;
                print
    "^Istar's familiar, kindly features suddenly warp and contort. His skin blackens and splits,
    his eyes igniting with a hellish, crimson fire as his bones snap out of place. Before you stands
    a towering, grotesque demon, its voice echoing like grinding stones:^^
    ~At last, I have you right where I want you! Your precious mentor was a fool... far too curious for his
    own good. The moment he began dabbling in the dark arts, he practically invited me in. Snaring his
    soul was trivial. His snobbish colleagues at the Academy were sharper than you; they sensed my presence,
    forcing me to flee to this wretched wilderness. Because their inquisitors hunted me, I could not gather
    the stones myself. I needed a naive pawn to fetch the keys to open the gateway... not to white magic,
    you poor blind thing, but to unleash the Old Gods whom I serve!^^
    I searched your mentor's memories and found you. I knew you would come when he
    called, and now you have carried me the key to your own doom. Was it not a fine plan?~^^";
                move player to RedField;
                print "~Now to work. First a small precaution,~ says the demon, and you are
                            trapped in a red force field.^";
            2: print "^The demon reads a spell aloud";
                 if(Amulet in player && RedField in location) print ".^^The amulet begins to
                                                                                                                         vibrate";
                 ".";
            3: move GateOpening to location;
                 print "^Part of the floor falls away, and a dark opening, like a well, appears.
                     In the well is a slimy liquid. As he keeps reading his spell, the demon walks
                     counter-clockwise around the well";
                 if(Amulet in player && RedField in location) print ".^^The amulet vibrates
                                                                                                                         violently";
                 ".";
            4: print "^The demon drops the stones one by one into the well, and the liquid
                             sinks away";
                 if(Amulet in player && RedField in location) print ".^^The amulet begins to move
                                                                                                                         of its own accord towards the
                                                                                                                         red field";
                 ".";
            5: print "^The well now glows with a red light from below. The demon looks very
                             expectant";
                 if(Amulet in player && RedField in location) print ".^^The amulet pulls strongly
                                                                                                                         in the direction of the red
                                                                                                                         field";
                 ".";
            6: print "^The glow grows brighter and a dull rumble is heard. The demon turns to
                            you and says, ~The gate is open. A new age has begun.~^";
                Epilogue(1);
            };
        ],
        before [;
            ThrownAt:
                if(noun==Amulet && RedField in location) <<Touch RedField noun>>;
            Touch:
                if(second==Amulet && RedField in location) <<Touch RedField second>>;
        ],
    has animate;

Object -> RedField "red force field"
    with
        name 'red' 'force' 'field' 'forcefield' 'magic' 'magical',
        description
            "A shimmering sphere of translucent red energy surrounds you completely, crackling with
            raw, dark magic. Touching it causes a sharp, burning shock.",
        before [;
            ThrownAt:
                if(noun==Amulet) <<Touch second noun>>;
            Touch:
                if(second==Amulet) {
                    print "As the amulet touches the force field, it vanishes!^^";
                    RemoveObj(RedField);
                    PlayerTo(GateRoom);
                    rtrue;
                }
                rfalse;
        ],
        react_before_magic [spell obj phase;
            spell = 0; obj = 0; ! avoid compiler warnings
            if(phase == 1)
                "Your spell is not powerful enough to break through the force field.";

        ],
    has static concealed container transparent neuter;

Object GateOpening "opening in the floor"
    with
        name 'black' 'opening' 'floor' 'well' 'red' 'glow' 'slimy' 'liquid',
        description "The opening in the floor seems to be the gate to the Old Gods, which the
                                demon is in the middle of opening.",
    has static concealed;

Object DeadMaster "dead body"
    with
        name 'mentor' 'teacher' 'dead' 'body' 'corpse' 'istar',
        initial "Your mentor's dead body lies on the floor.",
        description "He is white, cold and dead as a doornail.",
        domagic [spell;
            switch(spell) {
            ResurrectSpell:
                ReplaceObj(self, ResurrectedMaster);
                score=score+10;
                "At first nothing seems to happen, but then you see a faint colour return to his
                cheeks. His breathing is barely noticeable at first, but soon grows steady again.
                He is unconscious, but alive once more!";
            HealSpell:
                "He is not sick. He is dead.";
            default: rfalse;
            };
        ],
    has proper;

Object ResurrectedMaster "mentor"
    with
        name 'mentor' 'teacher' 'istar' 'wizard' 'unconscious',
        initial "On the floor lies your mentor. He is unconscious, but breathing again.",
        description "He is unconscious, but alive. His face has regained its colour and he ooks healthy.",
        life [; "He is still unconscious."; ],
    has animate proper;

! ==========================================================================
!     Spells that start in the world
! ==========================================================================

CScroll SilverScroll "silvery scroll"
    with
        name 'silver' 'silvery' 'scroll' 'parchment',
    ;

CSpell TeleportSpell "teleportation spell" SilverScroll
    with
        name 'teleportation' 'teleport' 'spell',
        comment "move yourself to a new place",
        domagic [;
            if(location == Meadow) {
                print "A swirling yellow mist springs up from the ground, enveloping you completely. As the fog dissipates,
                    the meadow vanishes, and you find yourself standing in a vast new landscape...^^";
            } else {
                print "A yellow cloud swirls around you, and as it clears you find yourself...^^";
            }
            PlayerTo(TeleportRoom);
            if(player has general) {
                give player ~general;
                print "^To your relief you notice that the teleportation seems to have removed
                            your fish transformation.^";
            }
        ],
    ;

CSpellWithArgument AnimateSpell "animation spell"
    with
        name 'animation' 'animate' 'spell',
        comment "bring something to life",
        domagic [obj;
            if(obj provides domagic) if(obj.domagic(self)) rtrue;
            if(obj has animate) print_ret (The) obj, " is already alive.";
            print_ret (The) obj, " comes to life, runs about for a while and then stiffens
                                again.";
        ],
    ;

CSpellWithArgument FreezeSpell "freeze spell"
    with
        name 'freeze' 'spell',
        comment "freeze something",
        domagic [obj;
            if(obj provides domagic) {
                print "The spellbook opens itself to the right page, and you read aloud the complicated words of the freeze spell.^^";
                if(obj.domagic(self)) rtrue;
            }
            "A thin layer of ice covers ", (the) obj, ", but soon melts away.";
        ],
    ;

CSpellWithArgument HealSpell "healing spell"
    with
        name 'healing' 'heal' 'spell',
        comment "heal someone",
        domagic [obj;
            if(obj provides domagic) if(obj.domagic(self)) rtrue;
            if(obj hasnt animate) "You can only heal living creatures.";
            print_ret (The) obj, " looks healthier than ever.";
        ],
    ;

CSpellWithArgument KillSpell "death spell"
    with
        name 'death' 'kill' 'spell',
        comment "kill someone",
        domagic [obj;
            if(obj provides domagic) if(obj.domagic(self)) rtrue;
            if(obj hasnt animate) print_ret (The) obj, " is already dead.";
            RemoveObj(obj);
            "A red glow surrounds ", (the) obj, ". For a moment ", (the) obj,
            " seems to glow with an inner light, and you can see the bones through the
            skin. Then the body melts together and goes up in smoke.";
        ],
    ;

CSpellWithArgument ResurrectSpell "resurrection spell" BlackScroll
    with
        name 'resurrection' 'resurrect' 'spell',
        comment "raise the dead",
        domagic [obj;
            if(obj provides domagic) if(obj.domagic(self)) rtrue;
            "Nothing happens.";
        ],
    ;

! ==========================================================================
!     Ordinary objects
! ==========================================================================

Object BackPack "backpack"
    with
        article "your",
        name 'your' 'backpack' 'back' 'pack' 'rucksack' 'bag',
        description
            "It looks like an ordinary backpack, but it is a little special. No matter how
            much you stuff into it, it never grows heavier and it never seems to fill up. A
            very handy gift from your first teacher of magic, given to you long ago.",
        when_closed "Your backpack lies on the floor.",
        when_open "Your open backpack lies on the floor.",
    has container open openable;

! ---- the treasures ----
Class CStone
    with
        name 'stone' 'stones//p',
        plural "stones";

CStone BlackStone "black stone" Istar
    with
        name 'black',
        description
            "It sits in the gilded box, roughly carved and marked with signs you have never
            seen in any grimoire. It is not simply black; it is the colour of a hole in the
            world, and looking at it for long makes your eyes water.",
    ;

CStone GreenStone "green stone" Cave
    with
        name 'green',
        initial "Something glitters in the mud by the entrance. It is a green stone!",
        description
            "Roughly carved and glowing with a faint, inner emerald light, this stone matches
            the shape and ancient markings of your mentor's black stone.",
        domagic [spell;
            if(spell == IlluminateSpell && self hasnt light) {
                give self light;
                "The green stone flares so brightly that you nearly drop it, then settles to a
                steady emerald glow that throws your shadow halfway up the cave wall. It will
                serve very well as a lamp.";
            }
        ],
    ;

CStone BlueStone "blue stone" OceanFloor
    with
        name 'blue',
        description
            "Roughly carved and pulsing with a deep, inner azure glow, this stone matches the
            shape and ancient markings of your mentor's black stone.",
    ;

CStone RedStone "red stone" Village
    with
        name 'red',
        description
            "The stone is roughly carved, glowing with a faint, inner crimson warmth. Aside from its deep red colour, its strange shape and ancient markings match your mentor's black stone perfectly.",
        domagic [spell;
            if(spell == AnimateSpell && self has general)
                "The stone squirms once inside his sleeve. The hawker's grin flickers and he
                clamps his arm against his side, and the crowd, watching the cups, sees nothing
                at all. You will have to make them look somewhere else.";
            if(spell == IlluminateSpell && RedStone in Village) {
                give self general; ! we've discovered the cheat
                "Somewhere under the sliding cups a red light kindles. It does not shine out from
                beneath any of the three. It shines, faint and quite unmistakable, through the
                cloth of the hawker's right sleeve, and he has not noticed it yet.";
            }
        ],
        before [;
            Examine: print (string) self.description; @new_line; rtrue;
            Buy: if(self has scenery)
                    "~The stone isn't for sale, wizard. It's my lucky charm!~ says the hawker with a sly grin.
                    ~If you want it, you'll have to win it fair and square under the cups.~";
                rfalse;
            default:
                if(self has scenery)
                    "The hawker's hand closes over it before yours is halfway across the bench.
                    ~Under the cups or not at all, master wizard.~";
                rfalse;
        ]
    has scenery; ! general if player noticed that the hawker is cheating

Array WantedStones --> 4 1 BlackStone 0 GreenStone 0 BlueStone 0 RedStone;

Object Introduction "folio" Istar
    with
        name 'folio' 'notes' 'report',
        description [;
            "Inscribed in your mentor's familiar, frantic handwriting is a harrowing log of his forbidden studies.^^
            He writes that the present age will soon give way to an era of terror and dread,
            heralded by the return of the Old Gods to the earth. It would mean nothing less
            than the annihilation of humanity. Ever since his exile from the Academy he has
            searched, without rest, for a way to delay the waking of these malevolent
            powers.^^
            There is but one hope. By opening a gateway to a higher dimension, he can channel a torrent of pure,
            white magic powerful enough to seal the evil gods away. To tear open this gate, however, he requires ",
            (LanguageNumber) WantedStones-->0, " elemental stones. He already possesses the first, a dark, abyssal stone,
            and he needs your help to unearth the remaining three.";
        ],
    ;

! ==========================================================================
!     Menu-driven help
! ==========================================================================

[ HelpItems;
    print "There is information provided on the following:^^";
    print "     Introduction^";
    print "     How to play^";
    print "     Credits^";
    print "     Hints^";
];

[ HelpItemsAmusing;
    print "There is information provided on the following:^^";
    print "     Introduction^";
    print "     How to play^";
    print "     Credits^";
    print "     Hints^";
    print "     Amusing things*";
];

[ HelpSub;
    if(deadflag==2) DoMenu(HelpItemsAmusing, HelpMenu, HelpInfo);
    else                        DoMenu(HelpItems, HelpMenu, HelpInfo);
];

[ HelpMenu;
    switch(menu_item) {
    0: item_width=6; item_name="About this game";
         if(deadflag==2) return 5; else return 4;
    1: item_width=6; item_name="Introduction";
    2: item_width=6; item_name="How to play";
    3: item_width=4; item_name="Credits";
    4: item_width=3; item_name="Hints";
    5: item_width=7; item_name="Amusing things";
    }
];

[ HintItems;
    print "I can help you with these items:^^";
    print "     Collecting stones^";
    print "     Getting around^";
    print "     The blank scroll^";
    print "     How do I beat the hawker?^";
    print "     What do I do with the coin?^";
    print "     What do I do in the temple?^";
    print "     Where do I find the dragon?^";
    print "     How do I kill the dragon?^";
    print "     How do I break the force field?^";
    print "     I have broken the force field but am still powerless^";
    print "     I do not like the unhappy ending^";
];

[ HintMenu;
    switch(menu_item) {
    0: item_width=3;    item_name="Hints"; return 11;
    1: item_width=8;    item_name="Collecting stones";
    2: item_width=7;    item_name="Getting around";
    3: item_width=8;    item_name="The blank scroll";
    4: item_width=12; item_name="How do I beat the hawker?";
    5: item_width=13; item_name="What do I do with the coin?";
    6: item_width=12; item_name="What do I do in the temple?";
    7: item_width=12; item_name="Where do I find the dragon?";
    8: item_width=11; item_name="How do I kill the dragon?";
    9: item_width=14; item_name="How do I break the force field?";
    10: item_width=25; item_name="I have broken the force field but am still powerless";
    11: item_width=15; item_name="I do not like the unhappy ending";
    }
];

[ HintInfo;
    switch(menu_item) {
    1: print "Your mentor needs the stones. Find them and put them in the gilded box.^";
         if(HintPause()) break;
         print "When you have found them all, he can open the gate.^";
         if(HintPause()) break;
         print "Save the game before you put down the last stone. Something unexpected will
                happen.^";
         LastHintPause();
    2: print "Your mentor asks you to travel far to find the stones, and gives you a little
              help along the way.^";
         if(HintPause()) break;
         print "Surely he gave you a scroll when you left him?^";
         if(HintPause()) break;
         print "Copy the teleportation spell into your spellbook, and use it when you want to
                travel far away.^";
         if(HintPause()) break;
         print "Type ~teleport~ and see what happens.^";
         LastHintPause();
    3: print "Your mentor has great experience with magic.^";
         if(HintPause()) break;
         print "Show him the blank scroll.^";
         LastHintPause();
    4: print "He is nimble-fingered, and faster than you.^";
         if(HintPause()) break;
         print "You must cheat.^";
         if(HintPause()) break;
         print "Use your knowledge of magic.^";
         if(HintPause()) break;
         print "What if the cups could talk.^";
         if(HintPause()) break;
         print "Or at least move.^";
         if(HintPause()) break;
         print "Cast the animation spell on the bench or one of the cups.^";
         LastHintPause();
    5: print "If you want to play with the hawker you need the coin.^";
         if(HintPause()) break;
         print "You only have one coin, so you will never see it again if you lose. Do not
                lose!^";
         if(HintPause()) break;
         print "But what use do you have for money? Share it with those less fortunate.^";
         LastHintPause();
    6: print "Pray.^";
         if(HintPause()) break;
         print "Itching? Perhaps a swim will help?^";
         if(HintPause()) break;
         print "No? Perhaps it is time for another prayer?^";
         LastHintPause();
    7: print "Dragons prefer to live in mountain caves.^";
         if(HintPause()) break;
         print "Have you seen any mountains?^";
         if(HintPause()) break;
         print "Go through the north door after teleporting.^";
         if(HintPause()) break;
         print "There is a cave in the mountain.^";
         if(HintPause()) break;
         print "There is a tunnel in the cave.^";
         if(HintPause()) break;
         print "You have a spell for making things glow.^";
         if(HintPause()) break;
         print "Illuminate the backpack.^";
         LastHintPause();
    8: print "Perhaps someone can help you?^";
         if(HintPause()) break;
         print "Is the blank scroll still blank?^";
         if(HintPause()) break;
         print "The ground slopes steeply downward, does it not?^";
         if(HintPause()) break;
         print "Perhaps it is not slippery enough?^";
         if(HintPause()) break;
         print "Killing dragons unaided seems reckless.^";
         if(HintPause()) break;
         print "Have you asked your mentor about dragons?^";
         if(HintPause()) break;
         print "Animate the statues and freeze the slope. Let the statues wound the dragon,
                        and heal it afterwards. Ask the dragon about magic.^";
         LastHintPause();
    9: print "Do you have any item that can be used against black magic?^";
         if(HintPause()) break;
         print "If not, you have not used the coin wisely.^";
         if(HintPause()) break;
         print "Touch the force field with the amulet.^";
         LastHintPause();
 10: print "Your magic is too weak.^";
         if(HintPause()) break;
         print "You need something stronger.^";
         if(HintPause()) break;
         print "Namely dragon magic.^";
         if(HintPause()) break;
         print "Help the dragon and you will get a powerful spell.^";
         if(HintPause()) break;
         print "Cast the death spell at the demon.^";
         LastHintPause();
 11: print "Your mentor dies. You cannot prevent it...^";
         if(HintPause()) break;
         print "but you can raise him from the dead.^";
         if(HintPause()) break;
         print "You need a spell found in a cave.^";
         LastHintPause();
    }
    return 2;
];

[ HelpInfo;
    switch(menu_item) {
    1: "This game is much like the adventure games Infocom wrote in the eighties. The
        player types what he or she wants to do, and the game tells what happens.^^\
        You cannot finish the game without using magic. You can read spells from scrolls or
        your spellbook. You can also memorize a number of spells, but since they are
        complicated you will forget them when you sleep. As long as you have your spellbook
        to hand you can read directly from it instead.";
    2: "In this game you control the main character by typing commands that tell him what
        to do. Examples of such commands are:^^\
        > look (look around you)^\
        > north (go north from where you are)^\
        > inventory (show a list of what you are carrying)^\
        > take the map^\
        > examine it (~it~ here refers to the map)^\
        > give the map to the woman^\
        > wizard, open the door (ask someone to do something)^\
        > ask the wizard about the map^\
        > throw the knife at the black bird^^\
        There are some common abbreviations:^^\
        g = again (repeat the last command)^\
        l = look^\
        i = inventory^\
        x = examine^\
        z = wait (lets the game clock tick one step)^^\
        The possible directions are all compass directions plus up and down, and can be
        abbreviated: ~n~ means north, ~u~ means up, ~sw~ means southwest, and so on.^^\
        A game can be saved with ~save~ and a saved game restored with ~restore~. You can
        start over with ~restart~ and quit with ~quit~. ~score~ shows how many points you
        have. If you make a mistake you can undo one step with ~undo~.";
    3: "This English translation was written by Johan Berntsson in 2026 as a showcase for
        Z6 support in PunyInform and Ozmoo. The original Swedish version, called Drakmagi,
        had Swedish language support written by Fredrik Ramsberg. Staffan Friberg and
        Fredrik Ramsberg helped me find bugs.";
    4: DoMenu(HintItems, HintMenu, HintInfo);
       return 2;
    5: "* Kill your mentor with a spell?^";
    }
];

[ LastHintPause pkey;
    print "^Last hint. Press space. ";
    @read_char 1 0 0 pkey;
];

[ HintPause pkey;
    print "^Press x to stop, or space for the next hint: ";
    @read_char 1 0 0 pkey;
    print "^^";
    if(pkey=='X' or 'x' or 27) rtrue;
    rfalse;
];

! ==========================================================================
!     Initialisation
! ==========================================================================

#Iftrue (#version_number == 6);
[ Initialise key;
    @sound_effect 3 2 255 0;
    ShowPicture(PIC_INTRO);
    @read_char key;
    @erase_window 0;
#IfNot;
[ Initialise ;
    @sound_effect 3 2 255 0;
#Endif;


    print 
        "The letter from your old mentor arrived entirely out of the blue. You still vividly remember the day
        the Arch-Mages at the Academy accused him of dabbling in the dark arts. Shortly after, he vanished without
        a trace, and his name was reduced to a forbidden whisper.^^
        Yet without his patient guidance you would never have survived your
        apprenticeship, and now he desperately needs your help. Throwing caution to the
        wind, you followed the cryptic instructions in his letter, and after weeks of
        gruelling travel you now stand before your mentor's secluded, humble dwelling.^";

    banner();
    @new_line;

#Iftrue (#version_number == 6);
    print "^Press any key to start the game^";
    @read_char key;
    @erase_window 0;
#Endif;

    score=0;
    lookmode=2;                        ! always show long room descriptions (verbose)

    location=Meadow;
    move SpellBook to player;
    move BackPack    to player;

    move DirtyScroll to Meadow;
    move FreezeSpell to SpellBook;
    move HealSpell     to SpellBook;

    StartDaemon(Dragon);
    return 2; ! don't print banner
];

Object EpilogueRoom "Epilogue";

[ Epilogue status pkey;
    print "^Press space to continue.";
    @read_char 1 0 0 pkey;
    ClearScreen();
    print "^^^";
    location=EpilogueRoom;
    switch(status) {
    1:
        print "A new age of terror and dread begins. The Old Gods rule the earth once
                     more, and the first to be torn to pieces is you.^";
        deadflag=1;
    2:
        print "The earth is saved, but the memory of your mentor's death pains you.^";
        deadflag=2;
    3:
        print "The earth is saved, and your mentor's soul is restored. All's well that
                     ends well.^";
        deadflag=2;
    }
];

