Constant PIC_INTRO      = 1;
Constant PIC_DEMON      = 2;
Constant PIC_DRAGON     = 3;
Constant PIC_MEADOW     = 4;
Constant PIC_TELEPORT   = 5;
Constant PIC_TEMPLE     = 6;
Constant PIC_WAVE       = 7;
Constant PIC_WOOD       = 8;
Constant PIC_VILLAGE    = 9;
Constant PIC_HUT        = 10;
